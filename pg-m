                    echo -e "  ${GREEN}Updated. Also fix SQLALCHEMY_DATABASE_URL in .env${NC}"
                else
                    echo -e "  ${RED}Failed${NC}"
                fi
                pause
                ;;
            0) break ;;
            *) ;;
        esac
    done
}

menu_node() {
    while true; do
        print_header
        echo -e "  ${BOLD}7. Node Management${NC}"
        print_line
        echo "  1. Install node"
        echo "  2. Install node (custom name)"
        echo "  3. Show API Key"
        echo "  4. Show Certificate"
        echo "  5. Show node .env"
        echo "  6. Edit node .env"
        echo "  7. Node help/status"
        echo "  0. Back"
        print_line
        read -rp "  Choose option [0-7]: " o
        case $o in
            1) bash -c "$(curl -sL https://github.com/PasarGuard/scripts/raw/main/pg-node.sh)" @ install; pause ;;
            2)
                read -rp "  Name: " n
                [[ -n "$n" ]] && bash -c "$(curl -sL https://github.com/PasarGuard/scripts/raw/main/pg-node.sh)" @ install --name "$n"
                pause
                ;;
            3)
                for f in /opt/pg-node/.env /var/lib/pg-node/.env /opt/pg-node*/.env; do
                    [[ -f "$f" ]] && { echo -e "  ${GREEN}$f${NC}"; grep -i API_KEY "$f" || true; }
                done
                pause
                ;;
            4)
                for f in /var/lib/pg-node/certs/ssl_cert.pem /opt/pg-node/certs/ssl_cert.pem; do
                    if [[ -f "$f" ]]; then
                        echo -e "  ${GREEN}$f${NC}"
                        cat "$f"
                    fi
                done
                find /var/lib /opt -name ssl_cert.pem 2>/dev/null | head -5
                pause
                ;;
            5)
                for f in /opt/pg-node/.env /var/lib/pg-node/.env; do
                    [[ -f "$f" ]] && { echo "=== $f ==="; cat "$f"; }
                done
                pause
                ;;
            6)
                if [[ -f /opt/pg-node/.env ]]; then nano /opt/pg-node/.env
                elif [[ -f /var/lib/pg-node/.env ]]; then nano /var/lib/pg-node/.env
                else read -rp "  Path: " p; [[ -f "$p" ]] && nano "$p"; fi
                ;;
            7)
                command -v pg-node &>/dev/null && { pg-node --help 2>/dev/null; pg-node status 2>/dev/null; } || echo "  pg-node not found"
                pause
                ;;
            0) break ;;
            *) ;;
        esac
    done
}

menu_firewall() {
    while true; do
        print_header
        echo -e "  ${BOLD}8. Firewall & Security${NC}"
        print_line
        echo "  1. Install + enable UFW"
        echo "  2. Allow SSH (22)"
        echo "  3. Allow panel port"
        echo "  4. Allow 80 and 443"
        echo "  5. Allow custom port"
        echo "  6. UFW status"
        echo "  7. Enable BBR"
        echo "  8. Install Fail2Ban"
        echo "  0. Back"
        print_line
        read -rp "  Choose option [0-8]: " o
        case $o in
            1)
                apt install -y ufw >/dev/null 2>&1
                ufw default deny incoming; ufw default allow outgoing
                ufw allow 22/tcp; ufw --force enable
                echo -e "  ${GREEN}UFW on${NC}"; pause
                ;;
            2) ufw allow 22/tcp; echo "  OK"; pause ;;
            3) p=$(get_port); ufw allow "${p}/tcp"; echo "  ${p} OK"; pause ;;
            4) ufw allow 80/tcp; ufw allow 443/tcp; echo "  OK"; pause ;;
            5) read -rp "  Port: " p; [[ "$p" =~ ^[0-9]+$ ]] && ufw allow "${p}/tcp"; pause ;;
            6) ufw status verbose; pause ;;
            7)
                if ! grep -q bbr /etc/sysctl.conf 2>/dev/null; then
                    echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
                    echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
                    sysctl -p
                fi
                sysctl net.ipv4.tcp_congestion_control; pause
                ;;
            8)
                apt install -y fail2ban >/dev/null 2>&1
                systemctl enable --now fail2ban
                echo -e "  ${GREEN}Fail2Ban on${NC}"; pause
                ;;
            0) break ;;
            *) ;;
        esac
    done
}

