ufw_delete_port_rules(){
  local p="$1" n i=0
  while (( i < 60 )); do
    n=$(ufw status numbered 2>/dev/null | grep -E "[[:space:]]${p}(/tcp)?[[:space:]]" | head -1 | sed -E 's/^\[ *([0-9]+)\].*/\1/')
    [[ "$n" =~ ^[0-9]+$ ]] || break
    yes | ufw delete "$n" >/dev/null 2>&1; i=$((i+1))
  done
}

m_firewall(){
  while true; do
    header
    echo -e "  ${BOLD}8. Firewall & Security${NC}"; hr
    echo "  1. Install + enable UFW   (keeps SSH $(ssh_port), 80, 443, panel port open)"
    echo "  2. Allow SSH"
    echo "  3. Allow panel port"
    echo "  4. Allow 80 / 443"
    echo "  5. Allow custom port"
    echo "  6. UFW status"
    echo "  7. Enable BBR"
    echo "  8. Install Fail2Ban"
    echo "  9. IP Limit - allow only my IP to panel"
    echo " 10. IP Limit - add allowed IP"
    echo " 11. IP Limit - show / reset panel rules"
    echo " 12. Delete a UFW rule by number"
    echo "  0. Back"; hr
    read -rp "  Select: " o
    case $o in
      1)
        apt-get install -y -qq ufw >/dev/null 2>&1
        ufw default deny incoming >/dev/null; ufw default allow outgoing >/dev/null
        ufw allow "$(ssh_port)/tcp" >/dev/null; ufw allow 22/tcp >/dev/null
        ufw allow 80/tcp >/dev/null; ufw allow 443/tcp >/dev/null; ufw allow "$(get_port)/tcp" >/dev/null
        ufw --force enable >/dev/null; ok "UFW enabled (SSH $(ssh_port), 80, 443, $(get_port) allowed)"; pause ;;
      2) ufw allow "$(ssh_port)/tcp"; pause ;;
      3) p=$(get_port); ufw allow "${p}/tcp"; ok "$p"; pause ;;
      4) ufw allow 80/tcp; ufw allow 443/tcp; pause ;;
      5) read -rp "  Port: " p; [[ "$p" =~ ^[0-9]+$ ]] && ufw allow "${p}/tcp"; pause ;;
      6) ufw status verbose; pause ;;
      7)
        cat > /etc/sysctl.d/99-pg-m-bbr.conf <<'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF
        sysctl -p /etc/sysctl.d/99-pg-m-bbr.conf >/dev/null; sysctl net.ipv4.tcp_congestion_control; pause ;;
      8) apt-get install -y -qq fail2ban >/dev/null 2>&1; systemctl enable --now fail2ban >/dev/null 2>&1; ok "Fail2Ban on"; pause ;;
      9)
        p=$(get_port); myip=$(awk '{print $1}' <<<"${SSH_CONNECTION:-}"); [[ -z "$myip" ]] && myip=$(get_ip)
        echo -e "  Panel port: ${CYAN}${p}${NC}   Your IP: ${CYAN}${myip}${NC}"
        if confirm_yes "Lock panel port to this IP only"; then
          ufw_delete_port_rules "$p"; ufw allow from "$myip" to any port "$p" proto tcp >/dev/null; ufw reload >/dev/null
          ok "Panel port ${p} only from ${myip}"; warn "Other IPs cannot open the panel (also subscription links on this port!)"
        fi
        pause ;;
      10) p=$(get_port); read -rp "  IP to allow for port ${p}: " ip; [[ -n "$ip" ]] && { ufw allow from "$ip" to any port "$p" proto tcp >/dev/null; ufw reload >/dev/null; ok "Allowed ${ip} → ${p}"; }; pause ;;
      11)
        p=$(get_port); ufw status numbered | grep -E "${p}|Status" || ufw status
        if confirm_yes "Reset: remove IP rules and open ${p} to the world"; then ufw_delete_port_rules "$p"; ufw allow "${p}/tcp" >/dev/null; ufw reload >/dev/null; ok "Port ${p} open to all"; fi
        pause ;;
      12) ufw status numbered; read -rp "  Rule number: " rn; [[ "$rn" =~ ^[0-9]+$ ]] && yes | ufw delete "$rn"; pause ;;
      0) break ;;
    esac
  done
}

m_relay(){
  while true; do
    header
    echo -e "  ${BOLD}12. Subscription Relay / Tunnel${NC}"; hr
    echo "  Use a healthy foreign VPS as reverse-proxy for sub links"
    echo "  (user → relay VPS → this panel)"; hr
    echo "  1. Generate nginx config (for relay VPS)"
    echo "  2. Show helper commands"
    echo "  3. Apply SSL paths from existing certs (fix .env)"
    echo "  0. Back"; hr
    read -rp "  Select: " o
    case $o in
      1)
        echo
        ask "Relay domain (on healthy VPS)" RELAY_DOM "sub.example.com"
        dflt="https://$(get_domain_from_cert)"; [[ "$dflt" == "https://" ]] && dflt="https://panel.example.com"
        ask "Panel origin URL" ORIGIN "$dflt"
        ORIGIN=${ORIGIN%/}; PANEL_HOST=$(sed -E 's|https?://||; s|/.*||' <<<"$ORIGIN")
        OUT="/root/sub-relay-${RELAY_DOM}.conf"
        cat > "$OUT" <<EOF
# PasarGuard sub relay — install on HEALTHY foreign VPS
# 1) DNS: ${RELAY_DOM} → relay VPS IP
# 2) certbot certonly --nginx -d ${RELAY_DOM}
# 3) cp this file /etc/nginx/sites-available/sub-relay ; ln -sf into sites-enabled
# 4) nginx -t && systemctl reload nginx
# Sub links become: https://${RELAY_DOM}/sub/...  instead of ${ORIGIN}/sub/...

server {
    listen 443 ssl http2;
    server_name ${RELAY_DOM};

    ssl_certificate     /etc/letsencrypt/live/${RELAY_DOM}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${RELAY_DOM}/privkey.pem;

    location / {
        proxy_pass ${ORIGIN};
        proxy_ssl_server_name on;
        proxy_ssl_name ${PANEL_HOST};
        proxy_set_header Host ${PANEL_HOST};
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_connect_timeout 15s;
        proxy_read_timeout 60s;
    }
}
EOF
        ok "Config written: $OUT"; echo; cat "$OUT"; echo
        echo -e "  ${CYAN}On relay VPS:${NC} apt install -y nginx certbot python3-certbot-nginx ; then place this conf"
        pause ;;
      2)
        echo; echo "  Flow:  User → Relay VPS (healthy) → Panel VPS"
        echo "  1. DNS A record of relay domain → Relay VPS IP"
        echo "  2. nginx + certbot on Relay VPS   3. Use option 1   4. Change sub domain to relay"
        echo; echo "  Note: this only fixes the SUBSCRIPTION download URL."
        echo "  VPN traffic still goes to node/panel IPs."
        pause ;;
      3)
        FOUND_CERT=""; FOUND_KEY=""; FOUND_DOMAIN=""
        for d in "$DATA_DIR"/certs/*/; do
          [[ -f "${d}fullchain.pem" && -f "${d}privkey.pem" ]] && { FOUND_CERT="${d}fullchain.pem"; FOUND_KEY="${d}privkey.pem"; FOUND_DOMAIN=$(basename "$d"); break; }
        done
        [[ -z "$FOUND_CERT" ]] && { err "No fullchain.pem/privkey.pem under $DATA_DIR/certs"; pause; continue; }
        apply_cert_env "$FOUND_DOMAIN"
        confirm "Restart panel now?" y && { pg_restart; pg_cmd status 2>/dev/null; }
        pause ;;
      0) break ;;
    esac
  done
}

m_tools(){
  while true; do
    header
    echo -e "  ${BOLD}10. Tools & Utilities${NC}"; hr
    echo "  1. Speedtest"
    echo "  2. Disk usage"
    echo "  3. Memory & Swap"
    echo "  4. Listening ports"
    echo "  5. Restart Docker"
    echo "  6. Docker prune (unused images/cache)"
    echo "  7. Update Geo files"
    echo "  8. System info"
    echo "  9. Panel link"
    echo " 10. Who uses port 80"
    echo " 11. Create / Enable 2G Swap"
    echo " 12. Sync time (NTP)"
    echo " 13. Clean logs (journal + panel logs)"
    echo " 14. Install handy tools (curl jq sqlite3 rsync htop ncdu)"
    echo " 15. Doctor (full health check)"
    echo "  0. Back"; hr
    read -rp "  Select: " o
    case $o in
      1) has_cmd speedtest-cli || apt-get install -y -qq speedtest-cli >/dev/null 2>&1; speedtest-cli --simple 2>/dev/null || echo n/a; pause ;;
      2) df -h; pause ;;
      3) free -h; swapon --show 2>/dev/null || true; pause ;;
      4) ss -tlnp; pause ;;
      5) systemctl restart docker; ok "Docker restarted"; pause ;;
      6) docker image prune -af >/dev/null; docker builder prune -f >/dev/null 2>&1; ok "Unused images removed (running containers untouched)"; pause ;;
      7)
        mkdir -p /usr/local/share/xray
        curl -fsSL -o /usr/local/share/xray/geoip.dat https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat 2>/dev/null
        curl -fsSL -o /usr/local/share/xray/geosite.dat https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat 2>/dev/null
        ok "Geo files updated"; pause ;;
      8) echo "  Host $(hostname) | $(nproc) CPU"; grep PRETTY /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"'; free -h | grep Mem; df -h / | tail -1; pause ;;
      9) show_info; pause ;;
      10) ss -tlnp | grep ':80 ' || echo "  port 80 free"; pause ;;
      11)
        header; echo -e "  ${BOLD}Create / Enable 2G Swap${NC}"; hr
        if swapon --show 2>/dev/null | grep -q .; then ok "Swap already active:"; swapon --show; free -h | grep -i swap
        else
          if [[ -f /swapfile ]]; then chmod 600 /swapfile; mkswap /swapfile >/dev/null 2>&1; swapon /swapfile 2>/dev/null
          else fallocate -l 2G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=2048 status=progress; chmod 600 /swapfile; mkswap /swapfile >/dev/null; swapon /swapfile; fi
          grep -q '/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
          ok "Swap enabled"; free -h
        fi
        pause ;;
      12) timedatectl set-ntp true 2>/dev/null; systemctl restart systemd-timesyncd 2>/dev/null; sleep 2; timedatectl | grep -iE 'Local|synchronized'; pause ;;
      13) journalctl --vacuum-size=100M >/dev/null 2>&1; find /var/lib/docker/containers -name '*-json.log' -size +50M -exec truncate -s 0 {} \; 2>/dev/null
          find "$DATA_DIR" -name '*.log' -size +50M -exec truncate -s 0 {} \; 2>/dev/null; ok "Logs trimmed"; pause ;;
      14) apt-get update -qq; apt-get install -y -qq curl jq sqlite3 rsync htop ncdu sshpass >/dev/null 2>&1; ok "Installed"; pause ;;
      15) doctor; pause ;;
      0) break ;;
    esac
  done
}

# ═════════════════ Self update / about ═════════════════
self_update(){
  info "Checking ${SOURCE_URL}"
  local tmp nv; tmp=$(mktemp)
  curl -fsSL --max-time 30 "$SOURCE_URL" -o "$tmp" || { err "Download failed"; rm -f "$tmp"; return 1; }
  head -1 "$tmp" | grep -q '^#!' && bash -n "$tmp" 2>/dev/null || { err "Downloaded file is not a valid script — aborting"; rm -f "$tmp"; return 1; }
  nv=$(grep -m1 '^SCRIPT_VERSION=' "$tmp" | cut -d'"' -f2)
  echo "  Installed: $SCRIPT_VERSION    Latest: ${nv:-?}"
  if [[ "$nv" == "$SCRIPT_VERSION" ]]; then ok "Already up to date"; rm -f "$tmp"; return 0; fi
  confirm "Update pg-m to ${nv}?" y || { rm -f "$tmp"; return 0; }
  install -m 755 "$tmp" "$INSTALL_PATH" && ok "Updated — run pg-m again" || err "Install failed"
  rm -f "$tmp"
}

usage(){
cat <<EOF
PasarGuard Manager v${SCRIPT_VERSION}

  pg-m                         interactive menu
  pg-m status                  quick status
  pg-m doctor                  health check
  pg-m db                      database overview
  pg-m backup [full|lite]      create a backup in ${LOCAL_BACKUP_DIR}
  pg-m restore FILE            restore a pg-m backup / migration package
  pg-m --restore-archive FILE  non-interactive restore (used by migration)
  pg-m --telegram-backup       backup + send to Telegram (cron job)
  pg-m update                  update pg-m itself
  pg-m version
EOF
}

# ═════════════════ Main menu ═════════════════
DASH=""
dash_stats(){
  DASH=""
  [[ -f "$COMPOSE_FILE" ]] || return
  db_detect
  local img tot act nodes
  img=$(panel_image | awk -F: '{print $NF}')
  DASH="  Image: ${img:-?}  |  DB: $(db_label)"
  if [[ "$DB_KIND" == sqlite || ( -n "$DB_CID" ) ]] && db_ready 2>/dev/null; then
    tot=$(db_count users 2>/dev/null); act=$(db_sql "SELECT COUNT(*) FROM users WHERE status='active';" 2>/dev/null | head -1)
    nodes=$(db_count nodes 2>/dev/null)
    [[ -n "$tot" ]] && DASH+="\n  Users: ${tot}${act:+ (active ${act})}${nodes:+  |  Nodes: ${nodes}}"
  fi
}

main(){
  dash_stats
  while true; do
    header
    echo -e "  ${DIM}$(hostname) | $(get_ip) | load $(cut -d' ' -f1 /proc/loadavg) | RAM $(free -m | awk '/Mem:/{printf "%d%%", $3*100/$2}') | disk $(df -P / | awk 'NR==2{print $5}')${NC}"
    [[ -n "$DASH" ]] && echo -e "${DIM}${DASH}${NC}"
    [[ -n "$(conf_get MIGRATED_TO)" ]] && warn "This server was migrated to $(conf_get MIGRATED_TO)"
    hr
    echo -e "  ${BOLD} 0.${NC} Exit"
    hr
    echo -e "  ${BOLD} 1.${NC} Install / Update / Uninstall"
    echo -e "  ${BOLD} 2.${NC} Service Management          ${DIM}(Start/Stop/Restart/Logs)${NC}"
    echo -e "  ${BOLD} 3.${NC} Panel Settings              ${DIM}(Port / Admin / .env)${NC}"
    echo -e "  ${BOLD} 4.${NC} SSL Certificate Management"
    echo -e "  ${BOLD} 5.${NC} Backup & Restore            ${DIM}(Full / Telegram)${NC}"
    echo -e "  ${BOLD} 6.${NC} Migrate to New Server       ${DIM}(Full Auto Transfer)${NC}"
    hr
    echo -e "  ${BOLD} 7.${NC} Node Management"
    echo -e "  ${BOLD} 8.${NC} Firewall & Security"
    echo -e "  ${BOLD} 9.${NC} Database Management         ${DIM}(Overview / Fix / Recover)${NC}"
    hr
    echo -e "  ${BOLD}10.${NC} Tools & Utilities           ${DIM}(Swap / Cleanup / Speed)${NC}"
    echo -e "  ${BOLD}11.${NC} Quick Status / Doctor"
    echo -e "  ${BOLD}12.${NC} Subscription Relay / Tunnel"
    echo -e "  ${BOLD}13.${NC} Domains & DNS               ${DIM}(Cloudflare auto-update)${NC}"
    echo -e "  ${BOLD}14.${NC} Update pg-m / About"
    hr
    read -rp "  Select [0-14, r=refresh]: " c
    case $c in
      0) echo -e "  ${GREEN}Bye${NC}"; exit 0 ;;
      1) m_install ;;  2) m_service ;;  3) m_settings ;;  4) m_ssl ;;
      5) m_backup ;;   6) m_migrate ;;   7) m_node ;;     8) m_firewall ;;
      9) m_database ;; 10) m_tools ;;    11) quick_status ;;
      12) m_relay ;;   13) m_domains ;;
      14) header; echo "  pg-m v${SCRIPT_VERSION}"; echo "  ${SOURCE_URL}"; echo; self_update; pause ;;
      r|R) dash_stats ;;
      *) err "Invalid option"; sleep 1 ;;
    esac
    [[ "$c" =~ ^(1|5|6|9)$ ]] && dash_stats
  done
}

# ═════════════════ Entry point ═════════════════
case "${1:-menu}" in
  menu|"")            need_root; main ;;
  -v|--version|version) echo "pg-m ${SCRIPT_VERSION}" ;;
  -h|--help|help)     usage ;;
  status)             need_root; AUTO=1; quick_status ;;
  doctor)             need_root; AUTO=1; doctor ;;
  db)                 need_root; db_overview ;;
  backup|--backup)    need_root; AUTO=1; create_backup "${2:-full}" backup && prune_backups ;;
  restore)            need_root; [[ -n "${2:-}" ]] || { usage; exit 1; }; restore_archive "$2" ;;
  --restore-archive)  need_root; AUTO=1; restore_archive "${2:?archive path required}" ;;
  --telegram-backup)  need_root; telegram_backup_job ;;
  update|--update)    need_root; self_update ;;
  *)                  usage; exit 1 ;;
esac
