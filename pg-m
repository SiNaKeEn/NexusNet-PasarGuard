}

menu_port() {
    while true; do
        print_header
        echo -e "  ${BOLD}2. Panel Port & Links${NC}"
        print_line
        show_links
        echo "  1. Change panel port"
        echo "  2. Open firewall for panel port"
        echo "  3. Subscription port help"
        echo "  0. Back"
        print_line
        read -rp "  Choose option [0-3]: " o
        case $o in
            1)
                echo -e "  Current port: ${CYAN}$(get_port)${NC}"
                echo "  Suggested if blocked: 8443  2083  2053  2087"
                read -rp "  New port: " np
                if [[ "$np" =~ ^[0-9]+$ && "$np" -ge 1 && "$np" -le 65535 ]]; then
                    [[ -f "$ENV_FILE" ]] || { echo "  .env not found"; pause; continue; }
                    if grep -q "^UVICORN_PORT=" "$ENV_FILE"; then
                        sed -i "s/^UVICORN_PORT=.*/UVICORN_PORT=${np}/" "$ENV_FILE"
                    else
                        echo "UVICORN_PORT=${np}" >> "$ENV_FILE"
                    fi
                    ufw allow "${np}/tcp" 2>/dev/null || true
                    echo -e "  ${GREEN}Port set to ${np}. Restarting...${NC}"
                    pasarguard restart
                    show_links
                else
                    echo -e "  ${RED}Invalid port${NC}"
                fi
                pause
                ;;
            2)
                p=$(get_port)
                ufw allow 80/tcp 2>/dev/null || true
                ufw allow 443/tcp 2>/dev/null || true
                ufw allow "${p}/tcp" 2>/dev/null || true
                echo -e "  ${GREEN}Opened 80, 443, ${p}${NC}"
                pause
                ;;
            3)
                echo "  Subscription link port = panel port (or domain via Settings > Subscriptions)."
                echo "  Config/inbound ports are set in Panel > Hosts (edit each host)."
                echo "  If only VPN works, try panel port 8443 / 2083."
                pause
                ;;
            0) break ;;
            *) ;;
        esac
    done
}

menu_ssl() {
    while true; do
        print_header
        echo -e "  ${BOLD}3. SSL Certificate Management${NC}"
        print_line
        echo "  1. List certificates (status / expiry)"
        echo "  2. Get new Let's Encrypt certificate"
        echo "  3. Renew certificates (certbot renew)"
        echo "  4. Apply certificate to panel (.env)"
        echo "  5. Generate self-signed certificate"
        echo "  6. Show SSL lines in .env"
        echo "  7. Edit .env"
        echo "  8. Restart panel"
        echo "  0. Back"
        print_line
        read -rp "  Choose option [0-8]: " o
        case $o in
            1) list_certs; pause ;;
            2)
                list_certs
                read -rp "  Domain (example: panel.example.com): " domain
                [[ -z "$domain" ]] && continue
                if [[ -f "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then
                    echo -e "  ${YELLOW}Certificate already exists for ${domain}${NC}"
                    openssl x509 -enddate -noout -in "/etc/letsencrypt/live/${domain}/fullchain.pem" 2>/dev/null || true
                    read -rp "  Force new certificate anyway? (yes/no): " force
                    [[ "$force" != "yes" ]] && { echo "  Cancelled. Use option 3 to renew."; pause; continue; }
                fi
                apt update -y >/dev/null 2>&1
                apt install -y certbot >/dev/null 2>&1
                ufw allow 80/tcp 2>/dev/null || true
                echo -e "  ${YELLOW}Stopping panel for port 80 verification...${NC}"
                pasarguard down 2>/dev/null || true
                if [[ "${force:-}" == "yes" ]]; then
                    certbot certonly --standalone -d "$domain" --force-renewal --non-interactive --agree-tos --register-unsafely-without-email 2>/dev/null || \
                    certbot certonly --standalone -d "$domain" --force-renewal
                else
                    certbot certonly --standalone -d "$domain" --non-interactive --agree-tos --register-unsafely-without-email 2>/dev/null || \
                    certbot certonly --standalone -d "$domain"
                fi
                pasarguard up 2>/dev/null || true
                if [[ -f "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then
                    echo -e "  ${GREEN}OK: /etc/letsencrypt/live/${domain}/${NC}"
                    echo "  Use option 4 to apply to panel."
                else
                    echo -e "  ${RED}Failed. Check DNS A record and port 80.${NC}"
                fi
                pause
                ;;
            3)
                echo -e "  ${CYAN}Running certbot renew...${NC}"
                certbot renew
                echo
                list_certs
                pause
                ;;
            4)
                list_certs
                read -rp "  Domain to apply: " domain
                if [[ ! -f "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then
                    echo -e "  ${RED}No certificate for ${domain}${NC}"; pause; continue
                fi
                [[ -f "$ENV_FILE" ]] || { echo "  .env missing"; pause; continue; }
                sed -i '/^UVICORN_SSL_CERTFILE=/d' "$ENV_FILE"
                sed -i '/^UVICORN_SSL_KEYFILE=/d' "$ENV_FILE"
                sed -i '/^UVICORN_PORT=/d' "$ENV_FILE"
                {
                    echo "UVICORN_SSL_CERTFILE=/etc/letsencrypt/live/${domain}/fullchain.pem"
                    echo "UVICORN_SSL_KEYFILE=/etc/letsencrypt/live/${domain}/privkey.pem"
                    echo "UVICORN_PORT=443"
                } >> "$ENV_FILE"
                ufw allow 443/tcp 2>/dev/null || true
                echo -e "  ${GREEN}Applied. Port=443. Restarting...${NC}"
                pasarguard restart
                show_links
                pause
                ;;
            5)
                read -rp "  CN (IP or domain): " cn
                mkdir -p /var/lib/pasarguard/certs
                openssl req -x509 -newkey rsa:4096 \
                    -keyout /var/lib/pasarguard/certs/key.pem \
                    -out /var/lib/pasarguard/certs/cert.pem \
                    -days 36500 -nodes -subj "/CN=${cn}" 2>/dev/null
                echo -e "  ${GREEN}Created:${NC}"
                echo "  /var/lib/pasarguard/certs/cert.pem"
                echo "  /var/lib/pasarguard/certs/key.pem"
                pause
                ;;
            6)
                grep -E "SSL|UVICORN|CERT|KEY|PORT" "$ENV_FILE" 2>/dev/null || echo "  None"
                pause
                ;;
            7) pasarguard edit-env ;;
            8) pasarguard restart; pause ;;
            0) break ;;
            *) ;;
        esac
    done
}

menu_backup() {
    while true; do
        print_header
        echo -e "  ${BOLD}4. Backup & Restore${NC}"
        print_line
        echo "  1. Manual backup"
        echo "  2. Setup Telegram auto-backup"
        echo "  3. Restore"
        echo "  4. List backup files"
        echo "  5. Show paths"
        echo "  6. PostgreSQL dump"
        echo "  0. Back"
        print_line
        read -rp "  Choose option [0-6]: " o
        case $o in
            1) pasarguard backup; pause ;;
            2) pasarguard backup-service; pause ;;
            3) pasarguard restore; pause ;;
            4) ls -lh "$BACKUP_DIR" 2>/dev/null || echo "  Empty"; pause ;;
            5)
                echo "  Backup : $BACKUP_DIR"
                echo "  App    : $APP_DIR"
                echo "  Data   : $DATA_DIR"
                pause
                ;;
            6)
                OUT=~/pasarguard-db-$(date +%F-%H%M).dump
                C=$(docker ps -qf "name=postgresql" | head -1)
                if [[ -n "$C" ]]; then
                    docker exec "$C" pg_dump -U pasarguard -d pasarguard -F c -f /tmp/pg.dump 2>/dev/null && \
                    docker cp "$C":/tmp/pg.dump "$OUT" && echo -e "  ${GREEN}$OUT${NC}"
                else
                    echo -e "  ${RED}No postgresql container${NC}"
                fi
                pause
                ;;
            0) break ;;
            *) ;;
        esac
    done
}

menu_migrate() {
    print_header
    echo -e "  ${BOLD}5. Migrate to New Server${NC}"
    print_line
    read -rp "  Create migration package? (yes/no): " c
    [[ "$c" != "yes" ]] && return
    DIR=~/pasarguard-migrate-$(date +%F-%H%M)
    mkdir -p "$DIR"
    pasarguard backup 2>/dev/null || true
    cp -a "$BACKUP_DIR"/* "$DIR/" 2>/dev/null || true
    cp -a "$ENV_FILE" "$DIR/env.backup" 2>/dev/null || true
    cp -a /var/lib/pasarguard/certs "$DIR/" 2>/dev/null || true
    cp -a /etc/letsencrypt "$DIR/letsencrypt" 2>/dev/null || true
    ARC=~/pasarguard-migrate-$(date +%F-%H%M).tar.gz
    tar -czvf "$ARC" -C ~ "$(basename "$DIR")" 2>/dev/null
    echo -e "  ${GREEN}$ARC${NC}"
    echo "  On new server: install panel -> restore -> fix .env -> restart"
    pause
}

