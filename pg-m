DASH=""

# ═════════════════ v2.1 — DB readiness + import (fixes "restore finished but DB empty") ═════════════════
db_ready(){   # fast check: TCP login OK, or container healthcheck says healthy
  case "$DB_KIND" in
    postgres)
      [[ -n "$DB_CID" ]] || return 1
      docker exec -e PGPASSWORD="$DB_PASS" "$DB_CID" psql -h 127.0.0.1 -U "$DB_USER" -d postgres -Atc "SELECT 1" &>/dev/null && return 0
      [[ "$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$DB_CID" 2>/dev/null)" == healthy ]] ;;
    mysql)  db_sql "SELECT 1;" &>/dev/null ;;
    sqlite) return 0 ;;
    *) return 1 ;;
  esac
}
# strict = REAL server over TCP. The docker entrypoint runs a temporary socket-only server during first
# init; talking to it (what the old code did) made the import land in a database that was then re-created.
db_ready_strict(){
  case "$DB_KIND" in
    postgres) [[ -n "$DB_CID" ]] && docker exec -e PGPASSWORD="$DB_PASS" "$DB_CID" psql -h 127.0.0.1 -U "$DB_USER" -d postgres -Atc "SELECT 1" &>/dev/null ;;
    mysql)    [[ -n "$DB_CID" ]] && docker exec -e MYSQL_PWD="$DB_PASS" "$DB_CID" sh -c 'B=$(command -v mysql || command -v mariadb); exec "$B" -h127.0.0.1 -u"$1" -e "SELECT 1"' sh "$DB_USER" &>/dev/null ;;
    sqlite)   return 0 ;;
    *) return 1 ;;
  esac
}
wait_db(){  # wait_db [seconds]  — needs 2 consecutive strict successes
  local t="${1:-120}" i=0 n=0
  while (( i < t )); do
    db_detect
    if [[ "$DB_KIND" == sqlite ]] || { [[ -n "$DB_CID" ]] && db_ready_strict; }; then
      n=$((n+1)); (( n >= 2 )) && return 0
    else n=0; fi
    sleep 2; i=$((i+2))
  done
  db_ready && { warn "Strict TCP check timed out — continuing with fallback check"; return 0; }
  return 1
}

pg_psql(){ docker exec -e PGPASSWORD="$DB_PASS" "$DB_CID" psql -h 127.0.0.1 -U "$DB_USER" -v ON_ERROR_STOP=0 "$@"; }
pg_table_count(){ pg_psql -d "$DB_NAME" -Atc "SELECT count(*) FROM information_schema.tables WHERE table_schema='public'" 2>/dev/null | head -1; }
pg_recreate_db(){
  local i n
  for i in 1 2 3; do
    pg_psql -d postgres -c "DROP DATABASE IF EXISTS \"$DB_NAME\" WITH (FORCE);" >/dev/null 2>&1
    pg_psql -d postgres -c "CREATE DATABASE \"$DB_NAME\" OWNER \"$DB_USER\";" >/dev/null 2>&1
    if [[ "$(pg_psql -d postgres -Atc "SELECT 1 FROM pg_database WHERE datname='${DB_NAME}'" 2>/dev/null | head -1)" == 1 ]]; then
      n=$(pg_table_count)
      [[ "${n:-0}" != 0 ]] && pg_psql -d "$DB_NAME" -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public;" >/dev/null 2>&1
      return 0
    fi
    sleep 4
  done
  return 1
}
PG_ERRLOG="/var/log/pg-m-restore.err"
pg_report_errors(){
  local bad; bad=$(grep -iE 'error|fatal' "$PG_ERRLOG" 2>/dev/null | grep -viE 'already exists|must be owner of extension|errors ignored' | head -6)
  [[ -n "$bad" ]] && { warn "Messages from restore (full log: $PG_ERRLOG):"; sed 's/^/      /' <<<"$bad"; }
}
pg_import(){   # pg_import dumpfile(custom format)  — PostgreSQL / TimescaleDB
  local f="$1" c="$DB_CID" has_ts=0 attempt cnt
  : > "$PG_ERRLOG"
  docker cp "$f" "$c":/tmp/pgm.dump >/dev/null || { err "docker cp failed"; return 1; }
  [[ -n "$(pg_psql -d postgres -Atc "SELECT 1 FROM pg_available_extensions WHERE name='timescaledb'" 2>/dev/null | head -1)" ]] && has_ts=1
  for attempt in 1 2 3; do
    info "Importing database (attempt ${attempt}/3)..."
    if ! pg_recreate_db; then warn "Could not (re)create database '$DB_NAME'"; sleep 5; continue; fi
    if [[ $has_ts -eq 1 ]]; then
      pg_psql -d "$DB_NAME" -c "CREATE EXTENSION IF NOT EXISTS timescaledb;" >>"$PG_ERRLOG" 2>&1
      pg_psql -d "$DB_NAME" -c "SELECT timescaledb_pre_restore();" >>"$PG_ERRLOG" 2>&1
    fi
    docker exec -e PGPASSWORD="$DB_PASS" "$c" pg_restore -h 127.0.0.1 -U "$DB_USER" -d "$DB_NAME" --no-owner --no-privileges /tmp/pgm.dump >>"$PG_ERRLOG" 2>&1
    [[ $has_ts -eq 1 ]] && pg_psql -d "$DB_NAME" -c "SELECT timescaledb_post_restore();" >>"$PG_ERRLOG" 2>&1
    cnt=$(pg_table_count)
    if [[ "${cnt:-0}" =~ ^[0-9]+$ && "${cnt:-0}" -gt 0 ]]; then
      ok "Database imported (${cnt} tables)"; docker exec "$c" rm -f /tmp/pgm.dump >/dev/null 2>&1
      pg_report_errors; return 0
    fi
    err "Import produced no tables"; grep -iE 'error|fatal' "$PG_ERRLOG" | tail -4 | sed 's/^/      /'
    sleep 5
  done
  docker exec "$c" rm -f /tmp/pgm.dump >/dev/null 2>&1
  err "Database import failed — details: $PG_ERRLOG"; return 1
}
pg_import_sql(){   # plain .sql file into PostgreSQL
  local f="$1" c="$DB_CID" has_ts=0 cnt
  : > "$PG_ERRLOG"
  docker cp "$f" "$c":/tmp/pgm.sql >/dev/null || return 1
  [[ -n "$(pg_psql -d postgres -Atc "SELECT 1 FROM pg_available_extensions WHERE name='timescaledb'" 2>/dev/null | head -1)" ]] && has_ts=1
  pg_recreate_db || { err "Cannot recreate database"; return 1; }
  [[ $has_ts -eq 1 ]] && { pg_psql -d "$DB_NAME" -c "CREATE EXTENSION IF NOT EXISTS timescaledb;" >>"$PG_ERRLOG" 2>&1; pg_psql -d "$DB_NAME" -c "SELECT timescaledb_pre_restore();" >>"$PG_ERRLOG" 2>&1; }
  pg_psql -d "$DB_NAME" -q -f /tmp/pgm.sql >>"$PG_ERRLOG" 2>&1
  [[ $has_ts -eq 1 ]] && pg_psql -d "$DB_NAME" -c "SELECT timescaledb_post_restore();" >>"$PG_ERRLOG" 2>&1
  docker exec "$c" rm -f /tmp/pgm.sql >/dev/null 2>&1
  cnt=$(pg_table_count); pg_report_errors
  [[ "${cnt:-0}" =~ ^[0-9]+$ && "${cnt:-0}" -gt 0 ]] && { ok "SQL imported (${cnt} tables)"; return 0; }
  err "SQL import produced no tables"; return 1
}

# ═════════════════ Editing helpers ═════════════════
ensure_editor(){ has_cmd nano || apt-get install -y -qq nano >/dev/null 2>&1; }
edit_file(){   # edit_file path
  ensure_editor
  [[ -f "$1" ]] || { err "File not found: $1"; return 1; }
  cp -a "$1" "$1.pgm-bak"; nano "$1"
}
edit_json_file(){   # edit + validate JSON, offer re-edit/revert
  edit_file "$1" || return 1
  while ! python3 -m json.tool "$1" >/dev/null 2>&1; do
    err "Invalid JSON in $1"
    echo "  1) edit again   2) revert to previous version"
    read -rp "  Select: " r
    if [[ "$r" == 2 ]]; then cp -f "$1.pgm-bak" "$1"; warn "Reverted"; return 1; fi
    nano "$1"
  done
  ok "JSON is valid"
}

# ═════════════════ Nodes (install / fresh / uninstall / edit) ═════════════════
NODE_DIR=""
node_list(){
  local f d
  for f in /opt/*/docker-compose.yml; do
    [[ -f "$f" ]] || continue; d=$(dirname "$f"); [[ "$d" == "$APP_DIR" ]] && continue
    grep -qiE 'pg-node|pasarguard/node|pasarguard-node' "$f" 2>/dev/null && echo "$d"
  done
  [[ -d /opt/pg-node && ! -f /opt/pg-node/docker-compose.yml ]] && echo /opt/pg-node
  return 0
}
node_data_dir(){ echo "/var/lib/$(basename "$1")"; }
node_env_of(){ local f; for f in "$1/.env" "$(node_data_dir "$1")/.env"; do [[ -f "$f" ]] && { echo "$f"; return; }; done; }
node_pick(){
  local nd; mapfile -t nd < <(node_list | sort -u)
  NODE_DIR=""
  if (( ${#nd[@]} == 0 )); then err "No node installed on this server"; return 1; fi
  if (( ${#nd[@]} == 1 )); then NODE_DIR="${nd[0]}"; return 0; fi
  local i=0 n; for d in "${nd[@]}"; do i=$((i+1)); echo "   $i) $d"; done
  read -rp "  Which node [1]: " n; n=${n:-1}
  [[ "$n" =~ ^[0-9]+$ && $n -ge 1 && $n -le ${#nd[@]} ]] || { err "Invalid"; return 1; }
  NODE_DIR="${nd[$((n-1))]}"
}
node_ncomp(){ docker compose --project-directory "$NODE_DIR" -f "$NODE_DIR/docker-compose.yml" "$@"; }
node_show_info(){   # node_show_info dir
  local d="$1" env port key cert
  env=$(node_env_of "$d")
  port=$(grep -E '^SERVICE_PORT=' "$env" 2>/dev/null | cut -d= -f2 | tr -d '"'); port="${port:-62050}"
  key=$(grep -E '^API_KEY=' "$env" 2>/dev/null | cut -d= -f2- | tr -d '"')
  cert=$(find "$(node_data_dir "$d")" "$d" -name ssl_cert.pem 2>/dev/null | head -1)
  echo -e "  ${BOLD}Node connection info${NC}  (${d})"; hr
  echo "  Address   : $(get_ip)"
  echo "  API port  : ${port}"
  echo "  API key   : ${key:-<not found in ${env:-.env}>}"
  if [[ -n "$cert" ]]; then echo "  Certificate (${cert}):"; echo; cat "$cert"; echo; else warn "ssl_cert.pem not found yet"; fi
  hr
  echo "  In the panel: Nodes → Add/Edit node → address, port, API key, paste certificate."
}
node_uninstall(){   # node_uninstall dir
  local d="$1" dd; dd=$(node_data_dir "$d")
  info "Stopping node containers..."
  NODE_DIR="$d" node_ncomp down >/dev/null 2>&1 || true
  rm -rf "${d:?}" "${dd:?}"
  [[ "$(basename "$d")" == pg-node ]] && rm -f /usr/local/bin/pg-node
  ok "Node removed ($d, $dd)"
}
install_fresh_node(){
  info "Installing a FRESH node (new API key + new certificate)..."
  if [[ $AUTO -eq 1 ]]; then timeout 900 bash -c "$(curl -sL "$OFFICIAL_NODE_SCRIPT")" @ install </dev/null
  else bash -c "$(curl -sL "$OFFICIAL_NODE_SCRIPT")" @ install; fi
  local rc=$?
  sleep 5
  if node_pick >/dev/null 2>&1; then node_show_info "$NODE_DIR"
    echo -e "  ${YELLOW}Remember: edit/remove the OLD node entry in the panel and use this new key + certificate.${NC}"
  else warn "Node install did not finish — run: pg-m → Node Management → 1"; fi
  return $rc
}

m_node(){
  local nenv f np pip
  while true; do
    header
    echo -e "  ${BOLD}7. Node Management${NC}"; hr
    echo "  Installed nodes: $(node_list | sort -u | paste -sd' ' - | sed 's/^$/none/')"; hr
    echo "  1. Install node (official)"
    echo "  2. Install node with custom name"
    echo "  3. Reinstall FRESH node (removes old, NEW API key + cert)"
    echo "  4. Uninstall node (containers + data)"
    echo "  5. Node control (up / down / restart / status / logs / update)"
    echo "  6. Show connection info (address, port, API key, certificate)"
    echo "  7. Edit node .env"
    echo "  8. Edit node docker-compose"
    echo "  9. Lock node API port to panel IP only"
    echo " 10. Open node API port to everyone"
    echo "  0. Back"; hr
    read -rp "  Select: " o
    case $o in
      1) bash -c "$(curl -sL "$OFFICIAL_NODE_SCRIPT")" @ install; pause ;;
      2) ask "Name" n ""; [[ -n "$n" ]] && bash -c "$(curl -sL "$OFFICIAL_NODE_SCRIPT")" @ install --name "$n"; pause ;;
      3) if node_pick; then
           confirm_yes "Remove $NODE_DIR and install a fresh node" && { node_uninstall "$NODE_DIR"; install_fresh_node; }
         else confirm "No node found — install one now?" y && install_fresh_node; fi
         pause ;;
      4) node_pick && confirm_yes "Uninstall node $NODE_DIR (data + certificates deleted)" && node_uninstall "$NODE_DIR"; pause ;;
      5) node_pick || { pause; continue; }
         echo "  up | down | restart | status | logs | update"
         read -rp "  Command: " nc
         case "$nc" in
           up) node_ncomp up -d ;; down) node_ncomp down ;; restart) node_ncomp restart ;; status) node_ncomp ps ;;
           logs) run_interruptible node_ncomp logs -f --tail 100 ;;
           update) node_ncomp pull && node_ncomp up -d ;;
           *) err "Unknown" ;;
         esac
         pause ;;
      6) node_pick && node_show_info "$NODE_DIR"; pause ;;
      7) if node_pick; then nenv=$(node_env_of "$NODE_DIR"); [[ -n "$nenv" ]] && { edit_file "$nenv"; confirm "Restart node to apply?" y && node_ncomp restart; } || err ".env not found"; else pause; fi ;;
      8) if node_pick; then edit_file "$NODE_DIR/docker-compose.yml"; confirm "Apply (up -d)?" y && node_ncomp up -d; else pause; fi ;;
      9) node_pick || { pause; continue; }
         nenv=$(node_env_of "$NODE_DIR"); np=$(grep -E '^SERVICE_PORT=' "$nenv" 2>/dev/null | cut -d= -f2 | tr -d '"'); np="${np:-62050}"
         ask "Node API port" np "$np"; ask "Panel server IP" pip ""
         if [[ -n "$pip" ]]; then ufw_delete_port_rules "$np"; ufw allow from "$pip" to any port "$np" proto tcp >/dev/null && ufw reload >/dev/null; ok "Port $np reachable only from $pip"; fi
         pause ;;
      10) node_pick || { pause; continue; }
         nenv=$(node_env_of "$NODE_DIR"); np=$(grep -E '^SERVICE_PORT=' "$nenv" 2>/dev/null | cut -d= -f2 | tr -d '"'); ask "Node API port" np "${np:-62050}"
         ufw allow "${np}/tcp" >/dev/null; ok "Opened $np"; pause ;;
      0) break ;;
    esac
  done
}

# ═════════════════ Restore engine (smart: finds ANY backup, any format) ═════════════════
RESTORE_TMP=""; RESTORE_ROOT=""; FRESH_NODE=0
mf(){ grep -E "^$1=" "$RESTORE_ROOT/manifest.env" 2>/dev/null | head -1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//'; }

extract_any(){   # extract_any file destdir
  local f="$1" d="$2"
  case "$f" in
    *.zip) if has_cmd unzip; then unzip -q -o "$f" -d "$d"
           else python3 -c "import zipfile,sys;zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])" "$f" "$d"; fi ;;
    *.tar.gz|*.tgz) tar -xzf "$f" -C "$d" ;;
    *.tar)          tar -xf "$f" -C "$d" ;;
    *.gz)           gunzip -c "$f" > "$d/$(basename "${f%.gz}")" ;;
    *) return 1 ;;
  esac
}
file_kind(){
  case "$1" in
    *.tar.gz|*.tgz) [[ $(tar -tzf "$1" 2>/dev/null | grep -c 'manifest.env') -gt 0 ]] && echo pgm || echo archive ;;
    *.zip) echo archive ;;
    *.sql|*.sql.gz) echo sql ;;
    *.dump|*.pgc) echo pgdump ;;
    *.sqlite3|*.db) echo sqlite ;;
    *) echo other ;;
  esac
}
kind_label(){ case "$1" in pgm) echo "pg-m package";; archive) echo "archive (official/other)";; sql) echo "SQL dump";; pgdump) echo "PostgreSQL dump";; sqlite) echo "SQLite DB";; *) echo "file";; esac; }

RESTORE_LIST=()
scan_restore_files(){
  mapfile -t RESTORE_LIST < <(find "$LOCAL_BACKUP_DIR" "$BACKUP_DIR" /root /root/pg-m-incoming /var/backups /home /tmp "$PWD" -maxdepth 2 -type f \
    \( -name '*.tar.gz' -o -name '*.tgz' -o -name '*.zip' -o -name '*.sql' -o -name '*.sql.gz' -o -name '*.dump' -o -name '*.pgc' -o -name '*.sqlite3' -o -name '*.db' \) \
    -size +0 -not -path '*/.*' -not -path '*/pg-m-stage*' -not -path '*/pg-m-restore*' -printf '%T@\t%p\n' 2>/dev/null \
    | sort -rn | cut -f2- | awk '!s[$0]++' | head -60)
}
pick_restore_source(){   # sets PICKED
  PICKED=""
  scan_restore_files
  echo -e "  ${BOLD}Backups found on this server${NC}"; hr
  if (( ${#RESTORE_LIST[@]} == 0 )); then echo "  (none found)"; echo "  You can still type a full path."; fi
  local i=0 f k
  for f in "${RESTORE_LIST[@]}"; do
    i=$((i+1)); k=$(file_kind "$f")
    printf "  %2d) %-48s %6s  %s  [%s]\n" "$i" "$(basename "$f")" "$(du -h "$f" | cut -f1)" "$(date -r "$f" '+%m-%d %H:%M')" "$(kind_label "$k")"
    printf "      ${DIM}%s${NC}\n" "$(dirname "$f")"
  done
  hr
  echo "  Type: a NUMBER, part of the file NAME, a full PATH,  l = latest,  0 = cancel"
  read -rp "  Select: " n
  [[ -z "$n" || "$n" == 0 ]] && return 1
  if [[ "$n" == l || "$n" == L ]]; then PICKED="${RESTORE_LIST[0]:-}"
  elif [[ "$n" =~ ^[0-9]+$ ]]; then
    (( n >= 1 && n <= ${#RESTORE_LIST[@]} )) && PICKED="${RESTORE_LIST[$((n-1))]}"
  elif [[ "$n" == */* && -f "$n" ]]; then PICKED="$n"
  else
    local m=(); for f in "${RESTORE_LIST[@]}"; do [[ "$(basename "$f")" == *"$n"* ]] && m+=("$f"); done
    if (( ${#m[@]} == 1 )); then PICKED="${m[0]}"
    elif (( ${#m[@]} > 1 )); then err "'$n' matches ${#m[@]} files — type a longer part of the name or the number"; return 1
    elif [[ -f "$n" ]]; then PICKED="$n"; fi
  fi
  [[ -n "$PICKED" && -f "$PICKED" ]] || { err "Not found"; PICKED=""; return 1; }
  ok "Selected: $PICKED"
}

restore_any(){   # restore_any file|dir — decides what to do by itself
  local f="$1" k
  [[ -e "$f" ]] || { err "Not found: $f"; return 1; }
  if [[ -d "$f" ]]; then restore_archive "$f"; return; fi
  k=$(file_kind "$f"); info "Detected: $(kind_label "$k")"
  case "$k" in
    pgm|archive) restore_archive "$f" ;;
    sql|pgdump|sqlite) restore_db_file "$f" ;;
    *) err "Unsupported file type"; return 1 ;;
  esac
}

restore_db_file(){   # restore only the database from a raw dump file
  local f="$1" work="$1" tmpd="" magic ftype=sql rc=0 target u
  [[ -f "$f" ]] || { err "File not found"; return 1; }
  ensure_docker || return 1
  if [[ "$f" == *.gz ]]; then
    tmpd=$(mktemp -d -p /var/tmp pgm-gz.XXXXXX); work="$tmpd/$(basename "${f%.gz}")"
    gunzip -c "$f" > "$work" || { err "gunzip failed"; rm -rf "$tmpd"; return 1; }
  fi
  magic=$(head -c 16 "$work" | tr -d '\0')
  [[ "$magic" == PGDMP* ]] && ftype=pgdump
  [[ "$magic" == "SQLite format 3"* ]] && ftype=sqlite
  db_detect
  info "File: $(basename "$f")  format=${ftype}   panel DB=$(db_label)"
  case "${DB_KIND}:${ftype}" in
    postgres:pgdump|postgres:sql|mysql:sql|sqlite:sqlite) ;;
    :*) err "Panel database not detected (panel not installed / .env missing)"; [[ -n "$tmpd" ]] && rm -rf "$tmpd"; return 1 ;;
    *)  err "Format mismatch: this is a ${ftype} file but the panel uses $(db_label)"; [[ -n "$tmpd" ]] && rm -rf "$tmpd"; return 1 ;;
  esac
  warn "The CURRENT database will be replaced."
  confirm_yes "Continue" || { echo "  Cancelled"; [[ -n "$tmpd" ]] && rm -rf "$tmpd"; return 1; }
  if [[ "$DB_KIND" != sqlite ]]; then
    info "Starting database service..."; dc up -d "$DB_SVC" >/dev/null 2>&1
    wait_db 180 || { err "Database not ready (docker logs ${DB_SVC:-db})"; [[ -n "$tmpd" ]] && rm -rf "$tmpd"; return 1; }
  fi
  ( create_backup lite pre-dbrestore >/dev/null 2>&1 ) && ok "Safety backup of the current DB saved in $LOCAL_BACKUP_DIR" || warn "Safety backup skipped"
  dc stop "$(app_svc)" >/dev/null 2>&1
  case "$DB_KIND" in
    postgres) if [[ "$ftype" == pgdump ]]; then pg_import "$work"; else pg_import_sql "$work"; fi; rc=$? ;;
    mysql)    mysql_import "$work"; rc=$? ;;
    sqlite)   target="${SQLITE_FILE:-$DATA_DIR/db.sqlite3}"; mkdir -p "$(dirname "$target")"
              [[ -f "$target" ]] && cp -a "$target" "$target.pre-restore"; cp -f "$work" "$target"; rc=$? ;;
  esac
  [[ -n "$tmpd" ]] && rm -rf "$tmpd"
  dc up -d >/dev/null 2>&1
  sleep 3; db_detect; u=$(db_count users 2>/dev/null)
  [[ $rc -eq 0 ]] && ok "Database restored — users in DB: ${u:-?}" || err "Database restore failed"
  return $rc
}
restore_foreign(){   # extracted archive with no pg-m manifest (e.g. official backup zip)
  local d="$1" files=() f i=0 sel envf certd
  mapfile -t files < <(find "$d" -type f \( -name '*.sql' -o -name '*.sql.gz' -o -name '*.dump' -o -name '*.pgc' -o -name '*.sqlite3' -o -name '*.db' \) -size +0 2>/dev/null)
  envf=$(find "$d" -maxdepth 6 -type f \( -name '.env' -o -name 'env.backup' \) 2>/dev/null | head -1)
  certd=$(find "$d" -maxdepth 8 -type d -name certs 2>/dev/null | head -1)
  echo -e "  ${BOLD}Found inside the archive${NC}"; hr
  for f in "${files[@]}"; do i=$((i+1)); printf "   %d) DB file : %s (%s)\n" "$i" "${f#$d/}" "$(du -h "$f" | cut -f1)"; done
  [[ -n "$envf" ]]  && echo "      .env    : ${envf#$d/}"
  [[ -n "$certd" ]] && echo "      certs   : ${certd#$d/}"
  if (( ${#files[@]} == 0 )) && [[ -z "$envf" && -z "$certd" ]]; then err "Nothing restorable found in this archive"; return 1; fi
  hr
  if [[ -n "$envf" ]] && confirm "Replace current .env with the one in the backup? (old one kept as .env.pre-restore)" n; then
    mkdir -p "$APP_DIR"; [[ -f "$ENV_FILE" ]] && cp -a "$ENV_FILE" "$ENV_FILE.pre-restore"; cp -f "$envf" "$ENV_FILE"; chmod 600 "$ENV_FILE"; ok ".env replaced"
  fi
  if [[ -n "$certd" ]] && confirm "Copy certificates to $DATA_DIR/certs ?" n; then
    mkdir -p "$DATA_DIR/certs"; cp -a "$certd"/. "$DATA_DIR/certs/"; ok "Certificates copied"
  fi
  if (( ${#files[@]} > 0 )); then
    sel=1; (( ${#files[@]} > 1 )) && { read -rp "  Which database file [1]: " sel; sel=${sel:-1}; }
    [[ "$sel" =~ ^[0-9]+$ && $sel -ge 1 && $sel -le ${#files[@]} ]] || { err "Invalid choice"; return 1; }
    restore_db_file "${files[$((sel-1))]}" || return 1
  fi
  return 0
}
restore_db_from_any(){   # menu: restore ONLY the database from any backup
  local f="$1" k tmp root
  k=$(file_kind "$f")
  case "$k" in
    sql|pgdump|sqlite) restore_db_file "$f" ;;
    pgm|archive)
      tmp=$(mktemp -d -p /var/tmp pgm-dbx.XXXXXX); extract_any "$f" "$tmp" || { err "Cannot extract"; rm -rf "$tmp"; return 1; }
      root=$(dirname "$(find "$tmp" -maxdepth 5 -name manifest.env | head -1)" 2>/dev/null)
      if [[ -d "$root/db" ]]; then local dbf; dbf=$(find "$root/db" -type f | head -1); restore_db_file "$dbf"
      else restore_foreign "$tmp"; fi
      rm -rf "$tmp" ;;
    *) err "Unsupported file"; return 1 ;;
  esac
}

restore_archive(){   # restore_archive FILE|DIR  (pg-m package; falls back to generic restore)
  local arc="$1" rc=0 m inner
  RESTORE_TMP=""; RESTORE_ROOT=""
  if [[ -d "$arc" ]]; then
    m=$(find "$arc" -maxdepth 6 -name manifest.env | head -1)
    [[ -n "$m" ]] || { err "No manifest.env in $arc"; return 1; }
    RESTORE_ROOT=$(dirname "$m")
  else
    [[ -f "$arc" ]] || { err "File not found: $arc"; return 1; }
    if [[ -f "$arc.sha256" ]]; then
      ( cd "$(dirname "$arc")" && sha256sum -c "$(basename "$arc").sha256" >/dev/null 2>&1 ) && ok "Checksum OK" || { err "Checksum mismatch — archive damaged"; return 1; }
    fi
    RESTORE_TMP=$(mktemp -d -p /var/tmp pg-m-restore.XXXXXX) || return 1
    info "Extracting archive..."
    extract_any "$arc" "$RESTORE_TMP" || { err "Cannot extract archive"; rm -rf "$RESTORE_TMP"; return 1; }
    m=$(find "$RESTORE_TMP" -maxdepth 6 -name manifest.env | head -1)
    if [[ -z "$m" ]]; then   # archive inside archive?
      while read -r inner; do
        [[ -n "$inner" ]] || continue
        mkdir -p "$RESTORE_TMP/nested"; extract_any "$inner" "$RESTORE_TMP/nested" 2>/dev/null
      done < <(find "$RESTORE_TMP" -maxdepth 3 -type f \( -name '*.tar.gz' -o -name '*.tgz' -o -name '*.zip' \))
      m=$(find "$RESTORE_TMP" -maxdepth 7 -name manifest.env | head -1)
    fi
    if [[ -z "$m" ]]; then
      warn "Not a pg-m package — generic restore mode (database dump / .env / certs)"
      restore_foreign "$RESTORE_TMP"; rc=$?; rm -rf "$RESTORE_TMP"; return $rc
    fi
    RESTORE_ROOT=$(dirname "$m")
  fi
  _restore_run; rc=$?
  [[ -n "$RESTORE_TMP" ]] && rm -rf "$RESTORE_TMP"
  return $rc
}

_restore_run(){
  local rc=0 nd
  echo -e "  ${BOLD}Package contents${NC}"; hr
  echo "  Created   : $(mf CREATED)   (pg-m $(mf PGM_VERSION))"
  echo "  Source    : $(mf SRC_HOST) / $(mf SRC_IP)"
  echo "  Database  : $(mf DB_KIND)   users=$(mf USERS) admins=$(mf ADMINS) nodes=$(mf NODES)"
  echo "  Domains   : $(mf DOMAINS)"
  echo "  Node data : local node on source=$(mf HAD_NODE), included=$(mf NODE_INCLUDED)"
  hr
  if [[ $AUTO -ne 1 ]]; then
    warn "This will OVERWRITE the panel configuration and database on THIS server."
    confirm_yes "Continue" || { echo "  Cancelled"; return 1; }
  fi
  ensure_docker || return 1
  has_cmd curl || apt-get install -y -qq curl >/dev/null 2>&1

  if [[ -f "$COMPOSE_FILE" ]] && docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qi pasarguard; then
    info "Existing panel found — safety snapshot first..."
    ( create_backup full pre-restore >/dev/null 2>&1 ) && ok "Snapshot saved in $LOCAL_BACKUP_DIR" || warn "Snapshot failed — continuing"
    dc down >/dev/null 2>&1 || true
  fi

  info "Restoring files..."
  mkdir -p /opt /var/lib /etc
  tar -C "$RESTORE_ROOT/files" -cf - . | tar -C / --no-overwrite-dir -xpf - || { err "File restore failed"; return 1; }
  fix_compose_volumes; chmod 600 "$ENV_FILE" 2>/dev/null || true
  ok "Files restored"

  local dbk db_file sqlite_name svc
  db_detect; dbk="$DB_KIND"; db_file=$(mf DB_FILE); sqlite_name=$(mf SQLITE_NAME)
  case "$dbk" in
    sqlite)
      mkdir -p "$DATA_DIR"
      if [[ -n "$db_file" && -f "$RESTORE_ROOT/db/$db_file" ]]; then cp -a "$RESTORE_ROOT/db/$db_file" "$DATA_DIR/${sqlite_name:-$db_file}"; ok "SQLite database restored"; fi ;;
    postgres|mysql)
      svc=$(db_service); [[ -z "$svc" ]] && { err "Cannot find DB service in compose file"; return 1; }
      info "Starting database service ($svc)..."
      dc pull -q "$svc" >/dev/null 2>&1 || true
      dc up -d "$svc" >/var/log/pg-m-up.log 2>&1 || { err "Cannot start $svc"; tail -5 /var/log/pg-m-up.log; return 1; }
      info "Waiting for the REAL database server (first start can take a minute)..."
      wait_db 300 || { err "Database did not become ready (docker logs of the DB container)"; return 1; }
      if [[ -n "$db_file" && -f "$RESTORE_ROOT/db/$db_file" ]]; then
        if [[ "$dbk" == postgres ]]; then pg_import "$RESTORE_ROOT/db/$db_file" || { err "Import failed — panel NOT started. Retry: pg-m restore <package>"; return 1; }
        else mysql_import "$RESTORE_ROOT/db/$db_file" || { err "Import failed"; return 1; }; ok "Database imported"; fi
      else warn "No database dump in package"; fi ;;
  esac

  info "Starting the full stack..."
  dc pull -q >/dev/null 2>&1 || true
  dc up -d >/var/log/pg-m-up.log 2>&1 || { err "docker compose up failed"; tail -5 /var/log/pg-m-up.log; rc=1; }
  for nd in $(node_list | sort -u); do NODE_DIR="$nd" node_ncomp up -d >/dev/null 2>&1; done

  if ! has_pg; then
    info "Installing official 'pasarguard' CLI..."
    bash -c "$(curl -fsSL "$OFFICIAL_SCRIPT")" @ install-script >/dev/null 2>&1 || warn "CLI not installed (not critical — compose is used directly)"
  fi
  self_install
  local cf; for cf in "$RESTORE_ROOT"/misc/pg-m-*; do [[ -f "$cf" ]] && { cp -a "$cf" /etc/cron.d/; chmod 644 "/etc/cron.d/$(basename "$cf")"; }; done
  if [[ -d /etc/letsencrypt/renewal ]]; then
    has_cmd certbot || apt-get install -y -qq certbot >/dev/null 2>&1 || true
    install_cert_hook
  fi
  if has_cmd ufw && ufw status 2>/dev/null | grep -q 'Status: active'; then
    ufw allow "$(ssh_port)/tcp" >/dev/null 2>&1; ufw allow "$(get_port)/tcp" >/dev/null 2>&1
    ufw allow 80/tcp >/dev/null 2>&1; ufw allow 443/tcp >/dev/null 2>&1
    ok "UFW: opened SSH, 80, 443 and panel port"
  fi

  info "Waiting for panel to answer..."
  local up=0 i code
  for i in $(seq 1 45); do
    code=$(curl -sk --max-time 3 -o /dev/null -w '%{http_code}' "$(panel_scheme)://127.0.0.1:$(get_port)/dashboard/" 2>/dev/null)
    [[ "$code" =~ ^[1-5][0-9][0-9]$ ]] && { up=1; break; }
    sleep 2
  done
  [[ $up -eq 1 ]] && ok "Panel is answering (HTTP $code)" || { err "Panel not answering yet — check: pasarguard logs"; rc=1; }

  db_detect
  local u a n ou oa on
  u=$(db_count users 2>/dev/null); a=$(db_count admins 2>/dev/null); n=$(db_count nodes 2>/dev/null)
  ou=$(mf USERS); oa=$(mf ADMINS); on=$(mf NODES)
  echo -e "  ${BOLD}Verification (source → this server)${NC}"
  printf "    users  : %s → %s  %s\n" "${ou:--}" "${u:--}" "$([[ -n "$ou" && "$ou" == "$u" ]] && echo '✔' || echo '✘ MISMATCH')"
  printf "    admins : %s → %s  %s\n" "${oa:--}" "${a:--}" "$([[ -n "$oa" && "$oa" == "$a" ]] && echo '✔' || echo '✘ MISMATCH')"
  printf "    nodes  : %s → %s  %s\n" "${on:--}" "${n:--}" "$([[ -n "$on" && "$on" == "$n" ]] && echo '✔' || echo '✘ MISMATCH')"
  if [[ -n "$ou" && "$ou" != "$u" ]]; then err "User count differs — restore incomplete"; rc=1; fi

  # fresh node instead of the old node's API key / certificate
  if [[ "$(mf HAD_NODE)" == yes && "$(mf NODE_INCLUDED)" != yes && -z "$(node_list)" ]]; then
    if [[ $FRESH_NODE -eq 1 ]] || { [[ $AUTO -ne 1 ]] && confirm "Source had a local node. Install a FRESH node here (new API key + cert)?" y; }; then
      install_fresh_node || warn "Fresh node install had problems"
    fi
  fi
  log "restore rc=$rc"
  return $rc
}

# ═════════════════ Backup menu + schedule ═════════════════
schedule_setup(){
  header; echo -e "  ${BOLD}Scheduled automatic backups${NC}"; hr
  if [[ -f /etc/cron.d/pg-m-backup ]]; then
    echo "  Now: every $(conf_get TG_INTERVAL)h  mode=$(conf_get TG_MODE)  keep=$(conf_get KEEP_BACKUPS)  telegram=$([[ -n "$(conf_get TG_TOKEN)" ]] && echo yes || echo no)"
  else echo "  Now: disabled"; fi
  echo "  1. Enable / change schedule"; echo "  2. Disable"; echo "  0. Back"; hr
  read -rp "  Select: " o
  case $o in
    1)
      ask "Every N hours (1-24)" iv "$(conf_get TG_INTERVAL)"; [[ "$iv" =~ ^[0-9]+$ && $iv -ge 1 && $iv -le 24 ]] || iv=6
      ask "Mode: lite (DB+config) or full" md "$(conf_get TG_MODE)"; [[ "$md" == full ]] || md=lite
      ask "Keep how many backups" kp "$(conf_get KEEP_BACKUPS)"; [[ "$kp" =~ ^[0-9]+$ ]] || kp=10
      conf_set TG_INTERVAL "$iv"; conf_set TG_MODE "$md"; conf_set KEEP_BACKUPS "$kp"
      if [[ "$iv" == 24 ]]; then echo "0 3 * * * root $INSTALL_PATH --telegram-backup >> $LOG_FILE 2>&1" > /etc/cron.d/pg-m-backup
      else echo "0 */${iv} * * * root $INSTALL_PATH --telegram-backup >> $LOG_FILE 2>&1" > /etc/cron.d/pg-m-backup; fi
      chmod 644 /etc/cron.d/pg-m-backup
      ok "Enabled: every ${iv}h, ${md}, keep ${kp}  (sent to Telegram only if configured)" ;;
    2) rm -f /etc/cron.d/pg-m-backup; ok "Disabled" ;;
  esac
}

m_backup(){
  while true; do
