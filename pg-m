                echo -e "  ${YELLOW}Use on login page > Owner access${NC}"
                pause
                ;;
            2) show_links; pause ;;
            3) [[ -f "$ENV_FILE" ]] && cat "$ENV_FILE" || echo "  missing"; pause ;;
            4) pasarguard edit-env ;;
            5) pasarguard edit ;;
            6) grep -i SQLALCHEMY_DATABASE_URL "$ENV_FILE" 2>/dev/null || echo "  n/a"; pause ;;
            7)
                echo "  Manager: $SCRIPT_VERSION"
