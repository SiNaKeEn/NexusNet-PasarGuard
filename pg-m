#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
#  PasarGuard Manager (pg-m)
#  A comprehensive management menu for PasarGuard Panel & Node
#  Version: 1.0.0
# ═══════════════════════════════════════════════════════════════

set -euo pipefail

# ── Colors ───────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
WHITE='\033[1;37m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# ── Paths ────────────────────────────────────────────────────
APP_DIR="/opt/pasarguard"
DATA_DIR="/var/lib/pasarguard"
ENV_FILE="${APP_DIR}/.env"
BACKUP_DIR="${APP_DIR}/backup"
SCRIPT_VERSION="1.0.0"

# ── Helpers ──────────────────────────────────────────────────
print_header() {
    clear
    echo -e "${CYAN}"
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║                                                          ║"
    echo "║              PasarGuard Manager  v${SCRIPT_VERSION}                ║"
    echo "║                                                          ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

print_line() {
    echo -e "${CYAN}──────────────────────────────────────────────────────────${NC}"
}

pause() {
    echo
    read -rp "Press Enter to continue..."
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}[ERROR] This script must be run as root.${NC}"
        exit 1
    fi
}

check_pasarguard() {
    if ! command -v pasarguard &>/dev/null; then
        echo -e "${YELLOW}[WARN] pasarguard command not found.${NC}"
        return 1
    fi
    return 0
}

run_cmd() {
    echo -e "${BLUE}>> Running: $*${NC}"
    "$@"
}

# ── Service Management ───────────────────────────────────────
service_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Service Management${NC}"
        print_line
        echo "  1) Start"
        echo "  2) Stop"
        echo "  3) Restart"
        echo "  4) Status"
        echo "  5) Logs (follow)"
        echo "  6) Logs (no-follow)"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1) pasarguard up; pause ;;
            2) pasarguard down; pause ;;
            3) pasarguard restart; pause ;;
            4) pasarguard status; pause ;;
            5) pasarguard logs ;;
            6) pasarguard logs -n; pause ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Install / Update / Uninstall ─────────────────────────────
install_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Install / Update / Uninstall${NC}"
        print_line
        echo "  1) Install (TimescaleDB - Recommended)"
        echo "  2) Install (PostgreSQL)"
        echo "  3) Install (SQLite)"
        echo "  4) Install (MySQL)"
        echo "  5) Install (MariaDB)"
        echo "  6) Update to latest"
        echo "  7) Uninstall"
        echo "  8) Reinstall Script"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1)
                run_cmd bash -c "$(curl -fsSL https://github.com/PasarGuard/scripts/raw/main/pasarguard.sh)" @ install --database timescaledb
                pause
                ;;
            2)
                run_cmd bash -c "$(curl -fsSL https://github.com/PasarGuard/scripts/raw/main/pasarguard.sh)" @ install --database postgresql
                pause
                ;;
            3)
                run_cmd bash -c "$(curl -fsSL https://github.com/PasarGuard/scripts/raw/main/pasarguard.sh)" @ install
                pause
                ;;
            4)
                run_cmd bash -c "$(curl -fsSL https://github.com/PasarGuard/scripts/raw/main/pasarguard.sh)" @ install --database mysql
                pause
                ;;
            5)
                run_cmd bash -c "$(curl -fsSL https://github.com/PasarGuard/scripts/raw/main/pasarguard.sh)" @ install --database mariadb
                pause
                ;;
            6)
                run_cmd pasarguard update
                pause
                ;;
            7)
                echo -e "${RED}This will completely remove PasarGuard!${NC}"
                read -rp "Are you sure? (yes/no): " confirm
                if [[ "$confirm" == "yes" ]]; then
                    run_cmd pasarguard uninstall
                fi
                pause
                ;;
            8)
                run_cmd pasarguard install-script
                pause
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── SSL & Domain ─────────────────────────────────────────────
ssl_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  SSL & Domain Management${NC}"
        print_line
        echo "  1) Issue Let's Encrypt SSL (Domain)"
        echo "  2) View current SSL settings"
        echo "  3) Edit .env (SSL paths)"
        echo "  4) Restart after SSL change"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1)
                read -rp "Enter your domain (e.g. panel.example.com): " domain
                if [[ -n "$domain" ]]; then
                    apt update -y && apt install -y certbot
                    certbot certonly --standalone -d "$domain" --non-interactive --agree-tos --register-unsafely-without-email || \
                    certbot certonly --standalone -d "$domain"
                    echo
                    echo -e "${GREEN}Certificate issued. Update .env with:${NC}"
                    echo "UVICORN_SSL_CERTFILE=/etc/letsencrypt/live/${domain}/fullchain.pem"
                    echo "UVICORN_SSL_KEYFILE=/etc/letsencrypt/live/${domain}/privkey.pem"
                fi
                pause
                ;;
            2)
                echo -e "${CYAN}Current SSL related settings:${NC}"
                grep -E "SSL|UVICORN|DOMAIN" "$ENV_FILE" 2>/dev/null || echo "No SSL settings found"
                pause
                ;;
            3)
                pasarguard edit-env
                ;;
            4)
                pasarguard restart
                pause
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Backup & Restore ─────────────────────────────────────────
backup_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Backup & Restore${NC}"
        print_line
        echo "  1) Manual Backup (official)"
        echo "  2) Setup Auto Backup to Telegram"
        echo "  3) Restore (official)"
        echo "  4) List backup files"
        echo "  5) Download backup path info"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1)
                run_cmd pasarguard backup
                pause
                ;;
            2)
                run_cmd pasarguard backup-service
                pause
                ;;
            3)
                run_cmd pasarguard restore
                pause
                ;;
            4)
                echo -e "${CYAN}Backup files:${NC}"
                ls -lh "$BACKUP_DIR" 2>/dev/null || echo "No backup directory found"
                pause
                ;;
            5)
                echo -e "Backup directory : ${GREEN}${BACKUP_DIR}${NC}"
                echo -e "App directory    : ${GREEN}${APP_DIR}${NC}"
                echo -e "Data directory   : ${GREEN}${DATA_DIR}${NC}"
                pause
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Panel Settings ───────────────────────────────────────────
settings_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Panel Settings${NC}"
        print_line
        echo "  1) Generate Temp Key (Owner setup)"
        echo "  2) View current .env"
        echo "  3) Edit .env"
        echo "  4) Edit docker-compose.yml"
        echo "  5) Show database type"
        echo "  6) Show panel version"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1)
                pasarguard cli generate-temp-key
                pause
                ;;
            2)
                if [[ -f "$ENV_FILE" ]]; then
                    cat "$ENV_FILE"
                else
                    echo "No .env file found"
                fi
                pause
                ;;
            3)
                pasarguard edit-env
                ;;
            4)
                pasarguard edit
                ;;
            5)
                echo -e "${CYAN}Database URL:${NC}"
                grep -i "SQLALCHEMY_DATABASE_URL" "$ENV_FILE" 2>/dev/null || echo "Not found"
                pause
                ;;
            6)
                pasarguard version-script 2>/dev/null || echo "Version info not available"
                docker images | grep pasarguard || true
                pause
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Node Management ──────────────────────────────────────────
node_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Node Management${NC}"
        print_line
        echo "  1) Install Node (default)"
        echo "  2) Install Node with custom name"
        echo "  3) Node help"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1)
                run_cmd bash -c "$(curl -sL https://github.com/PasarGuard/scripts/raw/main/pg-node.sh)" @ install
                pause
                ;;
            2)
                read -rp "Enter node name (e.g. node-eu-1): " nname
                if [[ -n "$nname" ]]; then
                    run_cmd bash -c "$(curl -sL https://github.com/PasarGuard/scripts/raw/main/pg-node.sh)" @ install --name "$nname"
                fi
                pause
                ;;
            3)
                if command -v pg-node &>/dev/null; then
                    pg-node --help
                else
                    echo "pg-node is not installed yet"
                fi
                pause
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Firewall & Security ──────────────────────────────────────
firewall_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Firewall & Security${NC}"
        print_line
        echo "  1) Install & Enable UFW"
        echo "  2) Allow SSH (22)"
        echo "  3) Allow Panel Port (8000)"
        echo "  4) Allow HTTP/HTTPS (80/443)"
        echo "  5) Show UFW status"
        echo "  6) Enable BBR"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1)
                apt update -y && apt install -y ufw
                ufw default deny incoming
                ufw default allow outgoing
                ufw allow 22/tcp
                ufw --force enable
                echo -e "${GREEN}UFW enabled${NC}"
                pause
                ;;
            2)
                ufw allow 22/tcp
                echo -e "${GREEN}SSH port allowed${NC}"
                pause
                ;;
            3)
                ufw allow 8000/tcp
                echo -e "${GREEN}Port 8000 allowed${NC}"
                pause
                ;;
            4)
                ufw allow 80/tcp
                ufw allow 443/tcp
                echo -e "${GREEN}HTTP/HTTPS allowed${NC}"
                pause
                ;;
            5)
                ufw status verbose
                pause
                ;;
            6)
                if ! grep -q "bbr" /etc/sysctl.conf 2>/dev/null; then
                    echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
                    echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
                    sysctl -p
                    echo -e "${GREEN}BBR enabled${NC}"
                else
                    echo "BBR already configured"
                fi
                pause
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Tools ────────────────────────────────────────────────────
tools_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Tools${NC}"
        print_line
        echo "  1) Speedtest"
        echo "  2) Check disk usage"
        echo "  3) Check memory"
        echo "  4) Show listening ports"
        echo "  5) Restart Docker"
        echo "  6) Clean Docker (unused)"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1)
                if ! command -v speedtest-cli &>/dev/null; then
                    apt install -y speedtest-cli 2>/dev/null || pip3 install speedtest-cli
                fi
                speedtest-cli --simple || speedtest
                pause
                ;;
            2)
                df -h
                pause
                ;;
            3)
                free -h
                pause
                ;;
            4)
                ss -tlnp
                pause
                ;;
            5)
                systemctl restart docker
                echo -e "${GREEN}Docker restarted${NC}"
                pause
                ;;
            6)
                docker system prune -f
                echo -e "${GREEN}Docker cleaned${NC}"
                pause
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Quick Actions ────────────────────────────────────────────
quick_status() {
    print_header
    echo -e "${BOLD}  Quick Status${NC}"
    print_line
    if check_pasarguard; then
        pasarguard status
    else
        echo -e "${YELLOW}PasarGuard is not installed${NC}"
    fi
    echo
    echo -e "${CYAN}Disk:${NC}"
    df -h / | tail -1
    echo
    echo -e "${CYAN}Memory:${NC}"
    free -h | grep Mem
    pause
}

# ── Main Menu ────────────────────────────────────────────────
main_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Main Menu${NC}"
        print_line
        echo -e "  ${GREEN}1)${NC}  Service Management"
        echo -e "  ${GREEN}2)${NC}  Install / Update / Uninstall"
        echo -e "  ${GREEN}3)${NC}  SSL & Domain Management"
        echo -e "  ${GREEN}4)${NC}  Backup & Restore"
        echo -e "  ${GREEN}5)${NC}  Panel Settings"
        echo -e "  ${GREEN}6)${NC}  Node Management"
        echo -e "  ${GREEN}7)${NC}  Firewall & Security"
        echo -e "  ${GREEN}8)${NC}  Tools"
        echo -e "  ${GREEN}9)${NC}  Quick Status"
        echo -e "  ${RED}0)${NC}  Exit"
        print_line
        read -rp "Select option: " choice
        case $choice in
            1) service_menu ;;
            2) install_menu ;;
            3) ssl_menu ;;
            4) backup_menu ;;
            5) settings_menu ;;
            6) node_menu ;;
            7) firewall_menu ;;
            8) tools_menu ;;
            9) quick_status ;;
            0)
                echo -e "${GREEN}Goodbye!${NC}"
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid option${NC}"
                sleep 1
                ;;
        esac
    done
}

# ── Entry Point ──────────────────────────────────────────────
check_root
main_menu
