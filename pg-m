#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
#  PasarGuard Manager (pg-m)  v1.3.0
#  Clean x-ui style menu for PasarGuard Panel & Node
# ═══════════════════════════════════════════════════════════════

set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'; BOLD='\033[1m'

APP_DIR="/opt/pasarguard"
DATA_DIR="/var/lib/pasarguard"
ENV_FILE="${APP_DIR}/.env"
BACKUP_DIR="${APP_DIR}/backup"
SCRIPT_VERSION="1.3.0"

print_header() {
    clear
    echo -e "${GREEN}"
    echo "  ╔════════════════════════════════════════════╗"
    echo "  ║      PasarGuard Manager  v${SCRIPT_VERSION}           ║"
    echo "  ╚════════════════════════════════════════════╝"
    echo -e "${NC}"
}

print_line() { echo -e "${CYAN}  ────────────────────────────────────────────${NC}"; }

pause() { echo; read -rp "  Press Enter to continue..."; }

check_root() {
    [[ $EUID -eq 0 ]] || { echo -e "${RED}  [ERROR] Run as root${NC}"; exit 1; }
}

check_pg() { command -v pasarguard &>/dev/null; }

get_env() {
    local key="$1"
    [[ -f "$ENV_FILE" ]] && grep -E "^${key}=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '"'"'"' ' || true
}

get_ip() {
    curl -s4 --max-time 3 ifconfig.me 2>/dev/null || curl -s4 --max-time 3 api.ipify.org 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}'
}

get_port() {
    local p; p=$(get_env "UVICORN_PORT"); [[ -z "$p" ]] && p="8000"; echo "$p"
}

has_ssl() {
    local c; c=$(get_env "UVICORN_SSL_CERTFILE"); [[ -n "$c" ]] && echo 1 || echo 0
}

panel_url() {
    local ip port scheme
    ip=$(get_ip); port=$(get_port)
    [[ $(has_ssl) -eq 1 ]] && scheme="https" || scheme="http"
    if { [[ "$port" == "443" && "$scheme" == "https" ]] || [[ "$port" == "80" && "$scheme" == "http" ]]; }; then
        echo "${scheme}://${ip}/dashboard/"
    else
        echo "${scheme}://${ip}:${port}/dashboard/"
    fi
}

show_links() {
    local ip port cert domain
    ip=$(get_ip); port=$(get_port); cert=$(get_env "UVICORN_SSL_CERTFILE")
    echo -e "  ${BOLD}Panel Link${NC}"
    print_line
    echo -e "  URL   : ${GREEN}$(panel_url)${NC}"
    echo -e "  IP    : ${CYAN}${ip}${NC}"
    echo -e "  Port  : ${CYAN}${port}${NC}"
    if [[ -n "$cert" ]]; then
        echo -e "  SSL   : ${GREEN}Enabled${NC}"
        echo -e "  Cert  : ${CYAN}${cert}${NC}"
        if echo "$cert" | grep -q "letsencrypt/live/"; then
            domain=$(echo "$cert" | sed -n 's|.*/live/\([^/]*\)/.*|\1|p')
            [[ -n "$domain" ]] && echo -e "  Domain: ${GREEN}https://${domain}/dashboard/${NC}"
        fi
    else
        echo -e "  SSL   : ${YELLOW}Disabled${NC}"
    fi
    print_line
}

# ── SSL helpers ──────────────────────────────────────────────
list_certs() {
    echo -e "  ${BOLD}Installed certificates${NC}"
    print_line
    if [[ ! -d /etc/letsencrypt/live ]]; then
        echo -e "  ${YELLOW}No Let's Encrypt certificates found${NC}"
        return
    fi
    local d exp status
    for d in /etc/letsencrypt/live/*/; do
        [[ -d "$d" ]] || continue
        local name; name=$(basename "$d")
        [[ "$name" == "README" ]] && continue
        if [[ -f "${d}fullchain.pem" ]]; then
            exp=$(openssl x509 -enddate -noout -in "${d}fullchain.pem" 2>/dev/null | cut -d= -f2)
            if openssl x509 -checkend 0 -noout -in "${d}fullchain.pem" 2>/dev/null; then
                if openssl x509 -checkend 2592000 -noout -in "${d}fullchain.pem" 2>/dev/null; then
                    status="${GREEN}Active${NC}"
                else
                    status="${YELLOW}Expires soon (<30 days)${NC}"
                fi
            else
                status="${RED}EXPIRED${NC}"
            fi
            echo -e "  Domain : ${CYAN}${name}${NC}"
            echo -e "  Status : ${status}"
            echo -e "  Expiry : ${exp}"
            echo -e "  Path   : ${d}fullchain.pem"
            print_line
        fi
    done
}

