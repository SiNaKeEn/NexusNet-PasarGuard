#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
#  PasarGuard Manager (pg-m)
#  Comprehensive management menu for PasarGuard Panel & Node
#  Version: 1.1.0
# ═══════════════════════════════════════════════════════════════

set -euo pipefail

# ── Colors ───────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'
BOLD='\033[1m'

# ── Paths ────────────────────────────────────────────────────
APP_DIR="/opt/pasarguard"
DATA_DIR="/var/lib/pasarguard"
ENV_FILE="${APP_DIR}/.env"
BACKUP_DIR="${APP_DIR}/backup"
SCRIPT_VERSION="1.1.0"

# ── Helpers ──────────────────────────────────────────────────
print_header() {
    clear
    echo -e "${CYAN}"
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║                                                          ║"
    echo "║           PasarGuard Manager  v${SCRIPT_VERSION}                   ║"
    echo "║                                                          ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

print_line() {
    echo -e "${CYAN}──────────────────────────────────────────────────────────${NC}"
}

pause() {
    echo
    read -rp "Press Enter to continue..."
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}[ERROR] This script must be run as root.${NC}"
        exit 1
    fi
}

check_pasarguard() {
    command -v pasarguard &>/dev/null
}

run_cmd() {
    echo -e "${BLUE}>> $*${NC}"
    "$@"
}

# ── Service Management ───────────────────────────────────────
service_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Service Management${NC}"
        print_line
        echo "  1) Start"
        echo "  2) Stop"
        echo "  3) Restart"
        echo "  4) Status"
        echo "  5) Logs (follow)"
        echo "  6) Logs (no-follow)"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1) pasarguard up; pause ;;
            2) pasarguard down; pause ;;
            3) pasarguard restart; pause ;;
            4) pasarguard status; pause ;;
            5) pasarguard logs ;;
            6) pasarguard logs -n; pause ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Install / Update / Uninstall ─────────────────────────────
install_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Install / Update / Uninstall${NC}"
        print_line
        echo "  1) Install (TimescaleDB - Recommended)"
        echo "  2) Install (PostgreSQL)"
        echo "  3) Install (SQLite)"
        echo "  4) Install (MySQL)"
        echo "  5) Install (MariaDB)"
        echo "  6) Update to latest"
        echo "  7) Uninstall"
        echo "  8) Reinstall Script"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1)
                run_cmd bash -c "$(curl -fsSL https://github.com/PasarGuard/scripts/raw/main/pasarguard.sh)" @ install --database timescaledb
                pause
                ;;
            2)
                run_cmd bash -c "$(curl -fsSL https://github.com/PasarGuard/scripts/raw/main/pasarguard.sh)" @ install --database postgresql
                pause
                ;;
            3)
                run_cmd bash -c "$(curl -fsSL https://github.com/PasarGuard/scripts/raw/main/pasarguard.sh)" @ install
                pause
                ;;
            4)
                run_cmd bash -c "$(curl -fsSL https://github.com/PasarGuard/scripts/raw/main/pasarguard.sh)" @ install --database mysql
                pause
                ;;
            5)
                run_cmd bash -c "$(curl -fsSL https://github.com/PasarGuard/scripts/raw/main/pasarguard.sh)" @ install --database mariadb
                pause
                ;;
            6)
                run_cmd pasarguard update
                pause
                ;;
            7)
                echo -e "${RED}This will completely remove PasarGuard!${NC}"
                read -rp "Type 'yes' to confirm: " confirm
                if [[ "$confirm" == "yes" ]]; then
                    run_cmd pasarguard uninstall
                fi
                pause
                ;;
            8)
                run_cmd pasarguard install-script
                pause
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── SSL & Domain ─────────────────────────────────────────────
ssl_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  SSL & Domain Management${NC}"
        print_line
        echo "  1) Issue Let's Encrypt SSL (Domain)"
        echo "  2) Generate Self-Signed Certificate"
        echo "  3) View current SSL settings"
        echo "  4) Edit .env (SSL paths)"
        echo "  5) Restart after SSL change"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1)
                read -rp "Enter your domain (e.g. panel.example.com): " domain
                if [[ -n "$domain" ]]; then
                    apt update -y >/dev/null 2>&1
                    apt install -y certbot >/dev/null 2>&1
                    echo -e "${YELLOW}Stopping panel temporarily for certbot...${NC}"
                    pasarguard down 2>/dev/null || true
                    certbot certonly --standalone -d "$domain" --non-interactive --agree-tos --register-unsafely-without-email 2>/dev/null || \
                    certbot certonly --standalone -d "$domain"
                    pasarguard up 2>/dev/null || true
                    echo
                    echo -e "${GREEN}Certificate issued. Add these to .env:${NC}"
                    echo "UVICORN_SSL_CERTFILE=/etc/letsencrypt/live/${domain}/fullchain.pem"
                    echo "UVICORN_SSL_KEYFILE=/etc/letsencrypt/live/${domain}/privkey.pem"
                    echo
                    echo -e "${YELLOW}Then run option 4 to edit .env and option 5 to restart.${NC}"
                fi
                pause
                ;;
            2)
                read -rp "Enter IP or domain for CN: " cn
                mkdir -p /var/lib/pasarguard/certs
                openssl req -x509 -newkey rsa:4096 \
                    -keyout /var/lib/pasarguard/certs/key.pem \
                    -out /var/lib/pasarguard/certs/cert.pem \
                    -days 36500 -nodes \
                    -subj "/CN=${cn}" 2>/dev/null
                echo -e "${GREEN}Self-signed certificate created:${NC}"
                echo "  Cert: /var/lib/pasarguard/certs/cert.pem"
                echo "  Key : /var/lib/pasarguard/certs/key.pem"
                echo
                echo "Add to .env:"
                echo "UVICORN_SSL_CERTFILE=/var/lib/pasarguard/certs/cert.pem"
                echo "UVICORN_SSL_KEYFILE=/var/lib/pasarguard/certs/key.pem"
                pause
                ;;
            3)
                echo -e "${CYAN}Current SSL related settings:${NC}"
                grep -E "SSL|UVICORN|CERT|KEY" "$ENV_FILE" 2>/dev/null || echo "No SSL settings found in .env"
                pause
                ;;
            4)
                pasarguard edit-env
                ;;
            5)
                pasarguard restart
                pause
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Backup & Restore ─────────────────────────────────────────
backup_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Backup & Restore${NC}"
        print_line
        echo "  1) Manual Backup (official)"
        echo "  2) Setup Auto Backup to Telegram"
        echo "  3) Restore (official)"
        echo "  4) List backup files"
        echo "  5) Show backup paths"
        echo "  6) Manual DB dump (PostgreSQL/Timescale)"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1) run_cmd pasarguard backup; pause ;;
            2) run_cmd pasarguard backup-service; pause ;;
            3) run_cmd pasarguard restore; pause ;;
            4)
                echo -e "${CYAN}Backup files:${NC}"
                ls -lh "$BACKUP_DIR" 2>/dev/null || echo "No backup directory found"
                pause
                ;;
            5)
                echo -e "Backup directory : ${GREEN}${BACKUP_DIR}${NC}"
                echo -e "App directory    : ${GREEN}${APP_DIR}${NC}"
                echo -e "Data directory   : ${GREEN}${DATA_DIR}${NC}"
                pause
                ;;
            6)
                OUT=~/pasarguard-db-$(date +%F-%H%M).dump
                CONTAINER=$(docker ps -qf "name=postgresql" | head -1)
                if [[ -n "$CONTAINER" ]]; then
                    docker exec "$CONTAINER" pg_dump -U pasarguard -d pasarguard -F c -f /tmp/pg.dump 2>/dev/null && \
                    docker cp "$CONTAINER":/tmp/pg.dump "$OUT" && \
                    echo -e "${GREEN}Dump saved: ${OUT}${NC}"
                else
                    echo -e "${RED}PostgreSQL container not found${NC}"
                fi
                pause
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Migrate to New Server ────────────────────────────────────
migrate_menu() {
    print_header
    echo -e "${BOLD}  Migrate to New Server${NC}"
    print_line
    echo -e "${YELLOW}This creates a full backup package for migration.${NC}"
    echo
    read -rp "Create migration package now? (yes/no): " confirm
    if [[ "$confirm" != "yes" ]]; then
        return
    fi

    MIGRATE_DIR=~/pasarguard-migrate-$(date +%F-%H%M)
    mkdir -p "$MIGRATE_DIR"

    echo -e "${CYAN}[1/4] Running official backup...${NC}"
    pasarguard backup 2>/dev/null || true

    echo -e "${CYAN}[2/4] Copying backup files...${NC}"
    cp -a "$BACKUP_DIR"/* "$MIGRATE_DIR/" 2>/dev/null || true

    echo -e "${CYAN}[3/4] Copying .env and certs...${NC}"
    cp -a "$ENV_FILE" "$MIGRATE_DIR/env.backup" 2>/dev/null || true
    cp -a /var/lib/pasarguard/certs "$MIGRATE_DIR/" 2>/dev/null || true
    cp -a /etc/letsencrypt "$MIGRATE_DIR/letsencrypt" 2>/dev/null || true

    echo -e "${CYAN}[4/4] Creating archive...${NC}"
    tar -czvf ~/pasarguard-migrate-$(date +%F-%H%M).tar.gz -C ~ "$(basename "$MIGRATE_DIR")" 2>/dev/null

    echo
    echo -e "${GREEN}Migration package ready:${NC}"
    ls -lh ~/pasarguard-migrate-*.tar.gz 2>/dev/null | tail -1
    echo
    echo -e "${YELLOW}On NEW server:${NC}"
    echo "  1. Install PasarGuard (same database type)"
    echo "  2. Upload and extract the archive"
    echo "  3. Run: pasarguard restore"
    echo "  4. Copy certs if needed and update .env"
    echo "  5. pasarguard restart"
    pause
}

# ── Panel Settings ───────────────────────────────────────────
settings_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Panel Settings${NC}"
        print_line
        echo "  1) Generate Temp Key (Owner / Admin setup)"
        echo "  2) Change Panel Port"
        echo "  3) View current .env"
        echo "  4) Edit .env"
        echo "  5) Edit docker-compose.yml"
        echo "  6) Show database type"
        echo "  7) Show panel / script version"
        echo "  8) Reset database password (PostgreSQL)"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1)
                echo -e "${CYAN}Generating temporary key (valid ~5 minutes)...${NC}"
                pasarguard cli generate-temp-key
                echo
                echo -e "${YELLOW}Go to panel login > Owner access > Create owner / Promote admin${NC}"
                pause
                ;;
            2)
                read -rp "Enter new panel port (current usually 8000): " newport
                if [[ -n "$newport" && "$newport" =~ ^[0-9]+$ ]]; then
                    if [[ -f "$ENV_FILE" ]]; then
                        if grep -q "^UVICORN_PORT=" "$ENV_FILE" 2>/dev/null; then
                            sed -i "s/^UVICORN_PORT=.*/UVICORN_PORT=${newport}/" "$ENV_FILE"
                        else
                            echo "UVICORN_PORT=${newport}" >> "$ENV_FILE"
                        fi
                        echo -e "${GREEN}Port set to ${newport}. Restarting...${NC}"
                        pasarguard restart
                    else
                        echo -e "${RED}.env not found${NC}"
                    fi
                else
                    echo -e "${RED}Invalid port${NC}"
                fi
                pause
                ;;
            3)
                if [[ -f "$ENV_FILE" ]]; then
                    cat "$ENV_FILE"
                else
                    echo "No .env file found"
                fi
                pause
                ;;
            4) pasarguard edit-env ;;
            5) pasarguard edit ;;
            6)
                echo -e "${CYAN}Database URL:${NC}"
                grep -i "SQLALCHEMY_DATABASE_URL" "$ENV_FILE" 2>/dev/null || echo "Not found"
                pause
                ;;
            7)
                echo -e "${CYAN}Script version:${NC} $SCRIPT_VERSION"
                pasarguard version-script 2>/dev/null || true
                docker images 2>/dev/null | grep -i pasarguard || true
                pause
                ;;
            8)
                read -rp "Enter new password for user 'pasarguard': " newpass
                if [[ -n "$newpass" ]]; then
                    CONTAINER=$(docker ps -qf "name=postgresql" | head -1)
                    if [[ -n "$CONTAINER" ]]; then
                        docker exec "$CONTAINER" psql -U pasarguard -d pasarguard \
                            -c "ALTER USER pasarguard WITH PASSWORD '${newpass}';" 2>/dev/null && \
                        echo -e "${GREEN}Password updated inside database.${NC}"
                        echo -e "${YELLOW}Also update SQLALCHEMY_DATABASE_URL in .env to match!${NC}"
                    else
                        echo -e "${RED}PostgreSQL container not found${NC}"
                    fi
                fi
                pause
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Node Management ──────────────────────────────────────────
node_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Node Management${NC}"
        print_line
        echo "  1) Install Node (default)"
        echo "  2) Install Node with custom name"
        echo "  3) Show Node API Key"
        echo "  4) Show Node Certificate"
        echo "  5) Show Node .env"
        echo "  6) Edit Node .env"
        echo "  7) Node help / status"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1)
                run_cmd bash -c "$(curl -sL https://github.com/PasarGuard/scripts/raw/main/pg-node.sh)" @ install
                pause
                ;;
            2)
                read -rp "Enter node name (e.g. node-eu-1): " nname
                if [[ -n "$nname" ]]; then
                    run_cmd bash -c "$(curl -sL https://github.com/PasarGuard/scripts/raw/main/pg-node.sh)" @ install --name "$nname"
                fi
                pause
                ;;
            3)
                echo -e "${CYAN}Searching for API_KEY...${NC}"
                found=0
                for f in /opt/pg-node/.env /var/lib/pg-node/.env; do
                    if [[ -f "$f" ]]; then
                        echo -e "${GREEN}File: $f${NC}"
                        grep -i "API_KEY" "$f" || true
                        found=1
                    fi
                done
                for d in /opt/pg-node*; do
                    if [[ -d "$d" && -f "$d/.env" ]]; then
                        echo -e "${GREEN}File: $d/.env${NC}"
                        grep -i "API_KEY" "$d/.env" || true
                        found=1
                    fi
                done
                if [[ $found -eq 0 ]]; then
                    echo -e "${YELLOW}No node .env found. Is the node installed?${NC}"
                    find /opt /var/lib -name "*.env" 2>/dev/null | head -10
                fi
                pause
                ;;
            4)
                echo -e "${CYAN}Searching for certificates...${NC}"
                for f in /var/lib/pg-node/certs/ssl_cert.pem /opt/pg-node/certs/ssl_cert.pem; do
                    if [[ -f "$f" ]]; then
                        echo -e "${GREEN}Found: $f${NC}"
                        echo "----- Certificate content (copy this) -----"
                        cat "$f"
                        echo "-------------------------------------------"
                    fi
                done
                find /var/lib /opt -name "ssl_cert.pem" 2>/dev/null | head -5
                pause
                ;;
            5)
                for f in /opt/pg-node/.env /var/lib/pg-node/.env; do
                    if [[ -f "$f" ]]; then
                        echo -e "${GREEN}=== $f ===${NC}"
                        cat "$f"
                        echo
                    fi
                done
                pause
                ;;
            6)
                if [[ -f /opt/pg-node/.env ]]; then
                    nano /opt/pg-node/.env
                elif [[ -f /var/lib/pg-node/.env ]]; then
                    nano /var/lib/pg-node/.env
                else
                    echo -e "${YELLOW}Node .env not found${NC}"
                    read -rp "Enter full path to node .env: " nenv
                    [[ -f "$nenv" ]] && nano "$nenv"
                fi
                ;;
            7)
                if command -v pg-node &>/dev/null; then
                    pg-node --help 2>/dev/null || true
                    pg-node status 2>/dev/null || true
                else
                    echo "pg-node command not found"
                    ls /usr/local/bin/ 2>/dev/null | grep -i node || true
                fi
                pause
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Firewall & Security ──────────────────────────────────────
firewall_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Firewall & Security${NC}"
        print_line
        echo "  1) Install & Enable UFW"
        echo "  2) Allow SSH (22)"
        echo "  3) Allow Panel Port (8000)"
        echo "  4) Allow HTTP/HTTPS (80/443)"
        echo "  5) Allow custom port"
        echo "  6) Show UFW status"
        echo "  7) Enable BBR"
        echo "  8) Install Fail2Ban (basic)"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1)
                apt update -y >/dev/null 2>&1
                apt install -y ufw >/dev/null 2>&1
                ufw default deny incoming
                ufw default allow outgoing
                ufw allow 22/tcp
                ufw --force enable
                echo -e "${GREEN}UFW enabled${NC}"
                pause
                ;;
            2) ufw allow 22/tcp; echo -e "${GREEN}SSH allowed${NC}"; pause ;;
            3) ufw allow 8000/tcp; echo -e "${GREEN}Port 8000 allowed${NC}"; pause ;;
            4) ufw allow 80/tcp; ufw allow 443/tcp; echo -e "${GREEN}HTTP/HTTPS allowed${NC}"; pause ;;
            5)
                read -rp "Enter port number: " p
                if [[ "$p" =~ ^[0-9]+$ ]]; then
                    ufw allow "${p}/tcp"
                    echo -e "${GREEN}Port ${p} allowed${NC}"
                fi
                pause
                ;;
            6) ufw status verbose; pause ;;
            7)
                if ! grep -q "bbr" /etc/sysctl.conf 2>/dev/null; then
                    echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
                    echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
                    sysctl -p
                    echo -e "${GREEN}BBR enabled${NC}"
                else
                    echo "BBR already configured"
                    sysctl net.ipv4.tcp_congestion_control
                fi
                pause
                ;;
            8)
                apt install -y fail2ban >/dev/null 2>&1
                systemctl enable fail2ban
                systemctl start fail2ban
                echo -e "${GREEN}Fail2Ban installed and started${NC}"
                pause
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Tools ────────────────────────────────────────────────────
tools_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Tools${NC}"
        print_line
        echo "  1) Speedtest"
        echo "  2) Check disk usage"
        echo "  3) Check memory"
        echo "  4) Show listening ports"
        echo "  5) Restart Docker"
        echo "  6) Clean Docker (unused)"
        echo "  7) Update Geo files (Xray assets)"
        echo "  8) System info"
        echo "  0) Back"
        print_line
        read -rp "Select option: " opt
        case $opt in
            1)
                if ! command -v speedtest-cli &>/dev/null && ! command -v speedtest &>/dev/null; then
                    apt install -y speedtest-cli 2>/dev/null || true
                fi
                speedtest-cli --simple 2>/dev/null || speedtest 2>/dev/null || echo "speedtest not available"
                pause
                ;;
            2) df -h; pause ;;
            3) free -h; pause ;;
            4) ss -tlnp; pause ;;
            5) systemctl restart docker; echo -e "${GREEN}Docker restarted${NC}"; pause ;;
            6) docker system prune -f; echo -e "${GREEN}Docker cleaned${NC}"; pause ;;
            7)
                echo -e "${CYAN}Updating Xray geo files...${NC}"
                mkdir -p /usr/local/share/xray
                curl -fsSL -o /usr/local/share/xray/geoip.dat \
                    https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat 2>/dev/null && \
                curl -fsSL -o /usr/local/share/xray/geosite.dat \
                    https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat 2>/dev/null && \
                echo -e "${GREEN}Geo files updated${NC}" || echo -e "${RED}Failed to download geo files${NC}"
                pause
                ;;
            8)
                echo -e "${CYAN}Hostname:${NC} $(hostname)"
                echo -e "${CYAN}OS:${NC} $(grep PRETTY /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"')"
                echo -e "${CYAN}Kernel:${NC} $(uname -r)"
                echo -e "${CYAN}Uptime:${NC} $(uptime -p 2>/dev/null || uptime)"
                echo -e "${CYAN}CPU:${NC} $(nproc) cores"
                free -h | grep Mem
                df -h / | tail -1
                pause
                ;;
            0) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Quick Status ─────────────────────────────────────────────
quick_status() {
    print_header
    echo -e "${BOLD}  Quick Status${NC}"
    print_line
    if check_pasarguard; then
        pasarguard status
    else
        echo -e "${YELLOW}PasarGuard is not installed${NC}"
    fi
    echo
    echo -e "${CYAN}Disk:${NC}"
    df -h / | tail -1
    echo
    echo -e "${CYAN}Memory:${NC}"
    free -h | grep Mem
    echo
    echo -e "${CYAN}Panel port:${NC}"
    grep -E "^UVICORN_PORT" "$ENV_FILE" 2>/dev/null || echo "default 8000"
    pause
}

# ── Main Menu ────────────────────────────────────────────────
main_menu() {
    while true; do
        print_header
        echo -e "${BOLD}  Main Menu${NC}"
        print_line
        echo -e "  ${GREEN}1)${NC}  Service Management"
        echo -e "  ${GREEN}2)${NC}  Install / Update / Uninstall"
        echo -e "  ${GREEN}3)${NC}  SSL & Domain Management"
        echo -e "  ${GREEN}4)${NC}  Backup & Restore"
        echo -e "  ${GREEN}5)${NC}  Migrate to New Server"
        echo -e "  ${GREEN}6)${NC}  Panel Settings"
        echo -e "  ${GREEN}7)${NC}  Node Management"
        echo -e "  ${GREEN}8)${NC}  Firewall & Security"
        echo -e "  ${GREEN}9)${NC}  Tools"
        echo -e "  ${GREEN}10)${NC} Quick Status"
        echo -e "  ${RED}0)${NC}  Exit"
        print_line
        read -rp "Select option: " choice
        case $choice in
            1) service_menu ;;
            2) install_menu ;;
            3) ssl_menu ;;
            4) backup_menu ;;
            5) migrate_menu ;;
            6) settings_menu ;;
            7) node_menu ;;
            8) firewall_menu ;;
            9) tools_menu ;;
            10) quick_status ;;
            0) echo -e "${GREEN}Goodbye!${NC}"; exit 0 ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# ── Entry Point ──────────────────────────────────────────────
check_root
main_menu
