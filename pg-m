        else
          db_sql "ALTER USER CURRENT_USER() IDENTIFIED BY '${npw}';" >/dev/null
        fi
        if [[ $? -eq 0 ]]; then
          for f in "$ENV_FILE" "$COMPOSE_FILE"; do
            [[ -f "$f" ]] || continue; c=$(<"$f"); c=${c//"$DB_PASS_RAW"/"$npw"}; printf '%s\n' "$c" > "$f"
          done
          ok "Password changed in DB, .env and compose"; echo "  New password: $npw"
