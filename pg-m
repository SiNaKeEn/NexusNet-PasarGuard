    esac
  done
}

# ═════════════════ Server tools: swap / ssh port / docker logs / optimize ═════════════════
swap_manage(){
  header; echo -e "  ${BOLD}Swap${NC}"; hr
  swapon --show 2>/dev/null | grep -q . && { swapon --show; free -h | grep -i swap; } || echo "  No swap active"
  hr
  ask "New swap size in GB (0 = remove swap)" gb 2
  [[ "$gb" =~ ^[0-9]+$ ]] || { err "Invalid"; return 1; }
  swapoff /swapfile 2>/dev/null; rm -f /swapfile
  if [[ "$gb" == 0 ]]; then sed -i '\|/swapfile|d' /etc/fstab; ok "Swap removed"; return 0; fi
  info "Creating ${gb}G swap..."
  fallocate -l "${gb}G" /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=$((gb*1024)) status=progress
  chmod 600 /swapfile; mkswap /swapfile >/dev/null; swapon /swapfile
  grep -q '/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
  ok "Swap enabled"; free -h | grep -i swap
}
change_ssh_port(){
  local cur np
  cur=$(ssh_port); echo "  Current SSH port: $cur"
  ask "New SSH port" np ""
  [[ "$np" =~ ^[0-9]+$ && $np -ge 1 && $np -le 65535 ]] || { err "Invalid port"; return 1; }
  port_in_use "$np" && { err "Port $np is already in use"; return 1; }
  warn "Keep this session open and test the new port from a SECOND terminal before closing!"
  confirm_yes "Change SSH port ${cur} → ${np}" || return 1
  has_cmd ufw && ufw status 2>/dev/null | grep -q 'Status: active' && ufw allow "${np}/tcp" >/dev/null
  cp -a /etc/ssh/sshd_config /etc/ssh/sshd_config.pgm-bak
  if grep -qE '^[#[:space:]]*Port[[:space:]]' /etc/ssh/sshd_config; then sed -i -E '0,/^[#[:space:]]*Port[[:space:]].*/s//Port '"$np"'/' /etc/ssh/sshd_config
  else echo "Port $np" >> /etc/ssh/sshd_config; fi
  grep -rlE '^[[:space:]]*Port[[:space:]]' /etc/ssh/sshd_config.d 2>/dev/null | while read -r f; do warn "$f also sets Port — edit it if the change does not apply"; done
  if ! sshd -t 2>/tmp/pgm-sshd.err; then err "sshd config invalid — reverting"; cat /tmp/pgm-sshd.err; cp -f /etc/ssh/sshd_config.pgm-bak /etc/ssh/sshd_config; return 1; fi
  if systemctl is-active --quiet ssh.socket 2>/dev/null; then   # Ubuntu 22.10+/24.04 socket activation ignores Port
    systemctl disable --now ssh.socket >/dev/null 2>&1; systemctl enable --now ssh.service >/dev/null 2>&1
  fi
  systemctl restart ssh 2>/dev/null || systemctl restart sshd
  sleep 2
  if port_in_use "$np"; then ok "SSH now listens on $np (old port $cur rule kept in UFW until you remove it)"
  else err "SSH is not listening on $np — restoring old config"; cp -f /etc/ssh/sshd_config.pgm-bak /etc/ssh/sshd_config; systemctl restart ssh 2>/dev/null || systemctl restart sshd; fi
}
docker_log_rotation(){
  local f=/etc/docker/daemon.json
  mkdir -p /etc/docker
  python3 - <<'PY'
import json, os
p = "/etc/docker/daemon.json"
d = json.load(open(p)) if os.path.exists(p) and os.path.getsize(p) else {}
d["log-driver"] = "json-file"
d.setdefault("log-opts", {}).update({"max-size": "20m", "max-file": "3"})
json.dump(d, open(p, "w"), indent=2)
PY
  mkdir -p "$PGM_DIR"; touch "$PGM_DIR/docker-log-rotation"
  ok "daemon.json updated (max 3 × 20MB per container)"
  if confirm "Restart Docker + recreate panel containers now to apply? (short downtime)" y; then
    systemctl restart docker; sleep 5; dc up -d --force-recreate >/dev/null 2>&1; ok "Applied"
  fi
}
optimize_server(){
  header; echo -e "  ${BOLD}One-click server optimize${NC}"; hr
  echo "  Each step asks first. Safe on a fresh VPS."; hr
  if ! swapon --show 2>/dev/null | grep -q . && confirm "Create 2G swap?" y; then
    fallocate -l 2G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
    chmod 600 /swapfile; mkswap /swapfile >/dev/null; swapon /swapfile; grep -q '/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab; ok "Swap on"; fi
  if confirm "Enable BBR?" y; then
    printf 'net.core.default_qdisc=fq\nnet.ipv4.tcp_congestion_control=bbr\n' > /etc/sysctl.d/99-pg-m-bbr.conf; sysctl -p /etc/sysctl.d/99-pg-m-bbr.conf >/dev/null; ok "BBR on"; fi
  confirm "Sync time (NTP)?" y && { timedatectl set-ntp true 2>/dev/null; ok "NTP on"; }
  confirm "Docker log rotation (stop logs eating the disk)?" y && docker_log_rotation
  if confirm "Enable UFW (keeps SSH $(ssh_port), 80, 443, panel port)?" n; then
    apt-get install -y -qq ufw >/dev/null 2>&1; ufw default deny incoming >/dev/null; ufw default allow outgoing >/dev/null
    ufw allow "$(ssh_port)/tcp" >/dev/null; ufw allow 80/tcp >/dev/null; ufw allow 443/tcp >/dev/null; ufw allow "$(get_port)/tcp" >/dev/null; ufw --force enable >/dev/null; ok "UFW on"; fi
  confirm "Install Fail2Ban?" n && { apt-get install -y -qq fail2ban >/dev/null 2>&1; systemctl enable --now fail2ban >/dev/null 2>&1; ok "Fail2Ban on"; }
  ok "Done"
}

# ═════════════════ Monitoring / watchdog ═════════════════
alert_once(){   # alert_once key message  (max once per hour per key)
  mkdir -p "$PGM_DIR/alerts"; local f="$PGM_DIR/alerts/$1"
  [[ -f "$f" && $(( $(date +%s) - $(stat -c %Y "$f") )) -lt 3600 ]] && return 0
  touch "$f"; log "ALERT $1: $2"
  [[ -n "$(conf_get TG_TOKEN)" ]] && tg_send_text "⚠️ $(hostname): $2"
  return 0
}
alert_clear(){ rm -f "$PGM_DIR/alerts/$1"; }
watchdog_job(){
  AUTO=1; [[ -f "$COMPOSE_FILE" ]] || return 0
  exec 8>/var/lock/pg-m-watchdog.lock; flock -n 8 || return 0
  db_detect
  local down=0 code du cert
  panel_running || down=1
  [[ -n "$DB_KIND" && "$DB_KIND" != sqlite ]] && ! db_running && down=1
  if (( down )); then
    alert_once panel_down "Panel/DB container is down — restarting"
    fix_compose_volumes; dc up -d >/dev/null 2>&1; sleep 40
    if panel_running; then alert_clear panel_down; tg_send_text "✅ $(hostname): panel recovered after restart" 2>/dev/null; log "watchdog: recovered"
    else alert_once panel_failed "Panel restart FAILED — manual action needed"; fi
  else
    alert_clear panel_failed
    code=$(curl -sk --max-time 8 -o /dev/null -w '%{http_code}' "$(panel_scheme)://127.0.0.1:$(get_port)/dashboard/" 2>/dev/null)
    if [[ "$code" =~ ^[1-5][0-9][0-9]$ ]]; then alert_clear panel_http; else alert_once panel_http "Panel container is up but HTTP does not answer"; fi
  fi
  du=$(df -P / | awk 'NR==2{gsub("%","",$5); print $5}')
  if (( du >= 90 )); then alert_once disk "Disk usage is ${du}%"; else alert_clear disk; fi
  cert=$(get_env UVICORN_SSL_CERTFILE)
  if [[ -f "$cert" ]] && ! openssl x509 -checkend 864000 -noout -in "$cert" >/dev/null 2>&1; then
    has_cmd certbot && certbot renew -q >/dev/null 2>&1
    openssl x509 -checkend 864000 -noout -in "$cert" >/dev/null 2>&1 || alert_once ssl "SSL certificate expires in < 10 days (auto-renew failed)"
  else alert_clear ssl; fi
}
m_monitor(){
  while true; do
    header
    echo -e "  ${BOLD}16. Monitoring & Alerts (watchdog)${NC}"; hr
    echo "  Status: $([[ -f /etc/cron.d/pg-m-watchdog ]] && echo -e "${GREEN}enabled (every 5 min)${NC}" || echo -e "${YELLOW}disabled${NC}")   Telegram: $([[ -n "$(conf_get TG_TOKEN)" ]] && echo yes || echo no)"
    echo "  Auto: restarts panel/DB if down • alerts on disk ≥90% • SSL <10d (tries renew)"
    hr
    echo "  1. Enable watchdog"; echo "  2. Disable watchdog"; echo "  3. Run a check now"
    echo "  4. Send test alert to Telegram"; echo "  5. Show log (last 30 lines)"; echo "  6. Telegram setup"
    echo "  0. Back"; hr
    read -rp "  Select: " o
    case $o in
      1) echo "*/5 * * * * root $INSTALL_PATH --watchdog >> $LOG_FILE 2>&1" > /etc/cron.d/pg-m-watchdog; chmod 644 /etc/cron.d/pg-m-watchdog; ok "Enabled"; pause ;;
      2) rm -f /etc/cron.d/pg-m-watchdog; ok "Disabled"; pause ;;
      3) ( watchdog_job ) ; doctor; pause ;;
      4) tg_send_text "pg-m test alert from $(hostname)" && ok "Sent" || err "Telegram not configured / failed"; pause ;;
      5) tail -30 "$LOG_FILE" 2>/dev/null || echo "  (empty)"; pause ;;
      6) telegram_setup; pause ;;
      0) break ;;
    esac
  done
}

# ═════════════════ Remove / Uninstall center ═════════════════
chk_panel(){ [[ -f "$COMPOSE_FILE" ]]; }
chk_nodes(){ [[ -n "$(node_list)" ]]; }
chk_ssl(){ ls /etc/letsencrypt/live/*/fullchain.pem >/dev/null 2>&1 || [[ -f /etc/letsencrypt/renewal-hooks/deploy/pg-m-copy.sh ]]; }
chk_tg(){ [[ -f /etc/cron.d/pg-m-backup || -n "$(conf_get TG_TOKEN)" ]]; }
chk_wd(){ [[ -f /etc/cron.d/pg-m-watchdog ]]; }
chk_swap(){ swapon --show 2>/dev/null | grep -q .; }
chk_bbr(){ [[ -f /etc/sysctl.d/99-pg-m-bbr.conf ]] || [[ "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)" == bbr ]]; }
chk_f2b(){ dpkg -s fail2ban >/dev/null 2>&1; }
chk_ufw(){ ufw status 2>/dev/null | grep -q 'Status: active'; }
chk_cf(){ cf_have; }
chk_relay(){ ls /root/sub-relay-*.conf >/dev/null 2>&1; }
chk_logrot(){ [[ -f "$PGM_DIR/docker-log-rotation" ]]; }
chk_backups(){ ls "$LOCAL_BACKUP_DIR"/pg-m-*.tar.gz >/dev/null 2>&1; }
rm_tag(){ if "$@" >/dev/null 2>&1; then echo -e "${GREEN}[installed]${NC}"; else echo -e "${DIM}[   -   ]${NC}"; fi; }

ssl_delete_cert(){
  local domain="$1"
  certbot revoke --cert-path "/etc/letsencrypt/live/${domain}/fullchain.pem" --non-interactive >/dev/null 2>&1 || true
  certbot delete --cert-name "$domain" --non-interactive >/dev/null 2>&1 || \
    rm -rf "/etc/letsencrypt/live/${domain}" "/etc/letsencrypt/archive/${domain}" "/etc/letsencrypt/renewal/${domain}.conf" 2>/dev/null
  rm -rf "${DATA_DIR}/certs/${domain}" 2>/dev/null
  ok "Removed ${domain}"
}

m_remove(){
  while true; do
    header
    echo -e "  ${BOLD}15. Remove / Uninstall Center${NC}"; hr
    echo -e "  Everything pg-m can install can be removed here."; hr
    printf "   1. PasarGuard panel (+ DB containers)        %b\n" "$(rm_tag chk_panel)"
    printf "   2. Node(s)                                   %b\n" "$(rm_tag chk_nodes)"
    printf "   3. SSL certificates / renewal hook           %b\n" "$(rm_tag chk_ssl)"
    printf "   4. Telegram / scheduled backups              %b\n" "$(rm_tag chk_tg)"
    printf "   5. Watchdog monitoring                       %b\n" "$(rm_tag chk_wd)"
    printf "   6. Swap file                                 %b\n" "$(rm_tag chk_swap)"
    printf "   7. BBR                                       %b\n" "$(rm_tag chk_bbr)"
    printf "   8. Fail2Ban                                  %b\n" "$(rm_tag chk_f2b)"
    printf "   9. UFW firewall (disable / reset)            %b\n" "$(rm_tag chk_ufw)"
    printf "  10. Cloudflare token                          %b\n" "$(rm_tag chk_cf)"
    printf "  11. Sub-relay config files                    %b\n" "$(rm_tag chk_relay)"
    printf "  12. Docker log-rotation setting               %b\n" "$(rm_tag chk_logrot)"
    printf "  13. Old pg-m backups (delete by age / all)    %b\n" "$(rm_tag chk_backups)"
    echo   "  14. pg-m itself"
    echo   "  15. Node-cert weekly job + settings"
    echo   "   0. Back"; hr
    read -rp "  Select: " o
    case $o in
      1) chk_panel || { err "Panel not installed"; pause; continue; }
         info "Safety backup first..."; create_backup full pre-uninstall && ok "Saved: $BACKUP_RESULT"
         if confirm_yes "UNINSTALL the panel"; then
           if has_pg; then pasarguard uninstall
           else dc down -v >/dev/null 2>&1; confirm_yes "Also delete $APP_DIR and $DATA_DIR" && rm -rf "${APP_DIR:?}" "${DATA_DIR:?}"; fi
         fi
         pause ;;
      2) node_pick && confirm_yes "Uninstall node $NODE_DIR (data + certificates deleted)" && node_uninstall "$NODE_DIR"; pause ;;
      3) list_certs; ask "Certificate name to delete (or 'all', Enter = only remove renewal hook)" dm ""
         if [[ "$dm" == all ]]; then confirm_yes "Delete ALL certificates" && for d in /etc/letsencrypt/live/*/; do n=$(basename "$d"); [[ "$n" == README ]] || ssl_delete_cert "$n"; done
         elif [[ -n "$dm" ]]; then confirm_yes "Delete $dm" && ssl_delete_cert "$dm"; fi
         rm -f /etc/letsencrypt/renewal-hooks/deploy/pg-m-copy.sh; ok "Renewal hook removed"
         warn "If .env still points to deleted certs, fix with SSL menu → 4 or clear UVICORN_SSL_* lines"; pause ;;
      4) rm -f /etc/cron.d/pg-m-backup; conf_del TG_TOKEN; conf_del TG_CHAT; conf_del TG_PROXY; conf_del TG_INTERVAL; conf_del TG_MODE; ok "Scheduled + Telegram backups removed"; pause ;;
      5) rm -f /etc/cron.d/pg-m-watchdog; rm -rf "$PGM_DIR/alerts"; ok "Watchdog removed"; pause ;;
      6) confirm_yes "Remove swap" && { swapoff /swapfile 2>/dev/null; rm -f /swapfile; sed -i '\|/swapfile|d' /etc/fstab; ok "Swap removed"; }; pause ;;
      7) confirm_yes "Remove BBR settings" && { rm -f /etc/sysctl.d/99-pg-m-bbr.conf; sed -i '/net.core.default_qdisc=fq/d;/net.ipv4.tcp_congestion_control=bbr/d' /etc/sysctl.conf; sysctl -w net.ipv4.tcp_congestion_control=cubic >/dev/null 2>&1; ok "BBR removed (cubic restored)"; }; pause ;;
      8) confirm_yes "Remove Fail2Ban" && { systemctl disable --now fail2ban >/dev/null 2>&1; apt-get purge -y -qq fail2ban >/dev/null 2>&1; ok "Fail2Ban removed"; }; pause ;;
      9) echo "  1) disable UFW (rules kept)   2) RESET UFW (all rules deleted) + disable"
         read -rp "  Select: " u
         case $u in 1) ufw disable && ok "UFW disabled" ;; 2) confirm_yes "Delete ALL firewall rules" && { ufw --force reset >/dev/null; ufw disable >/dev/null; ok "UFW reset + disabled"; } ;; esac
         pause ;;
      10) conf_del CF_TOKEN; ok "Cloudflare token removed"; pause ;;
      11) rm -f /root/sub-relay-*.conf; ok "Relay configs removed"; pause ;;
      12) python3 - <<'PY'
import json, os
p = "/etc/docker/daemon.json"
if os.path.exists(p):
    d = json.load(open(p)); d.pop("log-opts", None)
    if d.get("log-driver") == "json-file": d.pop("log-driver")
    json.dump(d, open(p, "w"), indent=2)
PY
          rm -f "$PGM_DIR/docker-log-rotation"; ok "Removed from daemon.json (restart Docker to apply)"; pause ;;
      13) echo "  1) delete backups older than N days   2) delete ALL pg-m backups"
          read -rp "  Select: " b
          case $b in
            1) ask "Older than N days" nd 14; [[ "$nd" =~ ^[0-9]+$ ]] && { find "$LOCAL_BACKUP_DIR" -name 'pg-m-*' -mtime +"$nd" -delete; ok "Done"; } ;;
            2) confirm_yes "Delete ALL backups in $LOCAL_BACKUP_DIR" && { rm -f "$LOCAL_BACKUP_DIR"/pg-m-*; ok "Deleted"; } ;;
          esac
          pause ;;
      15) rm -f /etc/cron.d/pg-m-nodecerts; for k in NC_DOMAINS NC_MODE NC_METHOD NC_HOST NC_PORT NC_USER NC_RESTART ARVAN_TOKEN; do conf_del "$k"; done; rm -f "$PGM_DIR/cloudflare.ini" "$PGM_DIR/arvan.ini"; ok "Node-cert job removed"; pause ;;
      14) confirm_yes "Remove pg-m (panel and data are NOT touched)" && {
            rm -f /etc/cron.d/pg-m-backup /etc/cron.d/pg-m-watchdog /etc/letsencrypt/renewal-hooks/deploy/pg-m-copy.sh
            confirm "Also delete pg-m settings (/etc/pg-m: Telegram / Cloudflare tokens)?" n && rm -rf "$PGM_DIR"
            rm -f "$INSTALL_PATH" "$INSTALL_PATH.bak"; ok "pg-m removed. Backups remain in $LOCAL_BACKUP_DIR"; exit 0; }
          pause ;;
      0) break ;;
    esac
  done
}

# ═════════════════ Usage / main / entry ═════════════════
usage(){
cat <<EOF
PasarGuard Manager v${SCRIPT_VERSION}

  pg-m                         interactive menu
  pg-m status | doctor | db    quick status / health check / database overview
  pg-m backup [full|lite]      create a backup in ${LOCAL_BACKUP_DIR}
  pg-m restore [FILE]          restore (no FILE = pick from every backup found)
  pg-m restore-db FILE         restore ONLY the database (pg-m pkg / zip / .sql / .dump / sqlite)
  pg-m --restore-archive FILE [--fresh-node]   non-interactive restore (used by migration)
  pg-m --telegram-backup       backup + send to Telegram (cron job)
  pg-m --watchdog              restart panel if down + alerts (cron job)
  pg-m --node-certs            weekly node-domain cert renew + deliver to master (cron job)
  pg-m update                  update pg-m itself
  pg-m version
EOF
}

DASH=""
dash_stats(){
