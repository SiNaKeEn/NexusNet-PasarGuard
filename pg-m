          [[ $dn -ge 1 && $dn -le ${#_fs[@]} ]] && confirm "Delete $(basename "${_fs[$((dn-1))]}")?" n && { rm -f "${_fs[$((dn-1))]}" "${_fs[$((dn-1))]}.sha256"; ok "Deleted"; }
        fi
