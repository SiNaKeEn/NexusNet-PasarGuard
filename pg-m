          info "Stopping..."; dc down 2>/dev/null || pg_cmd down
          [[ -n "$pgdir" && "$pgdir" != "/" ]] && rm -rf "${pgdir:?}"/* "${pgdir:?}"/.[!.]* 2>/dev/null
          fix_compose_volumes
