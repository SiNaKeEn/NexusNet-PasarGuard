#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
#  PasarGuard Manager (pg-m)  v2.0.0
#  x-ui style management menu for PasarGuard
#  Full backup / restore / one-command server migration
# ═══════════════════════════════════════════════════════════════
set -o pipefail

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'; CYAN=$'\033[0;36m'; NC=$'\033[0m'; BOLD=$'\033[1m'
DIM=$'\033[2m'

SCRIPT_VERSION="2.0.0"
SOURCE_URL="https://raw.githubusercontent.com/SiNaKeEn/NexusNet-PasarGuard/Manager/pg-m"
OFFICIAL_SCRIPT="https://github.com/PasarGuard/scripts/raw/main/pasarguard.sh"
OFFICIAL_NODE_SCRIPT="https://github.com/PasarGuard/scripts/raw/main/pg-node.sh"

APP_DIR="/opt/pasarguard"
DATA_DIR="/var/lib/pasarguard"
ENV_FILE="${APP_DIR}/.env"
BACKUP_DIR="${APP_DIR}/backup"            # official panel backups
COMPOSE_FILE="${APP_DIR}/docker-compose.yml"

PGM_DIR="/etc/pg-m"
PGM_CONF="${PGM_DIR}/pg-m.conf"
LOCAL_BACKUP_DIR="/root/pg-m-backups"     # pg-m full backups / migration packages
LOG_FILE="/var/log/pg-m.log"
INSTALL_PATH="/usr/local/bin/pg-m"

AUTO=0                                    # 1 = non-interactive (cron / remote restore)

# ─── Tiny UI helpers ─────────────────────────────────────────
hr()   { echo -e "${CYAN}  ────────────────────────────────────────────────${NC}"; }
ok()   { echo -e "  ${GREEN}✔ $*${NC}"; }
warn() { echo -e "  ${YELLOW}⚠ $*${NC}"; }
err()  { echo -e "  ${RED}✘ $*${NC}"; }
info() { echo -e "  ${CYAN}→ $*${NC}"; }
log()  { mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null; echo "[$(date '+%F %T')] $*" >>"$LOG_FILE" 2>/dev/null || true; }
pause(){ [[ $AUTO -eq 1 ]] && return 0; echo; read -rp "  Press Enter to continue..." _; }
need_root(){ [[ $EUID -eq 0 ]] || { echo -e "${RED}  Please run as root${NC}"; exit 1; }; }
has_pg(){ command -v pasarguard &>/dev/null; }
has_cmd(){ command -v "$1" &>/dev/null; }

ask(){  # ask "Prompt" VARNAME [default]
  local v d="${3:-}"
  if [[ -n "$d" ]]; then read -rp "  $1 [$d]: " v; v="${v:-$d}"; else read -rp "  $1: " v; fi
  printf -v "$2" '%s' "$v"
}
confirm(){  # confirm "Question" [y|n default]
  local d="${2:-n}" a hint="[y/N]"
  [[ "$d" == y ]] && hint="[Y/n]"
  [[ $AUTO -eq 1 ]] && return 0
  read -rp "  $1 $hint: " a
  a="${a:-$d}"; [[ "$a" =~ ^[Yy] ]]
}
confirm_yes(){  # must type "yes"
  [[ $AUTO -eq 1 ]] && return 0
  local a; read -rp "  $1 (type yes): " a; [[ "$a" == yes ]]
}
run_interruptible(){ trap 'true' INT; "$@"; trap - INT; }
human(){ numfmt --to=iec --suffix=B "${1:-0}" 2>/dev/null || echo "${1:-0}B"; }

# ─── pg-m own config (/etc/pg-m/pg-m.conf, chmod 600) ────────
conf_get(){ [[ -f "$PGM_CONF" ]] && grep -E "^$1=" "$PGM_CONF" 2>/dev/null | tail -1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//'; return 0; }
conf_set(){
  mkdir -p "$PGM_DIR"; touch "$PGM_CONF"; chmod 600 "$PGM_CONF"
  sed -i "/^$1=/d" "$PGM_CONF"; echo "$1=\"$2\"" >> "$PGM_CONF"
}
conf_del(){ [[ -f "$PGM_CONF" ]] && sed -i "/^$1=/d" "$PGM_CONF"; return 0; }

# ─── docker / compose helpers ────────────────────────────────
ensure_docker(){
  if ! has_cmd docker; then
    info "Docker not found — installing (get.docker.com)..."
    has_cmd curl || { apt-get update -qq && apt-get install -y -qq curl ca-certificates >/dev/null 2>&1; }
    curl -fsSL https://get.docker.com | sh >/dev/null 2>&1 || { err "Docker install failed"; return 1; }
  fi
  systemctl enable --now docker >/dev/null 2>&1 || true
  if ! docker compose version &>/dev/null && ! has_cmd docker-compose; then
    apt-get install -y -qq docker-compose-plugin >/dev/null 2>&1 || true
  fi
  docker info &>/dev/null || { err "Docker daemon is not running"; return 1; }
  return 0
}
dc(){
  if docker compose version &>/dev/null; then
    docker compose --project-directory "$APP_DIR" -f "$COMPOSE_FILE" "$@"
  elif has_cmd docker-compose; then
    docker-compose --project-directory "$APP_DIR" -f "$COMPOSE_FILE" "$@"
  else
    return 127
  fi
}
app_svc(){
  local s; s=$(dc config --services 2>/dev/null)
  if grep -qx pasarguard <<<"$s"; then echo pasarguard
  else grep -ivE 'timescale|postgres|mysql|maria|bouncer|admin|^db$' <<<"$s" | head -1; fi
}
db_service(){
  local s svcs; svcs=$(dc config --services 2>/dev/null)
  for s in timescaledb postgresql postgres mysql mariadb db; do
    grep -qx "$s" <<<"$svcs" && { echo "$s"; return; }
  done
  grep -iE 'timescale|postgres|mysql|maria' <<<"$svcs" | grep -ivE 'bouncer|admin' | head -1
}

# Fix wrong PGDATA / volume mount (common after manual migration)
fix_compose_volumes(){
  local compose="${COMPOSE_FILE}"
  [[ -f "$compose" ]] || return 0
  local changed=0
  if grep -qE '/var/lib/postgresql/pasarguard:/var/lib/postgresql["[:space:]]*$' "$compose" 2>/dev/null; then
    sed -i 's|/var/lib/postgresql/pasarguard:/var/lib/postgresql\(["[:space:]]*\)$|/var/lib/postgresql/pasarguard:/var/lib/postgresql/data\1|' "$compose"; changed=1
  fi
  if grep -qE 'PGDATA:[[:space:]]*/var/lib/postgresql[[:space:]]*$' "$compose" 2>/dev/null; then
    sed -i 's|PGDATA:[[:space:]]*/var/lib/postgresql[[:space:]]*$|PGDATA: /var/lib/postgresql/data|' "$compose"; changed=1
  fi
  [[ $changed -eq 1 ]] && ok "Fixed PostgreSQL volume mount in compose"
  return 0
}

port_in_use(){ ss -tlnp 2>/dev/null | grep -qE ":${1}[[:space:]]"; }

pg_restart(){
  fix_compose_volumes
  if has_pg; then
    info "Restarting panel..."
    pasarguard restart 2>/dev/null || pasarguard up 2>/dev/null || dc up -d 2>/dev/null || true
    sleep 2
  fi
}

# ─── .env / panel info ───────────────────────────────────────
get_env(){
  local k="$1"
  [[ -f "$ENV_FILE" ]] || return 0
  grep -E "^${k}=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '\r' \
    | sed -e 's/^["'"'"']//' -e 's/["'"'"']$//' -e 's/[[:space:]]*$//'
}
set_env(){   # set_env KEY VALUE  (in panel .env)
  [[ -f "$ENV_FILE" ]] || return 1
  if grep -q "^$1=" "$ENV_FILE"; then sed -i "s|^$1=.*|$1=$2|" "$ENV_FILE"; else echo "$1=$2" >> "$ENV_FILE"; fi
}

_CACHED_IP=""
get_ip(){   # public IPv4 (cached); falls back to local address
  [[ -n "$_CACHED_IP" ]] && { echo "$_CACHED_IP"; return; }
  local cache=/var/tmp/.pgm_ip
  if [[ -f "$cache" && $(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) )) -lt 600 ]]; then
    _CACHED_IP=$(cat "$cache")
  fi
  if [[ -z "$_CACHED_IP" ]]; then
    _CACHED_IP=$(curl -s4 --max-time 3 api.ipify.org 2>/dev/null || curl -s4 --max-time 3 ifconfig.me 2>/dev/null || true)
    [[ "$_CACHED_IP" =~ ^[0-9.]+$ ]] || _CACHED_IP=""
    [[ -n "$_CACHED_IP" ]] && echo "$_CACHED_IP" > "$cache"
  fi
  [[ -z "$_CACHED_IP" ]] && _CACHED_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
  [[ -z "$_CACHED_IP" ]] && _CACHED_IP="unknown"
  echo "$_CACHED_IP"
}
get_port(){ local p; p=$(get_env UVICORN_PORT); echo "${p:-8000}"; }
ssh_port(){
  local p
  p=$(ss -tlnp 2>/dev/null | awk '/sshd/ {n=split($4,a,":"); print a[n]; exit}')
  [[ -z "$p" ]] && p=$(awk '/^Port[[:space:]]/{print $2; exit}' /etc/ssh/sshd_config 2>/dev/null)
  echo "${p:-22}"
}
get_domain_from_cert(){
  local cert domain; cert=$(get_env UVICORN_SSL_CERTFILE)
  [[ -z "$cert" ]] && return
  if grep -qE 'certs/[^/]+/' <<<"$cert"; then domain=$(sed -n 's|.*/certs/\([^/]*\)/.*|\1|p' <<<"$cert")
  elif grep -q 'letsencrypt/live/' <<<"$cert"; then domain=$(sed -n 's|.*/live/\([^/]*\)/.*|\1|p' <<<"$cert"); fi
  echo "$domain"
}
panel_scheme(){ [[ -n "$(get_env UVICORN_SSL_CERTFILE)" ]] && echo https || echo http; }
panel_url(){
  local ip port scheme domain
  ip=$(get_ip); port=$(get_port); scheme=$(panel_scheme); domain=$(get_domain_from_cert)
  if [[ -n "$domain" && "$scheme" == https ]]; then
    [[ "$port" == 443 ]] && echo "${scheme}://${domain}/dashboard/" || echo "${scheme}://${domain}:${port}/dashboard/"
  else
    if [[ "$port" == 443 && "$scheme" == https ]] || [[ "$port" == 80 && "$scheme" == http ]]; then echo "${scheme}://${ip}/dashboard/"
    else echo "${scheme}://${ip}:${port}/dashboard/"; fi
  fi
}
panel_image(){
  local cid; cid=$(dc ps -q "$(app_svc)" 2>/dev/null | head -1)
  [[ -n "$cid" ]] && docker inspect -f '{{.Config.Image}}' "$cid" 2>/dev/null
}
panel_running(){ docker ps --format '{{.Names}} {{.Status}}' 2>/dev/null | grep -qiE 'pasarguard.*Up'; }
db_running(){ docker ps --format '{{.Names}} {{.Status}}' 2>/dev/null | grep -qiE '(postgres|timescale|mysql|maria).*Up'; }

_svc_status(){
  local st
  panel_running && st="${GREEN}Panel:UP${NC}" || st="${RED}Panel:DOWN${NC}"
  if grep -qE 'sqlite' <<<"$(get_env SQLALCHEMY_DATABASE_URL)"; then st="$st  ${GREEN}DB:SQLite${NC}"
  elif db_running; then st="$st  ${GREEN}DB:UP${NC}"; else st="$st  ${RED}DB:DOWN${NC}"; fi
  echo -e "$st"
}
header(){
  clear
  echo -e "${GREEN}"
  echo "  ╔══════════════════════════════════════════════════╗"
  printf "  ║         PasarGuard Manager  v%-8s            ║\n" "$SCRIPT_VERSION"
  echo "  ╚══════════════════════════════════════════════════╝"
  echo -e "${NC}"
  if has_pg && [[ -f "$ENV_FILE" ]]; then
    echo -e "  $(_svc_status)"
    echo -e "  ${CYAN}$(panel_url)${NC}"
    hr
  fi
}
show_info(){
  local cert domain; cert=$(get_env UVICORN_SSL_CERTFILE); domain=$(get_domain_from_cert)
  echo -e "  ${BOLD}Panel Info${NC}"; hr
  echo -e "  Link : ${GREEN}$(panel_url)${NC}"
  echo -e "  IP   : ${CYAN}$(get_ip)${NC}"
  echo -e "  Port : ${CYAN}$(get_port)${NC}"
  if [[ -n "$cert" && -f "$cert" ]]; then
    echo -e "  SSL  : ${GREEN}ON${NC}"; [[ -n "$domain" ]] && echo -e "  Dom  : ${GREEN}${domain}${NC}"
  elif [[ -n "$cert" ]]; then
    echo -e "  SSL  : ${YELLOW}CONFIGURED (file missing)${NC}"; echo -e "  Path : ${cert}"
  else echo -e "  SSL  : ${YELLOW}OFF${NC}"; fi
  hr
}

# ═════════════════ Database layer (PG / Timescale / MySQL / MariaDB / SQLite) ═════════════════
DB_KIND=""; DB_USER=""; DB_PASS=""; DB_PASS_RAW=""; DB_NAME=""; DB_SVC=""; DB_CID=""; DB_TS=0; SQLITE_FILE=""
urldecode(){ local s="$1"; printf '%b' "${s//%/\\x}"; }

db_detect(){
  DB_KIND=""; DB_USER=""; DB_PASS=""; DB_PASS_RAW=""; DB_NAME=""; DB_SVC=""; DB_CID=""; DB_TS=0; SQLITE_FILE=""
  local url scheme rest creds hostpart
  url=$(get_env SQLALCHEMY_DATABASE_URL)
  if [[ -n "$url" ]]; then
    scheme=${url%%://*}; rest=${url#*://}
    case "$scheme" in
      sqlite*)            DB_KIND=sqlite ;;
      postgres*)          DB_KIND=postgres ;;
      mysql*|mariadb*)    DB_KIND=mysql ;;
    esac
    if [[ "$DB_KIND" == postgres || "$DB_KIND" == mysql ]]; then
      creds=${rest%@*}; hostpart=${rest##*@}
      DB_USER=$(urldecode "${creds%%:*}")
      DB_PASS_RAW="${creds#*:}"; DB_PASS=$(urldecode "$DB_PASS_RAW")
      DB_NAME=${hostpart#*/}; DB_NAME=${DB_NAME%%\?*}; DB_NAME=${DB_NAME%%/*}
    fi
  fi
  if [[ -z "$DB_KIND" ]]; then
    SQLITE_FILE=$(find "$DATA_DIR" -maxdepth 2 \( -name '*.sqlite3' -o -name '*.db' \) 2>/dev/null | head -1)
    [[ -n "$SQLITE_FILE" ]] && DB_KIND=sqlite
  fi
  if [[ "$DB_KIND" == sqlite && -z "$SQLITE_FILE" ]]; then
    SQLITE_FILE=$(find "$DATA_DIR" -maxdepth 2 \( -name '*.sqlite3' -o -name '*.db' \) 2>/dev/null | head -1)
  fi
  if [[ "$DB_KIND" == postgres || "$DB_KIND" == mysql ]]; then
    DB_SVC=$(db_service)
    [[ -n "$DB_SVC" ]] && DB_CID=$(dc ps -q "$DB_SVC" 2>/dev/null | head -1)
    if [[ -z "$DB_CID" ]]; then
      DB_CID=$(docker ps -q --filter name=timescale --filter name=postgres --filter name=mysql --filter name=maria 2>/dev/null | head -1)
    fi
    grep -qi timescale "$COMPOSE_FILE" 2>/dev/null && DB_TS=1
  fi
}
db_label(){
  case "$DB_KIND" in
    postgres) [[ $DB_TS -eq 1 ]] && echo "TimescaleDB (PostgreSQL)" || echo "PostgreSQL" ;;
    mysql)    echo "MySQL / MariaDB" ;;
    sqlite)   echo "SQLite" ;;
    *)        echo "unknown" ;;
  esac
}
sqlite_q(){  # sqlite_q file sql
  if has_cmd sqlite3; then sqlite3 -separator $'\t' "$1" "$2"
  elif has_cmd python3; then
    python3 - "$1" "$2" <<'PY'
import sys, sqlite3
c = sqlite3.connect(sys.argv[1])
for r in c.execute(sys.argv[2]):
    print("\t".join("" if x is None else str(x) for x in r))
PY
  else return 1; fi
}
sqlite_snapshot(){  # sqlite_snapshot src dst  (consistent copy even while panel writes)
  if has_cmd sqlite3; then sqlite3 "$1" ".backup '$2'"
  elif has_cmd python3; then
    python3 - "$1" "$2" <<'PY'
import sys, sqlite3
s = sqlite3.connect(sys.argv[1]); d = sqlite3.connect(sys.argv[2]); s.backup(d); d.close(); s.close()
PY
  else cp -a "$1" "$2"; fi
}
db_sql(){   # db_sql "SQL"  → TSV on stdout, non-zero on error
  case "$DB_KIND" in
    postgres)
      docker exec -i -e PGPASSWORD="$DB_PASS" "$DB_CID" psql -U "$DB_USER" -d "$DB_NAME" -At -F $'\t' -v ON_ERROR_STOP=1 -c "$1" 2>/dev/null ;;
    mysql)
      docker exec -i -e MYSQL_PWD="$DB_PASS" "$DB_CID" sh -c 'B=$(command -v mysql || command -v mariadb); exec "$B" -u"$1" -N -B "$2" -e "$3"' sh "$DB_USER" "$DB_NAME" "$1" 2>/dev/null ;;
    sqlite)
      sqlite_q "$SQLITE_FILE" "$1" 2>/dev/null ;;
    *) return 1 ;;
  esac
}
db_count(){ db_sql "SELECT COUNT(*) FROM $1;" | head -1; }
db_ready(){  # db_ready → 0 when DB answers
  case "$DB_KIND" in
    postgres) docker exec -e PGPASSWORD="$DB_PASS" "$DB_CID" pg_isready -U "$DB_USER" -d postgres &>/dev/null ;;
    mysql)    db_sql "SELECT 1;" &>/dev/null ;;
    sqlite)   return 0 ;;
    *) return 1 ;;
  esac
}
wait_db(){  # wait_db [seconds]
  local t="${1:-120}" i=0
  while (( i < t )); do
    db_detect
    [[ -n "$DB_CID" || "$DB_KIND" == sqlite ]] && db_ready && return 0
    sleep 2; i=$((i+2))
  done
  return 1
}
print_tsv(){
  if has_cmd column; then column -t -s $'\t' | sed 's/^/    /'
  else awk -F'\t' '{for(i=1;i<=NF;i++){c[NR,i]=$i; if(length($i)>w[i])w[i]=length($i)} n=NR; m=(NF>m?NF:m)} END{for(r=1;r<=n;r++){printf "    "; for(i=1;i<=m;i++)printf "%-*s  ", w[i], c[r,i]; printf "\n"}}'; fi
}

# ═════════════════ Database overview (the "show me my DB" screen) ═════════════════
fmt_bytes(){ if [[ "$1" =~ ^[0-9]+$ ]]; then human "$1"; else echo "$1"; fi; }

db_overview(){
  db_detect
  echo -e "  ${BOLD}Database Overview${NC}"; hr
  if [[ -z "$DB_KIND" ]]; then err "No database detected (is the panel installed?)"; return 1; fi
  echo -e "  Type      : ${GREEN}$(db_label)${NC}"
  if [[ "$DB_KIND" != sqlite ]]; then
    if [[ -z "$DB_CID" ]] || ! db_ready; then
      echo -e "  Status    : ${RED}DOWN / not reachable${NC}"
      echo "  Name/User : ${DB_NAME} / ${DB_USER}"
      echo "  (start it with: pasarguard up)"; return 1
    fi
    echo -e "  Status    : ${GREEN}UP${NC}  (container $(docker inspect -f '{{.Name}}' "$DB_CID" 2>/dev/null | tr -d /))"
    echo "  Database  : ${DB_NAME}   User: ${DB_USER}"
  else
    echo "  File      : ${SQLITE_FILE:-not found}"
  fi
  case "$DB_KIND" in
    postgres)
      echo "  Version   : $(db_sql 'SHOW server_version;')"
      echo "  Size      : $(db_sql 'SELECT pg_size_pretty(pg_database_size(current_database()));')"
      echo "  Conns     : $(db_sql 'SELECT count(*) FROM pg_stat_activity WHERE datname=current_database();')"
      [[ $DB_TS -eq 1 ]] && echo "  Timescale : $(db_sql "SELECT extversion FROM pg_extension WHERE extname='timescaledb';")"
      hr; echo -e "  ${BOLD}Tables (exact rows)${NC}"
      { printf 'TABLE\tROWS\tSIZE\n'
        db_sql "SELECT t.table_name, (xpath('/row/c/text()', query_to_xml(format('select count(*) as c from %I.%I', t.table_schema, t.table_name), false, true, '')))[1]::text, pg_size_pretty(pg_total_relation_size(quote_ident(t.table_schema)||'.'||quote_ident(t.table_name))) FROM information_schema.tables t WHERE t.table_schema='public' AND t.table_type='BASE TABLE' ORDER BY pg_total_relation_size(quote_ident(t.table_schema)||'.'||quote_ident(t.table_name)) DESC;"
      } | print_tsv ;;
    mysql)
      echo "  Version   : $(db_sql 'SELECT VERSION();')"
      echo "  Size      : $(db_sql "SELECT CONCAT(ROUND(SUM(data_length+index_length)/1024/1024,2),' MB') FROM information_schema.tables WHERE table_schema=DATABASE();")"
      hr; echo -e "  ${BOLD}Tables (rows ≈ estimate)${NC}"
      { printf 'TABLE\tROWS~\tSIZE_MB\n'
        db_sql "SELECT table_name, table_rows, ROUND((data_length+index_length)/1024/1024,2) FROM information_schema.tables WHERE table_schema=DATABASE() ORDER BY (data_length+index_length) DESC;"
      } | print_tsv ;;
    sqlite)
      echo "  Size      : $(du -h "$SQLITE_FILE" 2>/dev/null | cut -f1)"
      hr; echo -e "  ${BOLD}Tables${NC}"
      { printf 'TABLE\tROWS\n'
        local t
        for t in $(sqlite_q "$SQLITE_FILE" "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';"); do
          printf '%s\t%s\n' "$t" "$(sqlite_q "$SQLITE_FILE" "SELECT COUNT(*) FROM \"$t\";")"
        done
      } | print_tsv ;;
  esac

  # ── Panel summary (guarded: silently skipped if schema differs) ──
  local out
  hr; echo -e "  ${BOLD}Panel Summary${NC}"
  if out=$(db_sql "SELECT COUNT(*), COALESCE(SUM(used_traffic),0) FROM users;"); then
    local total used; total=$(cut -f1 <<<"$out"); used=$(cut -f2 <<<"$out")
    echo -e "  Users total : ${GREEN}${total}${NC}    Traffic used: ${CYAN}$(fmt_bytes "${used%%.*}")${NC}"
    if out=$(db_sql "SELECT status, COUNT(*) FROM users GROUP BY status ORDER BY 2 DESC;"); then
      { printf 'STATUS\tCOUNT\n'; echo "$out"; } | print_tsv
    fi
  else echo "  (users table not readable)"; fi
  if out=$(db_sql "SELECT username FROM admins;"); then
    echo -e "  Admins      : ${CYAN}$(echo "$out" | paste -sd, -)${NC}"
  fi
  if out=$(db_sql "SELECT name, address, port, status FROM nodes;") || out=$(db_sql "SELECT name, address, status FROM nodes;") || out=$(db_sql "SELECT name, status FROM nodes;"); then
    if [[ -n "$out" ]]; then echo -e "  ${BOLD}Nodes${NC}"; { printf 'NAME\tADDRESS/PORT/STATUS\n'; echo "$out"; } | print_tsv; else echo "  Nodes       : none"; fi
  fi
  hr
}

db_show_connection(){
  db_detect
  echo -e "  ${BOLD}Database connection${NC}"; hr
  local url; url=$(get_env SQLALCHEMY_DATABASE_URL)
  echo "  Type : $(db_label)"
  if [[ -z "$url" ]]; then echo "  SQLALCHEMY_DATABASE_URL not set (default SQLite)"; return; fi
  if confirm "Show password in clear text?" n; then echo "  URL  : $url"
  else echo "  URL  : $(sed -E 's|(://[^:]+:)[^@]*@|\1*****@|' <<<"$url")"; fi
  grep -iE '^(DB_|POSTGRES_|MYSQL_|MARIADB_)' "$ENV_FILE" 2>/dev/null | sed -E 's/(PASSWORD=).*/\1*****/I' | sed 's/^/  /'
}

db_shell(){
  db_detect
  case "$DB_KIND" in
    postgres) docker exec -it -e PGPASSWORD="$DB_PASS" "$DB_CID" psql -U "$DB_USER" -d "$DB_NAME" ;;
    mysql)    docker exec -it -e MYSQL_PWD="$DB_PASS" "$DB_CID" sh -c 'B=$(command -v mysql || command -v mariadb); exec "$B" -u"$1" "$2"' sh "$DB_USER" "$DB_NAME" ;;
    sqlite)   has_cmd sqlite3 && sqlite3 "$SQLITE_FILE" || err "sqlite3 not installed (apt install sqlite3)" ;;
    *) err "No database detected" ;;
  esac
}

db_vacuum(){
  db_detect
  case "$DB_KIND" in
    postgres) info "VACUUM (ANALYZE)..."; docker exec -e PGPASSWORD="$DB_PASS" "$DB_CID" psql -U "$DB_USER" -d "$DB_NAME" -c "VACUUM (ANALYZE);" && ok "Done" ;;
    mysql)
      info "OPTIMIZE all tables..."
      local t; for t in $(db_sql "SHOW TABLES;"); do db_sql "OPTIMIZE TABLE \`$t\`;" >/dev/null; done; ok "Done" ;;
    sqlite)
      pasarguard down 2>/dev/null || dc stop "$(app_svc)" 2>/dev/null
      sqlite_q "$SQLITE_FILE" "VACUUM;" && ok "Done"
      pasarguard up 2>/dev/null || dc up -d ;;
    *) err "No database detected" ;;
  esac
}

# Dump DB only → file (any DB type)
db_dump_only(){  # db_dump_only [outfile]
  db_detect
  local out="${1:-}" ts; ts=$(date +%F-%H%M)
  case "$DB_KIND" in
    postgres)
      out="${out:-/root/pg-db-${ts}.dump}"
      docker exec -e PGPASSWORD="$DB_PASS" "$DB_CID" pg_dump -U "$DB_USER" -d "$DB_NAME" -Fc -f /tmp/pgm.dump \
        && docker cp "$DB_CID":/tmp/pgm.dump "$out" && docker exec "$DB_CID" rm -f /tmp/pgm.dump ;;
    mysql)
      out="${out:-/root/pg-db-${ts}.sql}"
      docker exec -e MYSQL_PWD="$DB_PASS" "$DB_CID" sh -c 'D=$(command -v mysqldump || command -v mariadb-dump); exec "$D" -u"$1" --single-transaction --routines --triggers --no-tablespaces "$2"' sh "$DB_USER" "$DB_NAME" > "$out" 2>/dev/null \
      || docker exec -e MYSQL_PWD="$DB_PASS" "$DB_CID" sh -c 'D=$(command -v mysqldump || command -v mariadb-dump); exec "$D" -u"$1" --single-transaction --routines --triggers "$2"' sh "$DB_USER" "$DB_NAME" > "$out" ;;
    sqlite)
      out="${out:-/root/pg-db-${ts}.sqlite3}"; sqlite_snapshot "$SQLITE_FILE" "$out" ;;
    *) err "No database detected"; return 1 ;;
  esac
  if [[ -s "$out" ]]; then chmod 600 "$out"; ok "Saved: $out ($(du -h "$out" | cut -f1))"; else err "Dump failed"; return 1; fi
}

pg_import(){   # pg_import dumpfile  (PostgreSQL / TimescaleDB)
  local f="$1" c="$DB_CID" has_ts=0
  psqlc(){ docker exec -e PGPASSWORD="$DB_PASS" "$c" psql -U "$DB_USER" -v ON_ERROR_STOP=0 "$@"; }
  docker cp "$f" "$c":/tmp/pgm.dump || return 1
  [[ -n "$(psqlc -d postgres -Atc "SELECT 1 FROM pg_extension WHERE extname='timescaledb' UNION SELECT 1 FROM pg_available_extensions WHERE name='timescaledb' LIMIT 1;" 2>/dev/null)" ]] && has_ts=1
  if ! psqlc -d postgres -c "DROP DATABASE IF EXISTS \"$DB_NAME\" WITH (FORCE);" >/dev/null 2>&1; then
    psqlc -d "$DB_NAME" -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public;" >/dev/null 2>&1
  else
    psqlc -d postgres -c "CREATE DATABASE \"$DB_NAME\" OWNER \"$DB_USER\";" >/dev/null 2>&1
  fi
  if [[ $has_ts -eq 1 ]]; then
    psqlc -d "$DB_NAME" -c "CREATE EXTENSION IF NOT EXISTS timescaledb;" >/dev/null 2>&1
    psqlc -d "$DB_NAME" -c "SELECT timescaledb_pre_restore();" >/dev/null 2>&1
  fi
  docker exec -e PGPASSWORD="$DB_PASS" "$c" pg_restore -U "$DB_USER" -d "$DB_NAME" --no-owner --no-privileges /tmp/pgm.dump 2>/tmp/pgm-restore.err
  local rc=$?
  [[ $has_ts -eq 1 ]] && psqlc -d "$DB_NAME" -c "SELECT timescaledb_post_restore();" >/dev/null 2>&1
  docker exec "$c" rm -f /tmp/pgm.dump >/dev/null 2>&1
  # pg_restore reports harmless "already exists" errors for extensions — only real data failure matters (checked by caller via row counts)
  [[ $rc -ne 0 ]] && warn "pg_restore reported $(grep -c 'error' /tmp/pgm-restore.err 2>/dev/null) message(s) — see /tmp/pgm-restore.err"
  return 0
}
mysql_import(){  # mysql_import file.sql
  docker exec -i -e MYSQL_PWD="$DB_PASS" "$DB_CID" sh -c 'B=$(command -v mysql || command -v mariadb); exec "$B" -u"$1" "$2"' sh "$DB_USER" "$DB_NAME" < "$1"
}

# ═════════════════ Backup (full, self-contained, migration-ready) ═════════════════
BACKUP_RESULT=""
create_backup(){   # create_backup full|lite [tag]
  local kind="${1:-full}" tag="${2:-backup}" ts host out stage db_file="" sqlite_name=""
  BACKUP_RESULT=""
  if [[ ! -f "$ENV_FILE" && ! -d "$DATA_DIR" ]]; then err "PasarGuard not found in $APP_DIR"; return 1; fi
  mkdir -p "$LOCAL_BACKUP_DIR"; chmod 700 "$LOCAL_BACKUP_DIR"
  ts=$(date +%Y%m%d-%H%M%S); host=$(hostname -s)
  out="${LOCAL_BACKUP_DIR}/pg-m-${tag}-${host}-${kind}-${ts}.tar.gz"
  stage=$(mktemp -d -p /var/tmp pg-m-stage.XXXXXX) || { err "Cannot create temp dir"; return 1; }
  mkdir -p "$stage/db" "$stage/files" "$stage/misc"

  db_detect
  info "Database: $(db_label)"
  case "$DB_KIND" in
    postgres)
      if [[ -z "$DB_CID" ]] || ! db_ready; then err "Database container is not running (pasarguard up)"; rm -rf "$stage"; return 1; fi
      docker exec -e PGPASSWORD="$DB_PASS" "$DB_CID" pg_dump -U "$DB_USER" -d "$DB_NAME" -Fc -f /tmp/pgm.dump \
        && docker cp "$DB_CID":/tmp/pgm.dump "$stage/db/dump.pgc" >/dev/null \
        && docker exec "$DB_CID" rm -f /tmp/pgm.dump
      if [[ ! -s "$stage/db/dump.pgc" ]]; then err "pg_dump failed"; rm -rf "$stage"; return 1; fi
      db_file="dump.pgc" ;;
    mysql)
      if [[ -z "$DB_CID" ]] || ! db_ready; then err "Database container is not running (pasarguard up)"; rm -rf "$stage"; return 1; fi
      docker exec -e MYSQL_PWD="$DB_PASS" "$DB_CID" sh -c 'D=$(command -v mysqldump || command -v mariadb-dump); exec "$D" -u"$1" --single-transaction --routines --triggers --no-tablespaces "$2"' sh "$DB_USER" "$DB_NAME" > "$stage/db/dump.sql" 2>/dev/null \
      || docker exec -e MYSQL_PWD="$DB_PASS" "$DB_CID" sh -c 'D=$(command -v mysqldump || command -v mariadb-dump); exec "$D" -u"$1" --single-transaction --routines --triggers "$2"' sh "$DB_USER" "$DB_NAME" > "$stage/db/dump.sql" 2>/dev/null
      if [[ ! -s "$stage/db/dump.sql" ]]; then err "mysqldump failed"; rm -rf "$stage"; return 1; fi
      db_file="dump.sql" ;;
    sqlite)
      sqlite_name=$(basename "$SQLITE_FILE")
      sqlite_snapshot "$SQLITE_FILE" "$stage/db/$sqlite_name"
      if [[ ! -s "$stage/db/$sqlite_name" ]]; then err "SQLite snapshot failed"; rm -rf "$stage"; return 1; fi
      db_file="$sqlite_name" ;;
    *) warn "No database detected — backing up files only" ;;
  esac
  [[ -n "$db_file" ]] && ok "Database dumped ($(du -h "$stage/db/$db_file" | cut -f1))"

  # files
  local excl=(--exclude='*.log' --exclude='*.log.*' --exclude='opt/pasarguard/backup')
  [[ "$kind" == lite ]] && excl+=(--exclude='*.dat' --exclude='*.mmdb')
  if [[ "$DB_KIND" == sqlite && -n "$SQLITE_FILE" ]]; then
    excl+=(--exclude="${SQLITE_FILE#/}" --exclude="${SQLITE_FILE#/}-wal" --exclude="${SQLITE_FILE#/}-shm")
  fi
  local paths=() p
  for p in opt/pasarguard var/lib/pasarguard etc/letsencrypt etc/nginx etc/pg-m; do [[ -e "/$p" ]] && paths+=("$p"); done
  if [[ "$kind" == full ]]; then
    for p in /opt/pg-node* /var/lib/pg-node*; do [[ -e "$p" ]] && paths+=("${p#/}"); done
  fi
  info "Collecting files: ${paths[*]}"
  tar -C / "${excl[@]}" -cf - "${paths[@]}" 2>/dev/null | tar -C "$stage/files" -xf -

  # misc (informational / cron)
  crontab -l > "$stage/misc/crontab.txt" 2>/dev/null || true
  cp -a /etc/cron.d/pg-m-* "$stage/misc/" 2>/dev/null || true
  ufw status numbered > "$stage/misc/ufw.txt" 2>/dev/null || true
  docker ps -a --format '{{.Names}}\t{{.Image}}\t{{.Status}}' > "$stage/misc/containers.txt" 2>/dev/null || true

  # manifest
  local domains users admins nodes
  domains=$(collect_domains | paste -sd' ' -)
  users=$(db_count users 2>/dev/null); admins=$(db_count admins 2>/dev/null); nodes=$(db_count nodes 2>/dev/null)
  cat > "$stage/manifest.env" <<EOF
PGM_VERSION="$SCRIPT_VERSION"
CREATED="$(date '+%F %T %z')"
SRC_HOST="$(hostname)"
SRC_IP="$(get_ip)"
KIND="$kind"
TAG="$tag"
DB_KIND="$DB_KIND"
DB_TS="$DB_TS"
DB_NAME="$DB_NAME"
DB_USER="$DB_USER"
DB_FILE="$db_file"
SQLITE_NAME="$sqlite_name"
PANEL_PORT="$(get_port)"
PANEL_SCHEME="$(panel_scheme)"
PANEL_IMAGE="$(panel_image)"
DOMAINS="$domains"
USERS="${users:-}"
ADMINS="${admins:-}"
NODES="${nodes:-}"
EOF

  info "Packing archive..."
  if ! tar -C "$stage" -czf "$out" . ; then err "Packing failed"; rm -rf "$stage" "$out"; return 1; fi
  chmod 600 "$out"
  ( cd "$LOCAL_BACKUP_DIR" && sha256sum "$(basename "$out")" > "$(basename "$out").sha256" )
  rm -rf "$stage"
  BACKUP_RESULT="$out"
  ok "Backup created: $out ($(du -h "$out" | cut -f1))"
  log "backup created $out kind=$kind tag=$tag users=${users:-?}"
  return 0
}

prune_backups(){
  local keep; keep=$(conf_get KEEP_BACKUPS); keep="${keep:-10}"
  local f
  ls -1t "$LOCAL_BACKUP_DIR"/pg-m-backup-*.tar.gz 2>/dev/null | tail -n +$((keep+1)) | while read -r f; do
    rm -f "$f" "$f.sha256"; log "pruned old backup $f"
  done
}
list_backups(){
  echo -e "  ${BOLD}Backups in ${LOCAL_BACKUP_DIR}${NC}"; hr
  local i=0 f
  shopt -s nullglob
  for f in $(ls -1t "$LOCAL_BACKUP_DIR"/pg-m-*.tar.gz 2>/dev/null); do
    i=$((i+1)); printf "  %2d) %-62s %6s  %s\n" "$i" "$(basename "$f")" "$(du -h "$f" | cut -f1)" "$(date -r "$f" '+%F %H:%M')"
  done
  shopt -u nullglob
  [[ $i -eq 0 ]] && echo "  (none)"
  hr
}
pick_backup(){   # sets PICKED to a file path
  PICKED=""
  list_backups
  local files n
  mapfile -t files < <(ls -1t "$LOCAL_BACKUP_DIR"/pg-m-*.tar.gz 2>/dev/null)
  echo "  Enter number from list, or a full path to a .tar.gz file"
  read -rp "  Select: " n
  [[ -z "$n" ]] && return 1
  if [[ "$n" =~ ^[0-9]+$ && $n -ge 1 && $n -le ${#files[@]} ]]; then PICKED="${files[$((n-1))]}"
  elif [[ -f "$n" ]]; then PICKED="$n"
  else err "Not found"; return 1; fi
}

# ═════════════════ Restore (used by menu, CLI and remote migration) ═════════════════
RESTORE_TMP=""
mf(){ grep -E "^$1=" "$RESTORE_TMP/manifest.env" 2>/dev/null | head -1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//'; }

restore_archive(){   # restore_archive file.tar.gz
  local arc="$1" rc=0
  [[ -f "$arc" ]] || { err "File not found: $arc"; return 1; }
  if [[ -f "$arc.sha256" ]]; then
    ( cd "$(dirname "$arc")" && sha256sum -c "$(basename "$arc").sha256" >/dev/null 2>&1 ) && ok "Checksum OK" || { err "Checksum mismatch — archive damaged"; return 1; }
  fi
  RESTORE_TMP=$(mktemp -d -p /var/tmp pg-m-restore.XXXXXX) || return 1
  info "Extracting archive..."
  tar -xzf "$arc" -C "$RESTORE_TMP" || { err "Cannot extract archive"; rm -rf "$RESTORE_TMP"; return 1; }
  [[ -f "$RESTORE_TMP/manifest.env" ]] || { err "manifest.env missing — not a pg-m archive (use 'pasarguard restore' for official backups)"; rm -rf "$RESTORE_TMP"; return 1; }

  echo -e "  ${BOLD}Archive contents${NC}"; hr
  echo "  Created   : $(mf CREATED)   (pg-m $(mf PGM_VERSION))"
  echo "  Source    : $(mf SRC_HOST) / $(mf SRC_IP)"
  echo "  Database  : $(mf DB_KIND) ts=$(mf DB_TS)   users=$(mf USERS) admins=$(mf ADMINS) nodes=$(mf NODES)"
  echo "  Domains   : $(mf DOMAINS)"
  hr
  if [[ $AUTO -ne 1 ]]; then
    warn "This will OVERWRITE the panel configuration and database on THIS server."
    confirm_yes "Continue" || { echo "  Cancelled"; rm -rf "$RESTORE_TMP"; return 1; }
  fi

  ensure_docker || { rm -rf "$RESTORE_TMP"; return 1; }
  has_cmd curl || apt-get install -y -qq curl >/dev/null 2>&1

  # safety snapshot of whatever is here now
  if [[ -f "$COMPOSE_FILE" ]] && docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qi pasarguard; then
    info "Existing panel found — taking a safety snapshot first..."
    ( create_backup full pre-restore ) && ok "Safety snapshot saved in $LOCAL_BACKUP_DIR" || warn "Safety snapshot failed — continuing"
    dc down 2>/dev/null || true
  fi

  info "Restoring files..."
  mkdir -p /opt /var/lib /etc
  tar -C "$RESTORE_TMP/files" -cf - . | tar -C / --no-overwrite-dir -xpf - || { err "File restore failed"; rm -rf "$RESTORE_TMP"; return 1; }
  fix_compose_volumes
  chmod 600 "$ENV_FILE" 2>/dev/null || true
  ok "Files restored"

  local dbk db_file sqlite_name
  db_detect; dbk="$DB_KIND"; db_file=$(mf DB_FILE); sqlite_name=$(mf SQLITE_NAME)

  case "$dbk" in
    sqlite)
      mkdir -p "$DATA_DIR"
      [[ -n "$db_file" && -f "$RESTORE_TMP/db/$db_file" ]] && cp -a "$RESTORE_TMP/db/$db_file" "$DATA_DIR/${sqlite_name:-$db_file}" && ok "SQLite database restored"
      ;;
    postgres|mysql)
      local svc; svc=$(db_service)
      [[ -z "$svc" ]] && { err "Cannot find DB service in compose file"; rm -rf "$RESTORE_TMP"; return 1; }
      info "Starting database service ($svc)..."
      dc pull -q "$svc" >/dev/null 2>&1 || true
      dc up -d "$svc" || { err "Cannot start $svc"; rm -rf "$RESTORE_TMP"; return 1; }
      info "Waiting for database to accept connections..."
      if ! wait_db 240; then err "Database did not become ready (see: docker logs <db-container>)"; rm -rf "$RESTORE_TMP"; return 1; fi
      info "Importing database..."
      if [[ -n "$db_file" && -f "$RESTORE_TMP/db/$db_file" ]]; then
        if [[ "$dbk" == postgres ]]; then pg_import "$RESTORE_TMP/db/$db_file"; else mysql_import "$RESTORE_TMP/db/$db_file"; fi
        ok "Database import finished"
      else warn "No database dump in archive"; fi
      ;;
  esac

  info "Starting full stack..."
  dc pull -q >/dev/null 2>&1 || true
  dc up -d || { err "docker compose up failed"; rc=1; }

  # install panel CLI + pg-m itself (best effort)
  if ! has_pg; then
    info "Installing official 'pasarguard' CLI..."
    bash -c "$(curl -fsSL "$OFFICIAL_SCRIPT")" @ install-script >/dev/null 2>&1 || warn "Could not install CLI (not critical — compose is used directly)"
  fi
  self_install

  # restore cron jobs of pg-m (Telegram backup etc.)
  local cf; for cf in "$RESTORE_TMP"/misc/pg-m-*; do [[ -f "$cf" ]] && { cp -a "$cf" /etc/cron.d/; chmod 644 "/etc/cron.d/$(basename "$cf")"; }; done

  # certbot + renewal hook (certs are already copied)
  if [[ -d /etc/letsencrypt/renewal ]]; then
    has_cmd certbot || apt-get install -y -qq certbot >/dev/null 2>&1 || true
    install_cert_hook
  fi

  # firewall
  if has_cmd ufw && ufw status 2>/dev/null | grep -q 'Status: active'; then
    ufw allow "$(ssh_port)/tcp" >/dev/null 2>&1; ufw allow "$(get_port)/tcp" >/dev/null 2>&1
    ufw allow 80/tcp >/dev/null 2>&1; ufw allow 443/tcp >/dev/null 2>&1
    ok "UFW: opened SSH, 80, 443 and panel port"
  fi

  # verify
  info "Waiting for panel to answer..."
  local up=0 i code
  for i in $(seq 1 45); do
    code=$(curl -sk --max-time 3 -o /dev/null -w '%{http_code}' "$(panel_scheme)://127.0.0.1:$(get_port)/dashboard/" 2>/dev/null)
    [[ "$code" =~ ^[1-5][0-9][0-9]$ ]] && { up=1; break; }
    sleep 2
  done
  [[ $up -eq 1 ]] && ok "Panel is answering (HTTP $code)" || { err "Panel is not answering yet — check: pasarguard logs"; rc=1; }

  db_detect
  local u a n ou oa on
  u=$(db_count users 2>/dev/null); a=$(db_count admins 2>/dev/null); n=$(db_count nodes 2>/dev/null)
  ou=$(mf USERS); oa=$(mf ADMINS); on=$(mf NODES)
  echo -e "  ${BOLD}Verification (source → this server)${NC}"
  printf "    users  : %s → %s  %s\n" "${ou:--}" "${u:--}" "$([[ -n "$ou" && "$ou" == "$u" ]] && echo '✔' || echo '✘ MISMATCH')"
  printf "    admins : %s → %s  %s\n" "${oa:--}" "${a:--}" "$([[ -n "$oa" && "$oa" == "$a" ]] && echo '✔' || echo '✘ MISMATCH')"
  printf "    nodes  : %s → %s  %s\n" "${on:--}" "${n:--}" "$([[ -n "$on" && "$on" == "$n" ]] && echo '✔' || echo '✘ MISMATCH')"
  if [[ -n "$ou" && "$ou" != "$u" ]]; then err "User count differs — restore may be incomplete"; rc=1; fi
  log "restore from $arc rc=$rc"
  rm -rf "$RESTORE_TMP"
  return $rc
}

self_install(){   # make sure /usr/local/bin/pg-m exists and is this script
  local me; me=$(readlink -f "$0" 2>/dev/null)
  if [[ -n "$me" && -f "$me" && "$me" != "$INSTALL_PATH" ]]; then
    cp -f "$me" "$INSTALL_PATH" && chmod +x "$INSTALL_PATH"
  fi
}

# ═════════════════ Telegram ═════════════════
tg_curl(){ local a=(-s --max-time 180); local px; px=$(conf_get TG_PROXY); [[ -n "$px" ]] && a+=(-x "$px"); curl "${a[@]}" "$@"; }
tg_send_text(){ tg_curl "https://api.telegram.org/bot$(conf_get TG_TOKEN)/sendMessage" -d chat_id="$(conf_get TG_CHAT)" --data-urlencode text="$1" | grep -q '"ok":true'; }
tg_send_file(){  # tg_send_file path caption
  local f="$1" cap="$2" token chat sz
  token=$(conf_get TG_TOKEN); chat=$(conf_get TG_CHAT)
  [[ -n "$token" && -n "$chat" ]] || { err "Telegram not configured"; return 1; }
  sz=$(stat -c %s "$f")
  if (( sz > 49000000 )); then
    warn "File is $(human "$sz") (> 50MB Telegram limit) — sending in parts"
    local d; d=$(mktemp -d -p /var/tmp pgm-split.XXXXXX)
    split -b 45M -d "$f" "$d/$(basename "$f").part"
    local p n=0 total; total=$(ls "$d" | wc -l)
    for p in "$d"/*; do
      n=$((n+1))
      tg_curl -F chat_id="$chat" -F document=@"$p" -F caption="$cap (part $n/$total — join: cat *.part* > file.tar.gz)" \
        "https://api.telegram.org/bot${token}/sendDocument" | grep -q '"ok":true' || { err "Part $n failed"; rm -rf "$d"; return 1; }
    done
    rm -rf "$d"; return 0
  fi
  tg_curl -F chat_id="$chat" -F document=@"$f" -F caption="$cap" "https://api.telegram.org/bot${token}/sendDocument" | grep -q '"ok":true'
}
telegram_backup_job(){   # called by cron
  AUTO=1
  exec 9>/var/lock/pg-m-backup.lock; flock -n 9 || { echo "another backup running"; return 1; }
  local mode; mode=$(conf_get TG_MODE); mode="${mode:-lite}"
  create_backup "$mode" backup || { tg_send_text "❌ pg-m backup FAILED on $(hostname)"; return 1; }
  prune_backups
  if [[ -n "$(conf_get TG_TOKEN)" ]]; then
    tg_send_file "$BACKUP_RESULT" "✅ $(hostname) | $(date '+%F %H:%M') | pg-m $SCRIPT_VERSION | $mode" \
      && log "telegram backup sent" || { log "telegram send failed"; return 1; }
  fi
}
telegram_setup(){
  header; echo -e "  ${BOLD}Telegram Auto-Backup${NC}"; hr
  local tok chat
  echo "  Current: token=$([[ -n "$(conf_get TG_TOKEN)" ]] && echo set || echo none)  chat=$(conf_get TG_CHAT)  every=$(conf_get TG_INTERVAL)h  mode=$(conf_get TG_MODE)"
  echo "  1. Configure / change"
  echo "  2. Send test message"
  echo "  3. Send a backup now"
  echo "  4. Disable auto-backup"
  echo "  0. Back"; hr
  read -rp "  Select: " o
  case $o in
    1)
      echo "  Create a bot with @BotFather → token. Get your chat id from @userinfobot"
      ask "Bot token" tok; ask "Chat ID" chat
      [[ -z "$tok" || -z "$chat" ]] && { err "Both required"; return; }
      conf_set TG_TOKEN "$tok"; conf_set TG_CHAT "$chat"
      echo "  Optional proxy for Telegram (e.g. socks5h://127.0.0.1:1080) — empty for none"
      ask "Proxy" px ""; [[ -n "$px" ]] && conf_set TG_PROXY "$px" || conf_del TG_PROXY
      echo "  Interval (hours): 1 3 6 12 24"; ask "Every N hours" iv 6
      [[ "$iv" =~ ^[0-9]+$ && $iv -ge 1 && $iv -le 24 ]] || iv=6
      echo "  Mode: lite = DB+config (small, for Telegram)   full = everything incl. geo files/nodes"
      ask "Mode (lite/full)" md lite; [[ "$md" == full ]] || md=lite
      ask "Keep how many local backups" kp 10; [[ "$kp" =~ ^[0-9]+$ ]] || kp=10
      conf_set TG_INTERVAL "$iv"; conf_set TG_MODE "$md"; conf_set KEEP_BACKUPS "$kp"
      echo "0 */${iv} * * * root $INSTALL_PATH --telegram-backup >> $LOG_FILE 2>&1" > /etc/cron.d/pg-m-backup
      [[ "$iv" == 24 ]] && echo "0 3 * * * root $INSTALL_PATH --telegram-backup >> $LOG_FILE 2>&1" > /etc/cron.d/pg-m-backup
      chmod 644 /etc/cron.d/pg-m-backup
      if tg_send_text "✅ pg-m backup linked on $(hostname)"; then ok "Test message delivered — auto-backup every ${iv}h enabled"
      else err "Telegram test failed — check token / chat id / proxy"; fi ;;
    2) tg_send_text "pg-m test from $(hostname)" && ok "Sent" || err "Failed" ;;
    3) telegram_backup_job && ok "Backup sent" || err "Failed" ;;
    4) rm -f /etc/cron.d/pg-m-backup; ok "Auto-backup disabled" ;;
  esac
}

# ═════════════════ Domains / DNS / Cloudflare ═════════════════
collect_domains(){
  local d n
  {
    for d in /etc/letsencrypt/live/*/; do
      n=$(basename "$d"); [[ "$n" == README || ! -f "${d}fullchain.pem" ]] && continue
      echo "$n"
      openssl x509 -in "${d}fullchain.pem" -noout -text 2>/dev/null | grep -oE 'DNS:[^, ]+' | sed 's/^DNS://'
    done
    for d in "$DATA_DIR"/certs/*/; do [[ -d "$d" ]] && basename "$d"; done
  } 2>/dev/null | grep -E '^[A-Za-z0-9.-]+\.[A-Za-z]{2,}$' | sort -u
}
dns_resolve(){ getent ahostsv4 "$1" 2>/dev/null | awk 'NR==1{print $1}'; }

dns_report(){   # dns_report [target_ip]  → table of domains vs IP
  local target="${1:-$(get_ip)}" d ip st doms
  doms=$(collect_domains)
  [[ -z "$doms" ]] && { echo "  (no domains found in certificates)"; return 1; }
  echo -e "  Target IP: ${CYAN}${target}${NC}"
  while read -r d; do
    ip=$(dns_resolve "$d")
    if [[ -z "$ip" ]]; then st="${RED}no A record${NC}"
    elif [[ "$ip" == "$target" ]]; then st="${GREEN}OK → points here${NC}"
    else st="${YELLOW}points to ${ip}${NC}"; fi
    printf "  %-40s %b\n" "$d" "$st"
  done <<<"$doms"
}

cf_have(){ [[ -n "$(conf_get CF_TOKEN)" ]]; }
cf_api(){   # cf_api METHOD /path [json]
  curl -s --max-time 25 -X "$1" "https://api.cloudflare.com/client/v4$2" \
    -H "Authorization: Bearer $(conf_get CF_TOKEN)" -H "Content-Type: application/json" ${3:+--data "$3"}
}
cf_zone_id(){
  local d="$1" L n i cand id
  IFS=. read -ra L <<<"$d"; n=${#L[@]}
  for ((i=0; i<n-1; i++)); do
    cand=$(IFS=.; echo "${L[*]:i}")
    id=$(cf_api GET "/zones?name=${cand}" | jq -r '.result[0].id // empty' 2>/dev/null)
    [[ -n "$id" ]] && { echo "$id"; return 0; }
  done
  return 1
}
cf_set_a(){   # cf_set_a domain ip
  local d="$1" ip="$2" z rec res
  has_cmd jq || apt-get install -y -qq jq >/dev/null 2>&1
  z=$(cf_zone_id "$d") || { err "$d: zone not found in this Cloudflare account"; return 1; }
  rec=$(cf_api GET "/zones/${z}/dns_records?type=A&name=${d}" | jq -r '.result[0].id // empty')
  if [[ -n "$rec" ]]; then
    res=$(cf_api PATCH "/zones/${z}/dns_records/${rec}" "$(jq -nc --arg c "$ip" '{content:$c}')")
  else
    res=$(cf_api POST "/zones/${z}/dns_records" "$(jq -nc --arg n "$d" --arg c "$ip" '{type:"A",name:$n,content:$c,ttl:1,proxied:false}')")
  fi
  if [[ "$(jq -r '.success' <<<"$res" 2>/dev/null)" == true ]]; then ok "$d → $ip"; return 0
  else err "$d: $(jq -r '.errors[0].message // "unknown error"' <<<"$res" 2>/dev/null)"; return 1; fi
}
cf_point_domains(){   # cf_point_domains ip
  local ip="$1" d
  has_cmd jq || apt-get install -y -qq jq >/dev/null 2>&1
  for d in $(collect_domains); do cf_set_a "$d" "$ip"; done
}

m_domains(){
  while true; do
    header
    echo -e "  ${BOLD}13. Domains & DNS${NC}"; hr
    echo "  1. Show domains + DNS status (vs this server)"
    echo "  2. Check one domain"
    echo "  3. Set / change Cloudflare API token"
    echo "  4. Point ALL panel domains to an IP (Cloudflare)"
    echo "  5. Point ONE domain to an IP (Cloudflare)"
    echo "  6. Remove Cloudflare token"
    echo "  0. Back"; hr
    read -rp "  Select: " o
    case $o in
      1) dns_report; pause ;;
      2) ask "Domain" d ""; [[ -n "$d" ]] && { echo "  $d → $(dns_resolve "$d" || echo none)   (this server: $(get_ip))"; }; pause ;;
      3) echo "  Token needs: Zone → DNS → Edit  (+ Zone → Zone → Read)"
         read -rsp "  API token: " t; echo; [[ -n "$t" ]] && { conf_set CF_TOKEN "$t"; ok "Saved (chmod 600 in $PGM_CONF)"; }; pause ;;
      4) cf_have || { err "Set a Cloudflare token first (option 3)"; pause; continue; }
         ask "Target IP" ip "$(get_ip)"; confirm "Update A records for: $(collect_domains | paste -sd' ' -) ?" y && cf_point_domains "$ip"; pause ;;
      5) cf_have || { err "Set a Cloudflare token first (option 3)"; pause; continue; }
         ask "Domain" d ""; ask "Target IP" ip "$(get_ip)"; [[ -n "$d" ]] && cf_set_a "$d" "$ip"; pause ;;
      6) conf_del CF_TOKEN; ok "Removed"; pause ;;
      0) break ;;
    esac
  done
}

# ═════════════════ SSL ═════════════════
# Panel container ONLY sees files under DATA_DIR (/var/lib/pasarguard).
# Never point UVICORN_SSL_* at /etc/letsencrypt directly.
free_port_80(){
  port_in_use 80 || { ok "Port 80 is free"; return 0; }
  warn "Port 80 is busy:"; ss -tlnp | grep ':80 '
  local s; for s in nginx apache2 caddy; do systemctl is-active --quiet "$s" 2>/dev/null && { info "Stopping $s"; systemctl stop "$s"; }; done
  if port_in_use 80 && [[ "$(get_port)" == 80 ]]; then info "Panel uses port 80 — stopping panel temporarily"; has_pg && pasarguard down 2>/dev/null; fi
  sleep 1
  if port_in_use 80; then err "Port 80 still busy — free it manually, then retry"; return 1; fi
  ok "Port 80 is free"; return 0
}
list_certs(){
  echo -e "  ${BOLD}Certificates${NC}"; hr
  [[ -d /etc/letsencrypt/live ]] || { echo "  (none)"; return; }
  local d name exp status
  for d in /etc/letsencrypt/live/*/; do
    [[ -d "$d" ]] || continue; name=$(basename "$d"); [[ "$name" == README || ! -f "${d}fullchain.pem" ]] && continue
    exp=$(openssl x509 -enddate -noout -in "${d}fullchain.pem" 2>/dev/null | cut -d= -f2)
    if ! openssl x509 -checkend 0 -noout -in "${d}fullchain.pem" >/dev/null 2>&1; then status="${RED}EXPIRED${NC}"
    elif ! openssl x509 -checkend 2592000 -noout -in "${d}fullchain.pem" >/dev/null 2>&1; then status="${YELLOW}Expires <30d${NC}"
    else status="${GREEN}Active${NC}"; fi
    echo -e "  • ${CYAN}${name}${NC}  [${status}]"
    echo "    Expiry : ${exp}"
    echo "    SANs   : $(openssl x509 -in "${d}fullchain.pem" -noout -text 2>/dev/null | grep -oE 'DNS:[^, ]+' | sed 's/DNS://' | paste -sd' ' -)"
    echo "    Path   : ${d}fullchain.pem"
  done
  hr
}
copy_cert_to_panel(){
  local domain="$1" src="" d
  if [[ -f "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then src="/etc/letsencrypt/live/${domain}"
  else
    for d in /etc/letsencrypt/live/*/; do
      [[ -f "${d}fullchain.pem" ]] || continue
      if openssl x509 -in "${d}fullchain.pem" -noout -text 2>/dev/null | grep -q "DNS:${domain}"; then src="${d%/}"; break; fi
    done
  fi
  [[ -n "$src" && -f "${src}/fullchain.pem" ]] || { err "No LE cert covering ${domain}"; return 1; }
  local dst="${DATA_DIR}/certs/${domain}"
  mkdir -p "$dst"
  cp -L "${src}/fullchain.pem" "${dst}/fullchain.pem"; cp -L "${src}/privkey.pem" "${dst}/privkey.pem"
  chmod 644 "${dst}/fullchain.pem"; chmod 600 "${dst}/privkey.pem"
  ok "Copied → ${dst} (from ${src})"
}
apply_cert_env(){
  local domain="$1" dst="${DATA_DIR}/certs/${domain}"
  [[ -f "${dst}/fullchain.pem" && -f "${dst}/privkey.pem" ]] || { err "Missing files in ${dst}"; return 1; }
  [[ -f "$ENV_FILE" ]] || { err "No .env"; return 1; }
  local cp; cp=$(get_port)
  sed -i '/^UVICORN_SSL_CERTFILE=/d;/^UVICORN_SSL_KEYFILE=/d;/^UVICORN_SSL_CA_TYPE=/d;/^#UVICORN_SSL_CERTFILE=/d;/^#UVICORN_SSL_KEYFILE=/d' "$ENV_FILE"
  { echo "UVICORN_SSL_CERTFILE=${dst}/fullchain.pem"; echo "UVICORN_SSL_KEYFILE=${dst}/privkey.pem"; } >> "$ENV_FILE"
  grep -q '^UVICORN_PORT=' "$ENV_FILE" || echo "UVICORN_PORT=${cp}" >> "$ENV_FILE"
  ufw allow "${cp}/tcp" >/dev/null 2>&1 || true
  ok ".env → SSL paths set (port kept: ${cp})"
}
cert_covers_domain(){ [[ -f "$1" ]] && openssl x509 -in "$1" -noout -text 2>/dev/null | grep -qE "DNS:${2}(,|$| )"; }

# After every certbot renewal: copy certs into panel dir + restart panel
install_cert_hook(){
  mkdir -p /etc/letsencrypt/renewal-hooks/deploy
  cat > /etc/letsencrypt/renewal-hooks/deploy/pg-m-copy.sh <<'HOOK'
#!/bin/bash
# installed by pg-m — copies renewed certs where the panel container can read them
for d in /etc/letsencrypt/live/*/; do
  n=$(basename "$d"); [[ "$n" == README ]] && continue
  [[ -f "${d}fullchain.pem" ]] || continue
  mkdir -p "/var/lib/pasarguard/certs/$n"
  cp -L "${d}fullchain.pem" "${d}privkey.pem" "/var/lib/pasarguard/certs/$n/"
  chmod 644 "/var/lib/pasarguard/certs/$n/fullchain.pem"; chmod 600 "/var/lib/pasarguard/certs/$n/privkey.pem"
done
if command -v pasarguard >/dev/null; then pasarguard restart >/dev/null 2>&1
else docker compose --project-directory /opt/pasarguard -f /opt/pasarguard/docker-compose.yml restart >/dev/null 2>&1; fi
HOOK
  chmod +x /etc/letsencrypt/renewal-hooks/deploy/pg-m-copy.sh
  ok "Renewal hook installed (certs auto-copied + panel restarted after renew)"
}

ssl_health(){
  echo -e "  ${BOLD}SSL Health Check${NC}"; hr
  local cert key port; cert=$(get_env UVICORN_SSL_CERTFILE); key=$(get_env UVICORN_SSL_KEYFILE); port=$(get_port)
  echo "  CERTFILE = ${cert:-<empty>}"; echo "  KEYFILE  = ${key:-<empty>}"; echo "  PORT     = ${port}"
  if [[ -z "$cert" || -z "$key" ]]; then err "SSL not set in .env"
  elif [[ "$cert" == /etc/letsencrypt/* ]]; then err "BAD: .env points to /etc/letsencrypt (container cannot read it) → use option 4"
  elif [[ -f "$cert" && -f "$key" ]]; then
    ok "Files exist on host"
    echo -n "  Expiry: "; openssl x509 -in "$cert" -noout -enddate 2>/dev/null | cut -d= -f2
    echo "  SANs: $(openssl x509 -in "$cert" -noout -text 2>/dev/null | grep -oE 'DNS:[^, ]+' | sed 's/DNS://' | paste -sd' ' -)"
  else err "Cert/key path missing on host"; fi
  hr; echo -e "  ${CYAN}[Let's Encrypt live]${NC}"; list_certs
  echo -e "  ${CYAN}[Local HTTPS test]${NC}"
  echo -n "  https://127.0.0.1:${port}/dashboard/ → "
  curl -sk --max-time 5 -o /dev/null -w '%{http_code}\n' "https://127.0.0.1:${port}/dashboard/" 2>/dev/null || echo fail
  hr; echo -e "  ${CYAN}[SNI test per domain]${NC}"
  local host
  for host in $(collect_domains); do
    echo -n "  $host → "
    echo | timeout 6 openssl s_client -connect 127.0.0.1:"${port}" -servername "$host" 2>/dev/null | openssl x509 -noout -subject 2>/dev/null || echo "no TLS answer"
  done
  hr
}

m_ssl(){
  while true; do
    header
    echo -e "  ${BOLD}4. SSL Certificate Management${NC}"; hr
    echo "  1. SSL health check / debug"
    echo "  2. List Let's Encrypt certs"
    echo "  3. Issue cert (domain / sub-domains) + apply"
    echo "  4. Fix paths (copy LE → panel + .env)"
    echo "  5. Renew all + re-copy to panel"
    echo "  6. Delete / revoke certificate"
    echo "  7. Self-signed certificate"
    echo "  8. Show .env SSL lines"
    echo "  9. Edit .env"
    echo " 10. Restart panel"
    echo " 11. Install auto-renew hook (recommended)"
    echo " 12. DNS check of all certificate domains"
    echo "  0. Back"; hr
    read -rp "  Select: " o
    case $o in
      1) ssl_health; pause ;;
      2) list_certs; pause ;;
      3)
        echo "  Examples:"; echo "    panel.example.com"; echo "    panel.example.com subs.example.com   (one cert, several names)"
        read -rp "  Domain(s): " domains
        [[ -z "$domains" ]] && continue
        primary=$(awk '{print $1}' <<<"$domains")
        bad=0; for host in $domains; do
          r=$(dns_resolve "$host")
          if [[ "$r" != "$(get_ip)" ]]; then warn "$host resolves to '${r:-nothing}' but this server is $(get_ip)"; bad=1; fi
        done
        [[ $bad -eq 1 ]] && ! confirm "DNS does not match — Let's Encrypt will probably fail. Continue?" n && continue
        all_ok=1
        for host in $domains; do
          found=0
          for d in /etc/letsencrypt/live/*/; do [[ -f "${d}fullchain.pem" ]] && cert_covers_domain "${d}fullchain.pem" "$host" && { found=1; break; }; done
          [[ $found -eq 1 ]] || all_ok=0
        done
        if [[ $all_ok -eq 1 ]]; then
          ok "A valid cert already covers: ${domains} — fixing panel paths only"
          for host in $domains; do copy_cert_to_panel "$host" 2>/dev/null || true; done
          apply_cert_env "$primary"; install_cert_hook; pasarguard restart; ssl_health; pause; continue
        fi
        apt-get install -y -qq certbot >/dev/null 2>&1 || true
        ufw allow 80/tcp >/dev/null 2>&1 || true
        free_port_80 || { pause; continue; }
        cb=(certbot certonly --standalone --non-interactive --agree-tos --register-unsafely-without-email --cert-name "$primary")
        for host in $domains; do cb+=(-d "$host"); done
        "${cb[@]}"
        has_pg && pasarguard up >/dev/null 2>&1 || true
        if [[ -f "/etc/letsencrypt/live/${primary}/fullchain.pem" ]]; then
          for host in $domains; do copy_cert_to_panel "$host" || true; done
          copy_cert_to_panel "$primary"
          apply_cert_env "$primary"; install_cert_hook; pasarguard restart; ssl_health
        else err "certbot failed (check DNS + port 80 from the internet)"; fi
        pause ;;
      4)
        ask "Primary domain (used in .env)" primary ""
        [[ -z "$primary" ]] && continue
        copy_cert_to_panel "$primary" && apply_cert_env "$primary"
        ask "Extra domain folders to create (space-separated, optional)" extras ""
        for host in $extras; do copy_cert_to_panel "$host" || true; done
        pasarguard restart; ssl_health; pause ;;
      5)
        certbot renew
        for d in /etc/letsencrypt/live/*/; do n=$(basename "$d"); [[ "$n" == README ]] && continue; copy_cert_to_panel "$n" || true; done
        confirm "Restart panel to load renewed files?" y && pasarguard restart
        ssl_health; pause ;;
      6)
        list_certs; ask "Domain (cert name) to delete" domain ""
        [[ -z "$domain" ]] && continue
        if confirm_yes "Delete ${domain}"; then
          certbot revoke --cert-path "/etc/letsencrypt/live/${domain}/fullchain.pem" --non-interactive >/dev/null 2>&1 || true
          certbot delete --cert-name "$domain" --non-interactive >/dev/null 2>&1 || \
            rm -rf "/etc/letsencrypt/live/${domain}" "/etc/letsencrypt/archive/${domain}" "/etc/letsencrypt/renewal/${domain}.conf" 2>/dev/null
          rm -rf "${DATA_DIR}/certs/${domain}" 2>/dev/null
          ok "Removed ${domain}"
        fi
        pause ;;
      7)
        ask "CN (domain or IP)" cn ""
        mkdir -p "${DATA_DIR}/certs"
        openssl req -x509 -newkey rsa:4096 -keyout "${DATA_DIR}/certs/key.pem" -out "${DATA_DIR}/certs/cert.pem" -days 36500 -nodes -subj "/CN=${cn}" 2>/dev/null
        chmod 600 "${DATA_DIR}/certs/key.pem"
        echo "  ${DATA_DIR}/certs/cert.pem"
        if confirm "Apply to panel (.env) now?" n; then
          sed -i '/^UVICORN_SSL_CERTFILE=/d;/^UVICORN_SSL_KEYFILE=/d' "$ENV_FILE"
          { echo "UVICORN_SSL_CERTFILE=${DATA_DIR}/certs/cert.pem"; echo "UVICORN_SSL_KEYFILE=${DATA_DIR}/certs/key.pem"; } >> "$ENV_FILE"
          pasarguard restart
        fi
        pause ;;
      8) grep -E 'SSL|UVICORN|CERT|KEY|PORT' "$ENV_FILE" 2>/dev/null || echo none; pause ;;
      9) pasarguard edit-env ;;
      10) pasarguard restart; pause ;;
      11) install_cert_hook; systemctl enable --now certbot.timer >/dev/null 2>&1 || true; pause ;;
      12) dns_report; pause ;;
      0) break ;;
    esac
  done
}

# ═════════════════ Migration (new VPS) ═════════════════
MIG_SSH_BASE=(); MIG_SSH=(); MIG_SCP=(); MIG_TARGET=""; MIG_SCPTARGET=""; MIG_FROZEN=0
mig_setup_conn(){   # needs NEW_IP NEW_PORT NEW_USER AUTH_METHOD KEY_PATH
  local ctl="/tmp/pgm-ssh-$$-%C" pre=() common
  common=(-o StrictHostKeyChecking=accept-new -o ConnectTimeout=15 -o ServerAliveInterval=20 -o ControlMaster=auto -o "ControlPath=$ctl" -o ControlPersist=900)
  if [[ "$AUTH_METHOD" == 2 ]]; then common+=(-i "$KEY_PATH"); else pre=(sshpass -e); fi
  MIG_TARGET="${NEW_USER}@${NEW_IP}"
  if [[ "$NEW_IP" == *:* ]]; then MIG_SCPTARGET="${NEW_USER}@[${NEW_IP}]"; else MIG_SCPTARGET="$MIG_TARGET"; fi
  MIG_SSH_BASE=("${pre[@]}" ssh "${common[@]}" -p "$NEW_PORT")
  MIG_SSH=("${MIG_SSH_BASE[@]}" "$MIG_TARGET")
  MIG_SCP=("${pre[@]}" scp "${common[@]}" -P "$NEW_PORT")
}
mig_rsh(){ "${MIG_SSH[@]}" "$@"; }
mig_close(){ [[ ${#MIG_SSH_BASE[@]} -gt 0 ]] && "${MIG_SSH_BASE[@]}" -O exit "$MIG_TARGET" >/dev/null 2>&1; unset SSHPASS; return 0; }
mig_fail(){
  err "$1"
  if [[ $MIG_FROZEN -eq 1 ]]; then warn "Restarting the old panel (migration aborted)"; dc start "$(app_svc)" >/dev/null 2>&1; MIG_FROZEN=0; fi
  mig_close; pause; return 1
}

migrate_auto(){
  header
  echo -e "  ${BOLD}Full Auto Migration → New VPS${NC}"; hr
  [[ -f "$COMPOSE_FILE" ]] || { err "No local panel found ($COMPOSE_FILE)"; pause; return 1; }
  echo -e "  ${YELLOW}What happens:${NC}"
  echo "   1. Checks SSH + the new server (OS, disk, Docker, existing panel)"
  echo "   2. Builds ONE package: DB dump + .env + compose + panel data + all"
  echo "      certificates (panel & sub-domains) + nginx + cron + Telegram settings"
  echo "   3. Uploads it (checksum verified), installs Docker / panel CLI there"
  echo "   4. Restores everything, starts the panel, compares user/admin/node counts"
  echo "   5. Checks DNS for every domain (and can switch Cloudflare A-records)"
  hr
  ask "New server IP / hostname" NEW_IP ""
  [[ -z "$NEW_IP" ]] && { err "IP required"; pause; return 1; }
  if [[ "$NEW_IP" == "$(get_ip)" ]]; then err "That is THIS server"; pause; return 1; fi
  ask "SSH port" NEW_PORT 22
  ask "SSH user" NEW_USER root
  [[ "$NEW_USER" != root ]] && warn "Non-root user: restore needs root privileges — use root."
  echo "  Authentication:"; echo "   1. Password"; echo "   2. SSH key file"
  ask "Select" AUTH_METHOD 1
  KEY_PATH=""
  if [[ "$AUTH_METHOD" == 2 ]]; then
    ask "Path to private key" KEY_PATH ""
    [[ -f "$KEY_PATH" ]] || { err "Key not found"; pause; return 1; }
  else
    has_cmd sshpass || { info "Installing sshpass..."; apt-get update -qq; apt-get install -y -qq sshpass >/dev/null 2>&1 || { err "sshpass install failed — use key auth"; pause; return 1; }; }
    read -rsp "  SSH password: " NEW_PASS; echo; export SSHPASS="$NEW_PASS"
  fi
  has_cmd ssh || apt-get install -y -qq openssh-client >/dev/null 2>&1
  mig_setup_conn

  info "Testing SSH connection..."
  local pf; pf=$(mig_rsh 'echo "PGM_OK"; echo "UID=$(id -u)"; . /etc/os-release 2>/dev/null; echo "OS=${PRETTY_NAME:-unknown}"; echo "ARCH=$(uname -m)"; echo "FREE_MB=$(df -Pm / | awk "NR==2{print \$4}")"; echo "MEM_MB=$(free -m | awk "/Mem:/{print \$2}")"; echo "DOCKER=$(command -v docker >/dev/null && echo yes || echo no)"; echo "PANEL=$([ -f /opt/pasarguard/docker-compose.yml ] && echo yes || echo no)"' 2>/tmp/pgm-ssh.err)
  grep -q PGM_OK <<<"$pf" || { cat /tmp/pgm-ssh.err 2>/dev/null | tail -3; mig_fail "SSH connection failed"; return 1; }
  ok "Connected to ${MIG_TARGET}"
  local r_uid r_os r_arch r_free r_mem r_docker r_panel
  r_uid=$(grep ^UID= <<<"$pf" | cut -d= -f2); r_os=$(grep ^OS= <<<"$pf" | cut -d= -f2-); r_arch=$(grep ^ARCH= <<<"$pf" | cut -d= -f2)
  r_free=$(grep ^FREE_MB= <<<"$pf" | cut -d= -f2); r_mem=$(grep ^MEM_MB= <<<"$pf" | cut -d= -f2)
  r_docker=$(grep ^DOCKER= <<<"$pf" | cut -d= -f2); r_panel=$(grep ^PANEL= <<<"$pf" | cut -d= -f2)
  echo "    OS     : $r_os ($r_arch)"; echo "    Free   : ${r_free} MB   RAM: ${r_mem} MB"
  echo "    Docker : $r_docker     Existing panel: $r_panel"
  [[ "$r_uid" != 0 ]] && { mig_fail "Remote user is not root"; return 1; }
  [[ "$r_arch" != "$(uname -m)" ]] && warn "CPU architecture differs ($(uname -m) → $r_arch) — images must support it"
  [[ "${r_mem:-0}" -lt 900 ]] && warn "New server has < 1GB RAM — consider adding swap (pg-m → Tools)"
  if [[ "$r_panel" == yes ]]; then
    warn "A PasarGuard panel ALREADY exists on the new server — it will be replaced (a safety snapshot is made there first)."
  fi

  local freeze=n
  if confirm "Stop the OLD panel while packaging so no data changes (recommended)?" y; then freeze=y; fi
  confirm_yes "Start migration to ${NEW_IP}" || { mig_close; echo "  Cancelled"; pause; return 1; }

  if [[ "$freeze" == y ]]; then
    info "Stopping old panel app (database stays up)..."
    dc stop "$(app_svc)" >/dev/null 2>&1 && MIG_FROZEN=1
  fi

  info "Building migration package..."
  create_backup full migrate || { mig_fail "Backup failed — nothing was changed on the new server"; return 1; }
  local ARC="$BACKUP_RESULT" ARCN; ARCN=$(basename "$ARC")
  local need=$(( $(stat -c %s "$ARC") / 1048576 * 3 + 500 ))
  [[ "${r_free:-0}" -lt "$need" ]] && { mig_fail "Not enough disk on new server (need ~${need} MB, have ${r_free} MB)"; return 1; }

  info "Preparing new server (curl, tar, openssl)..."
  mig_rsh 'export DEBIAN_FRONTEND=noninteractive; mkdir -p /root/pg-m-incoming && chmod 700 /root/pg-m-incoming; command -v apt-get >/dev/null && { apt-get update -qq; apt-get install -y -qq curl ca-certificates tar gzip openssl >/dev/null 2>&1; }; true' >/dev/null 2>&1

  local SELF; SELF=$(readlink -f "$0" 2>/dev/null); [[ -f "$SELF" ]] || SELF="$INSTALL_PATH"
  info "Uploading package ($(du -h "$ARC" | cut -f1))..."
  local try ok_up=0
  for try in 1 2 3; do
    if "${MIG_SCP[@]}" "$ARC" "$ARC.sha256" "$SELF" "${MIG_SCPTARGET}:/root/pg-m-incoming/"; then ok_up=1; break; fi
    warn "Upload attempt $try failed — retrying..."; sleep 3
  done
  [[ $ok_up -eq 1 ]] || { mig_fail "Upload failed"; return 1; }
  mig_rsh "cd /root/pg-m-incoming && mv -f $(basename "$SELF") pg-m 2>/dev/null; chmod +x pg-m; sha256sum -c ${ARCN}.sha256" >/dev/null 2>&1 \
    && ok "Upload verified (sha256)" || { mig_fail "Checksum mismatch after upload"; return 1; }

  info "Running restore on the new server (this can take several minutes)..."
  hr
  mig_rsh "bash /root/pg-m-incoming/pg-m --restore-archive /root/pg-m-incoming/${ARCN} --auto"
  local rrc=$?
  hr
  if [[ $rrc -ne 0 ]]; then
    warn "Restore on the new server reported problems (exit $rrc)."
    warn "Log in there and run: pg-m → Quick Status / Doctor, or: docker compose -f /opt/pasarguard/docker-compose.yml logs"
  else ok "Restore finished successfully on ${NEW_IP}"; fi

  # external reachability test
  local code scheme port; scheme=$(panel_scheme); port=$(get_port)
  code=$(curl -sk --max-time 10 -o /dev/null -w '%{http_code}' "${scheme}://${NEW_IP}:${port}/dashboard/" 2>/dev/null)
  if [[ "$code" =~ ^[1-5][0-9][0-9]$ ]]; then ok "Panel reachable from here: ${scheme}://${NEW_IP}:${port}/dashboard/ (HTTP $code)"
  else warn "Panel not reachable from outside on port ${port} (firewall / provider security group?)"; fi

  echo; echo -e "  ${BOLD}DNS status (domains found in your certificates)${NC}"; hr
  dns_report "$NEW_IP"
  if [[ -n "$(collect_domains)" ]]; then
    if cf_have; then
      confirm "Cloudflare token found — switch ALL these A-records to ${NEW_IP} now?" n && cf_point_domains "$NEW_IP"
    else
      echo -e "  ${DIM}Tip: add a Cloudflare token in menu 13 to switch DNS automatically.${NC}"
      echo "  Otherwise change the A-records manually to: ${NEW_IP}"
    fi
  fi

  if [[ $rrc -eq 0 && $MIG_FROZEN -eq 1 ]]; then
    echo
    if confirm "Keep the OLD panel stopped (avoids two panels fighting over nodes/users)?" y; then
      ok "Old panel stays stopped. Start it again any time: pasarguard up"
      conf_set MIGRATED_TO "$NEW_IP"
    else
      dc start "$(app_svc)" >/dev/null 2>&1; warn "Old panel restarted — remember to stop one of the two!"
    fi
    MIG_FROZEN=0
  elif [[ $MIG_FROZEN -eq 1 ]]; then
    warn "Because the restore had problems, restarting the old panel."
    dc start "$(app_svc)" >/dev/null 2>&1; MIG_FROZEN=0
  fi

  if confirm "Delete the migration package from the NEW server (contains private keys)?" y; then
    mig_rsh "rm -rf /root/pg-m-incoming" >/dev/null 2>&1 && ok "Removed from new server"
  fi
  mig_close
  echo
  echo -e "  ${GREEN}════════════════════════════════════════════════${NC}"
  echo -e "  ${BOLD}Post-migration checklist${NC}"
  echo "   ☐ DNS A-records of panel / sub domains → ${NEW_IP}"
  echo "   ☐ Log in to the new panel and check users / nodes"
  echo "   ☐ Nodes: allow the NEW panel IP in node firewalls (pg-m → Node → Lock API port)"
  echo "   ☐ Keep the package: ${ARC}"
  echo -e "  ${GREEN}════════════════════════════════════════════════${NC}"
  log "migration to $NEW_IP finished rc=$rrc"
  pause
}

