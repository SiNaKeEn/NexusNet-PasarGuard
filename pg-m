# ═════════════════ Node-domain certificates (issue + weekly renew + deliver to master) ═════════════════
# Files land in /var/lib/pasarguard/certs/<domain>/{fullchain.pem,key.pem} on the MASTER panel.
NC_CHANGED=0
nc_name(){ echo "${1#\*.}"; }
nc_key(){ echo /root/.ssh/pgm_nodecert; }
nc_cf_ini(){
  local t; t=$(conf_get CF_TOKEN); [[ -n "$t" ]] || return 1
  mkdir -p "$PGM_DIR"; printf 'dns_cloudflare_api_token = %s\n' "$t" > "$PGM_DIR/cloudflare.ini"; chmod 600 "$PGM_DIR/cloudflare.ini"
}
nc_arvan_ini(){
  local t; t=$(conf_get ARVAN_TOKEN); [[ -n "$t" ]] || return 1
  # Accept both "Apikey xxx" and bare token
  [[ "$t" == Apikey* || "$t" == apikey* ]] || t="Apikey $t"
  mkdir -p "$PGM_DIR"
  printf 'dns_arvan_key = %s\n' "$t" > "$PGM_DIR/arvan.ini"
  chmod 600 "$PGM_DIR/arvan.ini"
}
nc_issue(){   # nc_issue domain method(cf|arvan|standalone)
  local d="$1" m="$2" n; n=$(nc_name "$d")
  has_cmd certbot || apt-get install -y -qq certbot >/dev/null 2>&1
  if [[ "$m" == cf ]]; then
    apt-get install -y -qq python3-certbot-dns-cloudflare >/dev/null 2>&1
    nc_cf_ini || { err "No Cloudflare token (menu 13)"; return 1; }
    certbot certonly --dns-cloudflare --dns-cloudflare-credentials "$PGM_DIR/cloudflare.ini" --dns-cloudflare-propagation-seconds 30 \
      --non-interactive --agree-tos --register-unsafely-without-email --cert-name "$n" -d "$d"
  elif [[ "$m" == arvan ]]; then
    # Install plugin (pip). Prefer newer certbot-dns-arvan
    if ! python3 -c "import certbot_dns_arvan" 2>/dev/null; then
      apt-get install -y -qq python3-pip python3-venv >/dev/null 2>&1 || true
      pip3 install -q --break-system-packages certbot-dns-arvan 2>/dev/null || pip3 install -q certbot-dns-arvan || {
        err "Failed to install certbot-dns-arvan (pip). Try: pip3 install certbot-dns-arvan"; return 1
      }
    fi
    nc_arvan_ini || { err "No ArvanCloud API token"; return 1; }
    certbot certonly --authenticator dns-arvan --dns-arvan-credentials "$PGM_DIR/arvan.ini" \
      --dns-arvan-propagation-seconds 60 \
      --non-interactive --agree-tos --register-unsafely-without-email --cert-name "$n" -d "$d"
  else
    ufw allow 80/tcp >/dev/null 2>&1 || true; free_port_80 || return 1
    certbot certonly --standalone --non-interactive --agree-tos --register-unsafely-without-email --cert-name "$n" -d "$d"
    has_pg && pasarguard up >/dev/null 2>&1 || true
  fi
  [[ -f "/etc/letsencrypt/live/$n/fullchain.pem" ]]
}
nc_install_local(){   # copy LE → panel certs dir on THIS server
  local n="$1" src="/etc/letsencrypt/live/$1" dst="$DATA_DIR/certs/$1"
  [[ -f "$src/fullchain.pem" ]] || return 1
  mkdir -p "$dst"
  cmp -s "$src/fullchain.pem" "$dst/fullchain.pem" || NC_CHANGED=1
  cp -L "$src/fullchain.pem" "$dst/fullchain.pem"; cp -L "$src/privkey.pem" "$dst/key.pem"; cp -L "$src/privkey.pem" "$dst/privkey.pem"
  chmod 644 "$dst/fullchain.pem"; chmod 600 "$dst/key.pem" "$dst/privkey.pem"
}
nc_push(){   # copy LE → master over SSH key
  local n="$1" host port user key src rdir lsum rsum o
  host=$(conf_get NC_HOST); port=$(conf_get NC_PORT); user=$(conf_get NC_USER); key=$(nc_key)
  src="/etc/letsencrypt/live/$n"; rdir="/var/lib/pasarguard/certs/$n"
  o=(-o StrictHostKeyChecking=accept-new -o ConnectTimeout=15 -o BatchMode=yes -i "$key")
  ssh "${o[@]}" -p "$port" "$user@$host" "mkdir -p $rdir" || return 1
  lsum=$(sha256sum "$src/fullchain.pem" | cut -d' ' -f1)
  rsum=$(ssh "${o[@]}" -p "$port" "$user@$host" "sha256sum $rdir/fullchain.pem 2>/dev/null" | cut -d' ' -f1)
  [[ "$lsum" == "$rsum" ]] && return 0
  NC_CHANGED=1
  local tgt="$user@$host"; [[ "$host" == *:* ]] && tgt="$user@[$host]"
  scp "${o[@]}" -P "$port" -q "$src/fullchain.pem" "$src/privkey.pem" "$tgt:$rdir/" || return 1
  ssh "${o[@]}" -p "$port" "$user@$host" "cd $rdir && cp -f privkey.pem key.pem && chmod 644 fullchain.pem && chmod 600 key.pem privkey.pem"
}
nc_show_paths(){
  local d n exp where; where=$([[ "$(conf_get NC_MODE)" == push ]] && echo "on MASTER $(conf_get NC_HOST)" || echo "on this server (master)")
  echo -e "  ${BOLD}Certificate paths ${where}${NC}"; hr
  for d in $(conf_get NC_DOMAINS); do
    n=$(nc_name "$d")
    exp=$(openssl x509 -enddate -noout -in "/etc/letsencrypt/live/$n/fullchain.pem" 2>/dev/null | cut -d= -f2)
    echo -e "  ${CYAN}${d}${NC}   expires: ${exp:-unknown}"
    echo "    fullchain : /var/lib/pasarguard/certs/${n}/fullchain.pem"
    echo "    key       : /var/lib/pasarguard/certs/${n}/key.pem"
  done
  hr
  echo "  Use these two paths in the panel (host / node TLS settings). The panel container sees the same paths."
  echo "  Weekly job: $([[ -f /etc/cron.d/pg-m-nodecerts ]] && echo 'ENABLED (Mon 04:00)' || echo 'not enabled')"
}
nodecerts_job(){   # cron: weekly
  AUTO=1; NC_CHANGED=0
  local doms mode d n rc=0; doms=$(conf_get NC_DOMAINS); mode=$(conf_get NC_MODE)
  [[ -n "$doms" ]] || { log "nodecerts: no domains configured"; return 0; }
  for d in $doms; do
    n=$(nc_name "$d")
    if [[ -f "/etc/letsencrypt/live/$n/fullchain.pem" ]]; then certbot renew --cert-name "$n" -q >>"$LOG_FILE" 2>&1
    else nc_issue "$d" "$(conf_get NC_METHOD)" >>"$LOG_FILE" 2>&1; fi
    if [[ ! -f "/etc/letsencrypt/live/$n/fullchain.pem" ]]; then alert_once "nc_$n" "node-cert: cannot obtain/renew cert for $d"; rc=1; continue; fi
    if [[ "$mode" == push ]]; then nc_push "$n" || { alert_once "nc_push_$n" "node-cert: push to master failed for $n"; rc=1; }
    else nc_install_local "$n"; fi
  done
  if [[ $NC_CHANGED -eq 1 && "$(conf_get NC_RESTART)" == yes ]]; then
    if [[ "$mode" == push ]]; then ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -i "$(nc_key)" -p "$(conf_get NC_PORT)" "$(conf_get NC_USER)@$(conf_get NC_HOST)" "pasarguard restart || docker compose -f /opt/pasarguard/docker-compose.yml restart" >/dev/null 2>&1
    else pg_restart; fi
  fi
  log "nodecerts finished rc=$rc changed=$NC_CHANGED"; return $rc
}
nc_choose_method(){   # sets NC_M
  echo "  How to prove domain ownership:"
  echo "   1. Cloudflare DNS  (works even if domain points elsewhere; wildcard OK)"
  echo "   2. ArvanCloud DNS  (works even if domain points elsewhere; needs API Key)"
  echo "   3. Standalone port 80 (domain must point to THIS server)"
  ask "Select" mm 1
  case "$mm" in
    2) NC_M=arvan ;;
    3) NC_M=standalone ;;
    *) NC_M=cf ;;
  esac
  if [[ "$NC_M" == cf ]] && ! cf_have; then
    echo "  Cloudflare token needs: Zone → DNS → Edit"; read -rsp "  Cloudflare API token: " t; echo
    [[ -n "$t" ]] && conf_set CF_TOKEN "$t" || { err "Token required"; return 1; }
  fi
  if [[ "$NC_M" == arvan ]]; then
    local at; at=$(conf_get ARVAN_TOKEN)
    if [[ -z "$at" ]]; then
      echo "  ArvanCloud API Key: from npanel.arvancloud.ir → Profile → API Keys"
      echo "  (paste the key; 'Apikey ' prefix is optional)"
      read -rsp "  Arvan API Key: " t; echo
      [[ -n "$t" ]] && conf_set ARVAN_TOKEN "$t" || { err "Token required"; return 1; }
    fi
  fi
}
nc_enable_cron(){
  echo "0 4 * * 1 root $INSTALL_PATH --node-certs >> $LOG_FILE 2>&1" > /etc/cron.d/pg-m-nodecerts; chmod 644 /etc/cron.d/pg-m-nodecerts
  ok "Weekly job enabled (every Monday 04:00)"
}
m_nodecerts(){
  while true; do
    header
    echo -e "  ${BOLD}17. Node-domain certificates${NC}"; hr
    echo "  Domains: $(conf_get NC_DOMAINS | sed 's/^$/none/')   Mode: $(conf_get NC_MODE | sed 's/^$/-/')   Weekly job: $([[ -f /etc/cron.d/pg-m-nodecerts ]] && echo on || echo off)"; hr
    echo "  1. Issue on THIS server = master  (certs saved straight into the panel certs dir)"
    echo "  2. Issue on THIS server and PUSH to the master (this is a node / other server)"
    echo "  3. Show certificate paths + expiry"
    echo "  4. Run the weekly job now"
    echo "  5. Enable weekly auto-renew job"
    echo "  6. Disable job + forget settings"
    echo "  7. Restart master panel after a changed cert: $([[ "$(conf_get NC_RESTART)" == yes ]] && echo YES || echo no)  (toggle)"
    echo "  0. Back"; hr
    read -rp "  Select: " o
    case $o in
      1)
        ask "Node domain(s), space separated" doms ""; [[ -z "$doms" ]] && continue
        nc_choose_method || { pause; continue; }
        conf_set NC_MODE local; conf_set NC_DOMAINS "$doms"; conf_set NC_METHOD "$NC_M"
        for d in $doms; do
          info "Issuing $d ..."
          if nc_issue "$d" "$NC_M" && nc_install_local "$(nc_name "$d")"; then ok "$d ready"; else err "$d failed (check DNS / token)"; fi
        done
        nc_show_paths; confirm "Enable weekly auto-renew now?" y && nc_enable_cron; pause ;;
      2)
        ask "MASTER panel address (IP/host)" mh ""; ask "SSH port" mp 22; ask "SSH user" mu root
        [[ -z "$mh" ]] && continue
        has_cmd sshpass || apt-get install -y -qq sshpass >/dev/null 2>&1
        mkdir -p /root/.ssh; chmod 700 /root/.ssh
        [[ -f "$(nc_key)" ]] || ssh-keygen -t ed25519 -N "" -f "$(nc_key)" -C "pg-m-nodecert@$(hostname)" >/dev/null
        read -rsp "  Master SSH password (used ONCE to install the key, not stored): " MPW; echo
        SSHPASS="$MPW" sshpass -e ssh-copy-id -o StrictHostKeyChecking=accept-new -i "$(nc_key).pub" -p "$mp" "$mu@$mh" >/dev/null 2>&1; unset MPW
        if ! ssh -o BatchMode=yes -o ConnectTimeout=10 -i "$(nc_key)" -p "$mp" "$mu@$mh" true 2>/dev/null; then err "Key login to master failed (password/port?)"; pause; continue; fi
        ok "Passwordless link to master works"
        conf_set NC_HOST "$mh"; conf_set NC_PORT "$mp"; conf_set NC_USER "$mu"; conf_set NC_MODE push
        ask "Node domain(s) hosted/issued on THIS server, space separated" doms ""; [[ -z "$doms" ]] && continue
        nc_choose_method || { pause; continue; }
        conf_set NC_DOMAINS "$doms"; conf_set NC_METHOD "$NC_M"
        for d in $doms; do
          n=$(nc_name "$d"); info "Issuing $d ..."
          if [[ -f "/etc/letsencrypt/live/$n/fullchain.pem" ]] || nc_issue "$d" "$NC_M"; then nc_push "$n" && ok "$d delivered to master" || err "push failed for $d"; else err "$d: certificate failed"; fi
        done
        nc_show_paths; confirm "Enable weekly auto-renew + push now?" y && nc_enable_cron; pause ;;
      3) nc_show_paths; pause ;;
      4) nodecerts_job && ok "Done" || err "Finished with errors — see $LOG_FILE"; nc_show_paths; pause ;;
      5) nc_enable_cron; pause ;;
      6) rm -f /etc/cron.d/pg-m-nodecerts; for k in NC_DOMAINS NC_MODE NC_METHOD NC_HOST NC_PORT NC_USER NC_RESTART ARVAN_TOKEN; do conf_del "$k"; done; rm -f "$PGM_DIR/cloudflare.ini" "$PGM_DIR/arvan.ini"; ok "Removed (issued certs stay on disk)"; pause ;;
      7) [[ "$(conf_get NC_RESTART)" == yes ]] && conf_set NC_RESTART no || conf_set NC_RESTART yes; ;;
      0) break ;;
    esac
  done
}

[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0   # allow `source pg-m` for tests

case "${1:-menu}" in
  menu|"")            need_root; main ;;
  -v|--version|version) echo "pg-m ${SCRIPT_VERSION}" ;;
  -h|--help|help)     usage ;;
  status)             need_root; AUTO=1; quick_status ;;
  doctor)             need_root; AUTO=1; doctor ;;
  db)                 need_root; db_overview ;;
  backup|--backup)    need_root; AUTO=1; create_backup "${2:-full}" backup && prune_backups ;;
  restore)            need_root; if [[ -n "${2:-}" ]]; then restore_any "$2"; else pick_restore_source && restore_any "$PICKED"; fi ;;
  restore-db)         need_root; [[ -n "${2:-}" ]] || { usage; exit 1; }; restore_db_from_any "$2" ;;
  --restore-archive)  need_root; AUTO=1; _arc="${2:?archive path required}"; shift 2
                      for _a in "$@"; do [[ "$_a" == --fresh-node ]] && FRESH_NODE=1; done
                      restore_archive "$_arc" ;;
  --telegram-backup)  need_root; telegram_backup_job ;;
  --watchdog)         need_root; watchdog_job ;;
  --node-certs)       need_root; nodecerts_job ;;
  update|--update)    need_root; self_update ;;
  *)                  usage; exit 1 ;;
esac
