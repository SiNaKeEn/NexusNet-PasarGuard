# ── Main ─────────────────────────────────────────────────────
main_menu() {
    while true; do
        print_header
        if check_pg && [[ -f "$ENV_FILE" ]]; then
            echo -e "  Panel: ${GREEN}$(panel_url)${NC}"
            print_line
        fi
        echo "  0. Service Management"
        echo "  1. Install / Update / Uninstall"
        echo "  2. Panel Port & Links"
        echo "  3. SSL Certificate Management"
        echo "  4. Backup & Restore"
        echo "  5. Migrate to New Server"
        echo "  6. Panel Settings"
        echo "  7. Node Management"
        echo "  8. Firewall & Security"
        echo "  9. Tools"
        echo "  10. Quick Status"
        echo "  11. Exit"
        print_line
        read -rp "  Choose option [0-11]: " c
        case $c in
            0) menu_service ;;
            1) menu_install ;;
            2) menu_port ;;
            3) menu_ssl ;;
            4) menu_backup ;;
            5) menu_migrate ;;
            6) menu_settings ;;
            7) menu_node ;;
            8) menu_firewall ;;
            9) menu_tools ;;
            10)
                print_header
                check_pg && pasarguard status || echo "  Panel not installed"
                echo
                show_links
                df -h / | tail -1
                free -h | grep Mem
                pause
                ;;
            11) echo -e "  ${GREEN}Bye${NC}"; exit 0 ;;
            *) ;;
        esac
    done
}

